// The type a `copy` binds says what it copies. The same `mut` array of
// `imm` cells can be kept, or copied with new `mut` cells.

data data0 {
  (i32)
}

// Kept: a write through the copy is seen in the original.
fn fn0() -> (i32) {
  let %0: imm data0 = new data0.0(1i32)
  let %1: mut [imm data0] = array_new(%0)
  let %2: mut [imm data0] = copy[mut](%1)
  let %3: imm data0 = new data0.0(7i32)
  let = array_set(%2, 0i32, %3)
  let %4: imm data0 = array_get(%1, 0i32)
  let %5: i32 = get data0.0.0(%4)
  jump ret(%5)
}

// Copied, cells and all: the copy's cell can be written, and the
// original's stays as it was.
fn fn1() -> (i32) {
  let %0: imm data0 = new data0.0(1i32)
  let %1: mut [imm data0] = array_new(%0)
  let %2: mut [mut data0] = copy[mut](%1)
  let %3: mut data0 = array_get(%2, 0i32)
  let = set data0.0.0(%3, 5i32)
  let %4: i32 = get data0.0.0(%3)
  let %5: imm data0 = array_get(%1, 0i32)
  let %6: i32 = get data0.0.0(%5)
  let %7: i32 = mul(%4, 10i32)
  let %8: i32 = add(%7, %6)
  jump ret(%8)
}

//# run fn0() == 7i32
//# run fn1() == 51i32
//# wasm-error: copy isn't supported yet
