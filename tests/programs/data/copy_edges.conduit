// `copy` on arrays, on shared objects and on cycles: each object is
// copied once, so sharing stays, cycles end, and objects already at the
// target mutability are shared, not copied.

data data0 {
  (i32)
}

data data1 {
  (inherit data0, inherit data0)
}

data data2 {
  (i32, inherit data3)
}

// The next node, or none.
data data3 {
  ()
  (inherit data2)
}

// A copy of an array of cells doesn't see later writes to the cells.
fn fn0() -> (i32) {
  let %0: mut data0 = new data0.0(1i32)
  let %1: mut [mut data0] = array_new(%0, %0)
  let %2: imm [imm data0] = copy[imm](%1)
  let = set data0.0.0(%0, 5i32)
  let %3: imm data0 = array_get(%2, 1i32)
  let %4: i32 = get data0.0.0(%3)
  jump ret(%4)
}

// `copy[mut]` of a pair whose two fields are one point copies the point
// once: a write through one field is seen through the other.
fn fn1() -> (i32) {
  let %0: imm data0 = new data0.0(1i32)
  let %1: imm data1 = new data1.0(%0, %0)
  let %2: mut data1 = copy[mut](%1)
  let %3: mut data0 = get data1.0.0(%2)
  let = set data0.0.0(%3, 7i32)
  let %4: mut data0 = get data1.0.1(%2)
  let %5: i32 = get data0.0.0(%4)
  let %6: i32 = get data0.0.0(%0)
  let %7: i32 = mul(%5, 10i32)
  let %8: i32 = add(%7, %6)
  jump ret(%8)
}

// A node that points at itself: the copy is a node that points at itself,
// so walking it 3 steps adds its value 3 times.
fn fn2() -> (i32) {
  let %0: mut data3 = new data3.0()
  let %1: mut data2 = new data2.0(4i32, %0)
  let %2: mut data3 = new data3.1(%1)
  let = set data2.0.1(%1, %2)
  let %3: imm data2 = copy[imm](%1)
  let = set data2.0.0(%1, 100i32)
  let %4: i32 = call fn3(%3, 3i32)
  jump ret(%4)
}

// The sum of the first n values along a list.
fn fn3(%0: imm data2, %1: i32) -> (i32) {
  join rec j1(%2: imm data2, %3: i32, %4: i32) =
    case %3 {
      0 => jump ret(%4)
      _ =>
        let %5: i32 = get data2.0.0(%2)
        let %6: i32 = add(%4, %5)
        let %7: i32 = sub(%3, 1i32)
        let %8: imm data3 = get data2.0.1(%2)
        case %8 {
          data3.0 => jump ret(%6)
          data3.1 =>
            let %9: imm data2 = get data3.1.0(%8)
            jump j1(%9, %7, %6)
        }
    }
  in jump j1(%0, %1, 0i32)
}

// `copy[mut]` of an imm array, then a write to the copy.
fn fn4() -> (i32) {
  let %0: imm [i32] = array_new(1i32, 2i32)
  let %1: mut [i32] = copy[mut](%0)
  let = array_set(%1, 0i32, 8i32)
  let %2: i32 = array_get(%0, 0i32)
  let %3: i32 = array_get(%1, 0i32)
  let %4: i32 = mul(%2, 10i32)
  let %5: i32 = add(%4, %3)
  jump ret(%5)
}

// A `ro` value is copied whatever it is.
fn fn5(%0: i32) -> (i32) {
  let %1: mut data0 = new data0.0(%0)
  let %2: imm data0 = call fn6(%1)
  let = set data0.0.0(%1, 0i32)
  let %3: i32 = get data0.0.0(%2)
  jump ret(%3)
}

fn fn6(%0: ro data0) -> (imm data0) {
  let %1: imm data0 = copy[imm](%0)
  jump ret(%1)
}

// Scalars and imm closures copy as themselves.
fn fn7(%0: i32) -> (i32) {
  let %1: i32 = copy[imm](%0)
  let %2: imm fn() -> (i32) = closure fn8(%1)
  let %3: imm fn() -> (i32) = copy[imm](%2)
  let %4: mut fn() -> (i32) = closure fn8(%1)
  let %5: mut fn() -> (i32) = copy[mut](%4)
  let %6: i32 = apply(%3)
  let %7: i32 = apply(%5)
  let %8: i32 = add(%6, %7)
  jump ret(%8)
}

fn fn8(%0: i32) -> (i32) {
  jump ret(%0)
}

//# run fn0() == 1i32
//# run fn1() == 71i32
//# run fn2() == 12i32
//# run fn4() == 18i32
//# run fn5(3i32) == 3i32
//# run fn7(4i32) == 8i32
//# wasm-error: copy isn't supported yet
