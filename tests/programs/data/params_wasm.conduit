// Mutability arguments don't exist at run time: a data type with them
// lowers like any other.

data Box['m1] {
  ('m1 [i32])
}

fn main(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(2i32, %x)
  let %mut_box: mut Box[mut] = new Box.0(%xs)
  let %ys: imm [i32] = array_new(10i32)
  let %imm_box: mut Box[imm] = new Box.0(%ys)
  let %xs2: mut [i32] = get Box.0.0(%mut_box)
  let = array_set(%xs2, 0i32, 7i32)
  let %a: i32 = array_get(%xs, 0i32)
  let %ys2: imm [i32] = get Box.0.0(%imm_box)
  let %b: i32 = array_get(%ys2, 0i32)
  let %r: i32 = add(%a, %b)
  jump ret(%r)
}

//# run main(1i32) == 17i32
