// `copy[imm]` makes a new object, so a later write to the original
// doesn't change the copy.

data data0 {
  (i32, i32)
}

fn fn0(%0: i32) -> (i32) {
  let %1: mut data0 = new data0.0(%0, 2i32)
  let %2: imm data0 = copy[imm](%1)
  let = set data0.0.0(%1, 5i32)
  let %3: i32 = get data0.0.0(%2)
  jump ret(%3)
}

