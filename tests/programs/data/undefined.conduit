// `undefined` gives a value that must not be used, for code that has to
// give a value it knows won't be looked at. Passing it on is fine.

data List {
  ()
  (i32, inherit List)
}

// Gives a list and a flag saying whether the list is real.
fn maybe_list(%n: i32) -> (i32, imm List) {
  case %n {
    0 =>
      let %u: imm List = undefined()
      jump ret(0i32, %u)
    _ =>
      let %nil: imm List = new List.0()
      let %l: imm List = new List.1(%n, %nil)
      jump ret(1i32, %l)
  }
}

fn head_or(%n: i32, %default: i32) -> (i32) {
  let %ok: i32, %l: imm List = call maybe_list(%n)
  case %ok {
    0 => jump ret(%default)
    _ =>
      case %l {
        List.0 => jump ret(%default)
        List.1 =>
          let %h: i32 = get List.1.0(%l)
          jump ret(%h)
      }
  }
}

//# run head_or(0i32, 9i32) == 9i32
//# run head_or(4i32, 9i32) == 4i32
