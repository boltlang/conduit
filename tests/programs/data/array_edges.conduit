// Arrays at their edges: empty arrays, every element type, negative and
// out-of-range indices and lengths, and writes that later reads see.

fn fn0() -> (i32) {
  let %0: imm [i32] = array_new()
  let %1: i32 = array_len(%0)
  jump ret(%1)
}

// Index -1 is out of bounds, not the last element.
fn fn1(%0: i32) -> (i32) {
  let %1: imm [i32] = array_new(1i32, 2i32, 3i32)
  let %2: i32 = array_get(%1, %0)
  jump ret(%2)
}

// A negative length is out of range.
fn fn2(%0: i32) -> (i32) {
  let %1: mut [i64] = array_fill(%0, 1i64)
  let %2: i32 = array_len(%1)
  jump ret(%2)
}

fn fn3(%0: i32, %1: i32) -> (i32) {
  let %2: mut [i32] = array_fill(3i32, 0i32)
  let = array_set(%2, %0, %1)
  let %3: i32 = array_get(%2, 0i32)
  let %4: i32 = array_get(%2, 2i32)
  let %5: i32 = add(%3, %4)
  jump ret(%5)
}

fn fn4() -> (f32) {
  let %0: imm [f32] = array_new(1.5f32, -2.25f32)
  let %1: f32 = array_get(%0, 0i32)
  let %2: f32 = array_get(%0, 1i32)
  let %3: f32 = add(%1, %2)
  jump ret(%3)
}

fn fn5() -> (f64) {
  let %0: mut [f64] = array_fill(2i32, 0.5f64)
  let = array_set(%0, 1i32, 4.0f64)
  let %1: f64 = array_get(%0, 0i32)
  let %2: f64 = array_get(%0, 1i32)
  let %3: f64 = mul(%1, %2)
  jump ret(%3)
}

// An array of arrays: writes through the inner array are seen through
// the outer one.
fn fn6() -> (i32) {
  let %0: mut [i32] = array_fill(2i32, 1i32)
  let %1: mut [mut [i32]] = array_new(%0, %0)
  let = array_set(%0, 1i32, 9i32)
  let %2: mut [i32] = array_get(%1, 1i32)
  let %3: i32 = array_get(%2, 1i32)
  jump ret(%3)
}

// Writing past the end traps.
fn fn7() -> () {
  let %0: mut [i32] = array_fill(2i32, 0i32)
  let = array_set(%0, 2i32, 1i32)
  jump ret()
}

//# run fn0() == 0i32
//# run fn1(2i32) == 3i32
//# run fn1(3i32) traps
//# run fn1(-1i32) traps
//# run fn2(0i32) == 0i32
//# run fn2(-1i32) traps
//# run fn3(0i32, 5i32) == 5i32
//# run fn3(2i32, 6i32) == 6i32
//# run fn3(3i32, 6i32) traps
//# run fn4() == -0.75f32
//# run fn5() == 2.0f64
//# run fn6() == 9i32
//# run fn7() traps
