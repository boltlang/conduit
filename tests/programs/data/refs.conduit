// The `var i` loop from rule 6 in docs/ir.md, with its ref not promoted.

fn fn0(%0: i32) -> (i32) {
  let %1: ref i32 = ref_new(0i32)
  join rec j1() =
    let %2: i32 = ref_get(%1)
    let %3: i32 = lt.s(%2, %0)
    case %3 {
      1 =>
        let %4: i32 = add(%2, 1i32)
        let = ref_set(%1, %4)
        jump j1()
      _ =>
        let %5: i32 = ref_get(%1)
        jump ret(%5)
    }
  in jump j1()
}

//# run fn0(0i32) == 0i32
//# run fn0(7i32) == 7i32
