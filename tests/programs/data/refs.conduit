// The `var i` loop from rule 6 in docs/ir/ir.md, with its ref not promoted.

fn count(%n: i32) -> (i32) {
  let %i: ref i32 = ref_new(0i32)
  join rec loop() =
    let %i1: i32 = ref_get(%i)
    let %more: i32 = lt.s(%i1, %n)
    case %more {
      1 =>
        let %i2: i32 = add(%i1, 1i32)
        let = ref_set(%i, %i2)
        jump loop()
      _ =>
        let %r: i32 = ref_get(%i)
        jump ret(%r)
    }
  in jump loop()
}

//# run count(0i32) == 0i32
//# run count(7i32) == 7i32
