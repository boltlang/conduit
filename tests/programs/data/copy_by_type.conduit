// The type decides what `copy` copies, not the objects: an array or data
// object whose type is already the target mutability is kept, with what it
// holds, and any other one is copied, `ro` ones included. What a copy
// holds is copied by the same rule if it inherits the copy's mutability,
// and shared if it has a mutability of its own.

data data0 {
  (i32)
}

// A `mut` array of `imm` cells copied to `mut` is the array itself: a
// write through the copy is seen in the original.
fn fn0() -> (i32) {
  let %0: imm data0 = new data0.0(1i32)
  let %1: mut [imm data0] = array_new(%0)
  let %2: mut [imm data0] = copy[mut](%1)
  let %3: imm data0 = new data0.0(7i32)
  let = array_set(%2, 0i32, %3)
  let %4: imm data0 = array_get(%1, 0i32)
  let %5: i32 = get data0.0.0(%4)
  jump ret(%5)
}

// An `ro` array that's really `mut` is copied anyway, since its type
// doesn't say it's `mut`, and so are the cells it owns: the copy's cells
// can be written without changing the original's.
fn fn1() -> (i32) {
  let %0: mut data0 = new data0.0(1i32)
  let %1: mut [inherit data0] = array_new(%0)
  let %2: i32 = call fn2(%1)
  let %3: i32 = get data0.0.0(%0)
  let %4: i32 = mul(%2, 10i32)
  let %5: i32 = add(%4, %3)
  jump ret(%5)
}

fn fn2(%0: ro [inherit data0]) -> (i32) {
  let %1: mut [inherit data0] = copy[mut](%0)
  let %2: mut data0 = array_get(%1, 0i32)
  let = set data0.0.0(%2, 5i32)
  let %3: i32 = get data0.0.0(%2)
  jump ret(%3)
}

// An `ro` array of `mut` cells: the array is copied, but the cells have
// their own mutability, so they're shared with the original.
fn fn3() -> (i32) {
  let %0: mut data0 = new data0.0(1i32)
  let %1: mut [mut data0] = array_new(%0)
  let %2: i32 = call fn4(%1)
  let %3: i32 = get data0.0.0(%0)
  jump ret(%3)
}

fn fn4(%0: ro [mut data0]) -> (i32) {
  let %1: mut [mut data0] = copy[mut](%0)
  let %2: mut data0 = array_get(%1, 0i32)
  let = set data0.0.0(%2, 9i32)
  let = array_set(%1, 0i32, %2)
  jump ret(0i32)
}

// An `imm` array of cells it owns copied to `mut`: both are copied.
fn fn5() -> (i32) {
  let %0: imm data0 = new data0.0(1i32)
  let %1: imm [inherit data0] = array_new(%0)
  let %2: mut [inherit data0] = copy[mut](%1)
  let %3: mut data0 = array_get(%2, 0i32)
  let = set data0.0.0(%3, 6i32)
  let %4: i32 = get data0.0.0(%3)
  let %5: i32 = get data0.0.0(%0)
  let %6: i32 = mul(%4, 10i32)
  let %7: i32 = add(%6, %5)
  jump ret(%7)
}

// An `imm` array of `imm` cells copied to `mut`: the array is copied, and
// the cells are shared, still `imm`. Replacing one in the copy leaves the
// original as it was.
fn fn6() -> (i32) {
  let %0: imm data0 = new data0.0(1i32)
  let %1: imm [imm data0] = array_new(%0)
  let %2: mut [imm data0] = copy[mut](%1)
  let %3: imm data0 = array_get(%2, 0i32)
  let %4: imm data0 = new data0.0(8i32)
  let = array_set(%2, 0i32, %4)
  let %5: imm data0 = array_get(%2, 0i32)
  let %6: i32 = get data0.0.0(%5)
  let %7: imm data0 = array_get(%1, 0i32)
  let %8: i32 = get data0.0.0(%7)
  let %9: i32 = get data0.0.0(%3)
  let %10: i32 = mul(%6, 100i32)
  let %11: i32 = mul(%8, 10i32)
  let %12: i32 = add(%10, %11)
  let %13: i32 = add(%12, %9)
  jump ret(%13)
}

//# run fn0() == 7i32
//# run fn1() == 51i32
//# run fn3() == 9i32
//# run fn5() == 61i32
//# run fn6() == 811i32
//# wasm-error: copy isn't supported yet
