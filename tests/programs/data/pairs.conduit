// A struct: one constructor, so no tag, and a field written in place.

data Pair {
  (i32, i32)
}

fn main(%a: i32, %b: i32) -> (i32) {
  let %p: mut Pair = new Pair.0(%a, %b)
  let = set Pair.0.0(%p, 10i32)
  let %a2: i32 = get Pair.0.0(%p)
  let %b2: i32 = get Pair.0.1(%p)
  let %r: i32 = sub(%a2, %b2)
  jump ret(%r)
}

//# run main(1i32, 3i32) == 7i32
