//# run fn2(-129f64) traps
//# run fn2(f64_bits(9221120237041090560)) traps
//# run fn3(255.5f64) == 255i8
//# run fn3(-0.5f64) == 0i8
//# run fn3(256f64) traps
//# run fn3(-1f64) traps
//# run fn4(32767f32) == 32767i16
//# run fn4(-32768f32) == -32768i16
//# run fn4(32768f32) traps
//# run fn5(-1i16) == (-1f64, 65535f32)
//# run fn6(-128i8) == 1i32
//# run fn6(255i8) == 2i32
//# run fn6(127i8) == 3i32
//# run fn6(0i8) == 0i32
//# run fn7(-2i16) == 10i32
//# run fn7(2i16) == 14i32
//# run fn7(65535i16) == 11i32
//# run fn7(3i16) == 0i32
//# run fn8(-5i8) == -5i8
//# run fn10(-1i8) == (-1i8, 255i32)
//# run fn10(100i8) == (100i8, 100i32)
//# run fn11(1i16) == 256i16
//# run fn11(32767i16) == -32514i16
//# run fn12(-1i8, 0i16) == 1i32
//# run fn12(127i8, 127i16) == 0i32
