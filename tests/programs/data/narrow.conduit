// i8 and i16 outside arithmetic: conversions, case, box, arrays and data
// fields. Each function first adds the smallest value to its argument
// twice, which gives it back but leaves the high bits of its Wasm i32 set.

data Small {
  (i8, i16)
}

// To wider integers, read as signed or unsigned.
fn widen(%x: i8) -> (i32, i32, i64, i64, i16, i16) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %s32: i32 = convert.s[i32](%x2)
  let %u32: i32 = convert.u[i32](%x2)
  let %s64: i64 = convert.s[i64](%x2)
  let %u64: i64 = convert.u[i64](%x2)
  let %s16: i16 = convert.s[i16](%x2)
  let %u16: i16 = convert.u[i16](%x2)
  jump ret(%s32, %u32, %s64, %u64, %s16, %u16)
}

// To narrower integers: the low bits.
fn narrow(%x: i64) -> (i8, i16, i8) {
  let %s8: i8 = convert.s[i8](%x)
  let %u16: i16 = convert.u[i16](%x)
  let %u8: i8 = convert.u[i8](%u16)
  jump ret(%s8, %u16, %u8)
}

// From and to floats. Out of range traps.
fn f64_to_i8(%x: f64) -> (i8) {
  let %y: i8 = convert.s[i8](%x)
  jump ret(%y)
}

fn f64_to_u8(%x: f64) -> (i8) {
  let %y: i8 = convert.u[i8](%x)
  jump ret(%y)
}

fn f32_to_i16(%x: f32) -> (i16) {
  let %y: i16 = convert.s[i16](%x)
  jump ret(%y)
}

fn to_floats(%x: i16) -> (f64, f32) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %f: f64 = convert.s[f64](%x2)
  let %s: f32 = convert.u[f32](%x2)
  jump ret(%f, %s)
}

// A few arms, then enough for a table.
fn case_i8(%x: i8) -> (i32) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  case %x2 {
    -128 => jump ret(1i32)
    -1 => jump ret(2i32)
    127 => jump ret(3i32)
    _ => jump ret(0i32)
  }
}

fn case_i16(%x: i16) -> (i32) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  case %x2 {
    -2 => jump ret(10i32)
    -1 => jump ret(11i32)
    0 => jump ret(12i32)
    1 => jump ret(13i32)
    2 => jump ret(14i32)
    _ => jump ret(0i32)
  }
}

// A boxed i8 unboxes as an i8.
fn boxed(%x: i8) -> (i8) {
  let %boxed: imm any = box[i8](%x)
  let %y: i8 = unbox[i8](%boxed)
  jump ret(%y)
}

// Arrays store only the low bits, and give them back.
fn array_i8(%x: i8) -> (i8, i32) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %xs: mut [i8] = array_fill(2i32, 0i8)
  let = array_set(%xs, 1i32, %x2)
  let %frozen: imm [i8] = array_clone(%xs)
  let %y: i8 = array_get(%frozen, 1i32)
  let %yu: i32 = convert.u[i32](%y)
  jump ret(%y, %yu)
}

fn array_i16(%x: i16) -> (i16) {
  let %xs: imm [i16] = array_new(%x, 255i16)
  let %a: i16 = array_get(%xs, 0i32)
  let %b: i16 = array_get(%xs, 1i32)
  let %sum: i16 = add(%a, %b)
  jump ret(%sum)
}

// Fields of data types.
fn fields(%a: i8, %b: i16) -> (i32) {
  let %s: imm Small = new Small.0(%a, %b)
  let %a2: i8 = get Small.0.0(%s)
  let %b2: i16 = get Small.0.1(%s)
  let %a16: i16 = convert.s[i16](%a2)
  let %lt: i32 = lt.s(%a16, %b2)
  jump ret(%lt)
}

