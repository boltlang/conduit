// i8 and i16 outside arithmetic: conversions, case, box, arrays and data
// fields. Each function first adds the smallest value to its argument
// twice, which gives it back but leaves the high bits of its Wasm i32 set.

data data1 {
  (i8, i16)
}

// To wider integers, read as signed or unsigned.
fn fn0(%0: i8) -> (i32, i32, i64, i64, i16, i16) {
  let %1: i8 = add(%0, -128i8)
  let %2: i8 = add(%1, -128i8)
  let %3: i32 = convert.s[i32](%2)
  let %4: i32 = convert.u[i32](%2)
  let %5: i64 = convert.s[i64](%2)
  let %6: i64 = convert.u[i64](%2)
  let %7: i16 = convert.s[i16](%2)
  let %8: i16 = convert.u[i16](%2)
  jump ret(%3, %4, %5, %6, %7, %8)
}

// To narrower integers: the low bits.
fn fn1(%0: i64) -> (i8, i16, i8) {
  let %1: i8 = convert.s[i8](%0)
  let %2: i16 = convert.u[i16](%0)
  let %3: i8 = convert.u[i8](%2)
  jump ret(%1, %2, %3)
}

// From and to floats. Out of range traps.
fn fn2(%0: f64) -> (i8) {
  let %1: i8 = convert.s[i8](%0)
  jump ret(%1)
}

fn fn3(%0: f64) -> (i8) {
  let %1: i8 = convert.u[i8](%0)
  jump ret(%1)
}

fn fn4(%0: f32) -> (i16) {
  let %1: i16 = convert.s[i16](%0)
  jump ret(%1)
}

fn fn5(%0: i16) -> (f64, f32) {
  let %1: i16 = add(%0, -32768i16)
  let %2: i16 = add(%1, -32768i16)
  let %3: f64 = convert.s[f64](%2)
  let %4: f32 = convert.u[f32](%2)
  jump ret(%3, %4)
}

// A few arms, then enough for a table.
fn fn6(%0: i8) -> (i32) {
  let %1: i8 = add(%0, -128i8)
  let %2: i8 = add(%1, -128i8)
  case %2 {
    -128 => jump ret(1i32)
    -1 => jump ret(2i32)
    127 => jump ret(3i32)
    _ => jump ret(0i32)
  }
}

fn fn7(%0: i16) -> (i32) {
  let %1: i16 = add(%0, -32768i16)
  let %2: i16 = add(%1, -32768i16)
  case %2 {
    -2 => jump ret(10i32)
    -1 => jump ret(11i32)
    0 => jump ret(12i32)
    1 => jump ret(13i32)
    2 => jump ret(14i32)
    _ => jump ret(0i32)
  }
}

// A boxed i8 unboxes as an i8.
fn fn8(%0: i8) -> (i8) {
  let %1: imm any = box[i8](%0)
  let %2: i8 = unbox[i8](%1)
  jump ret(%2)
}

// Arrays store only the low bits, and give them back.
fn fn10(%0: i8) -> (i8, i32) {
  let %1: i8 = add(%0, -128i8)
  let %2: i8 = add(%1, -128i8)
  let %3: mut [i8] = array_fill(2i32, 0i8)
  let = array_set(%3, 1i32, %2)
  let %4: imm [i8] = array_clone(%3)
  let %5: i8 = array_get(%4, 1i32)
  let %6: i32 = convert.u[i32](%5)
  jump ret(%5, %6)
}

fn fn11(%0: i16) -> (i16) {
  let %1: imm [i16] = array_new(%0, 255i16)
  let %2: i16 = array_get(%1, 0i32)
  let %3: i16 = array_get(%1, 1i32)
  let %4: i16 = add(%2, %3)
  jump ret(%4)
}

// Fields of data types.
fn fn12(%0: i8, %1: i16) -> (i32) {
  let %2: imm data1 = new data1.0(%0, %1)
  let %3: i8 = get data1.0.0(%2)
  let %4: i16 = get data1.0.1(%2)
  let %5: i16 = convert.s[i16](%3)
  let %6: i32 = lt.s(%5, %4)
  jump ret(%6)
}

//# run fn0(-1i8) == (-1i32, 255i32, -1i64, 255i64, -1i16, 255i16)
//# run fn0(127i8) == (127i32, 127i32, 127i64, 127i64, 127i16, 127i16)
//# run fn0(-128i8) == (-128i32, 128i32, -128i64, 128i64, -128i16, 128i16)
//# run fn1(300i64) == (44i8, 300i16, 44i8)
//# run fn1(-1i64) == (-1i8, -1i16, -1i8)
//# run fn1(65663i64) == (127i8, 127i16, 127i8)
//# run fn2(127.9f64) == 127i8
//# run fn2(-128.9f64) == -128i8
