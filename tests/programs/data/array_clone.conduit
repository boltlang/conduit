// `array_clone` makes a new array of the mutability it binds, with the
// same elements, which it shares.

// An `imm` clone doesn't see later writes to the original.
fn imm_clone(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(2i32, %x)
  let %frozen: imm [i32] = array_clone(%xs)
  let = array_set(%xs, 0i32, 5i32)
  let %first: i32 = array_get(%frozen, 0i32)
  jump ret(%first)
}

// A `mut` clone of an `imm` array can be written, and the original stays.
fn mut_clone() -> (i32) {
  let %xs: imm [i32] = array_new(1i32, 2i32)
  let %ys: mut [i32] = array_clone(%xs)
  let = array_set(%ys, 1i32, 7i32)
  let %x: i32 = array_get(%xs, 1i32)
  let %y: i32 = array_get(%ys, 1i32)
  let %y10: i32 = mul(%y, 10i32)
  let %r: i32 = add(%y10, %x)
  jump ret(%r)
}

// A `mut` clone of a `mut` array is a new array too.
fn mut_of_mut() -> (i32) {
  let %xs: mut [i64] = array_fill(1i32, 1i64)
  let %ys: mut [i64] = array_clone(%xs)
  let = array_set(%ys, 0i32, 3i64)
  let %x: i64 = array_get(%xs, 0i32)
  let %r: i32 = convert.s[i32](%x)
  jump ret(%r)
}

// The elements are shared, not copied: a write to an element of the clone
// is seen through the original.
fn shared_elements() -> (i32) {
  let %inner: mut [i32] = array_fill(1i32, 0i32)
  let %outer: mut [mut [i32]] = array_new(%inner, %inner)
  let %copy: mut [mut [i32]] = array_clone(%outer)
  let %inner2: mut [i32] = array_get(%copy, 1i32)
  let = array_set(%inner2, 0i32, 6i32)
  let %inner3: mut [i32] = array_get(%outer, 0i32)
  let %x: i32 = array_get(%inner3, 0i32)
  jump ret(%x)
}

// An `ro` view can be cloned to `imm`, whatever the array really is.
fn from_ro() -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, 2i32)
  let %frozen: imm [i32] = call freeze_ro(%xs)
  let = array_set(%xs, 0i32, 9i32)
  let %x: i32 = array_get(%frozen, 0i32)
  jump ret(%x)
}

fn freeze_ro(%xs: ro [i32]) -> (imm [i32]) {
  let %frozen: imm [i32] = array_clone(%xs)
  jump ret(%frozen)
}

// An empty array clones to an empty array, and floats clone exactly.
fn empty_and_floats() -> (f64) {
  let %empty: mut [f64] = array_new()
  let %empty2: imm [f64] = array_clone(%empty)
  let %len: i32 = array_len(%empty2)
  let %fs: mut [f64] = array_new(-0.5f64, 2.25f64)
  let %fs2: imm [f64] = array_clone(%fs)
  let %f: f64 = array_get(%fs2, 1i32)
  let %lenf: f64 = convert.s[f64](%len)
  let %r: f64 = add(%f, %lenf)
  jump ret(%r)
}

//# run imm_clone(1i32) == 1i32
//# run mut_clone() == 72i32
//# run mut_of_mut() == 1i32
//# run shared_elements() == 6i32
//# run from_ro() == 2i32
//# run empty_and_floats() == 2.25f64
