// Boxing a scalar allocates, and boxing an object is free. Both unbox to
// what was boxed.

data data0 {
  (i32, i32)
}

fn fn0(%0: i32) -> (i32) {
  let %1: imm any = box[i32](%0)
  let %2: i32 = unbox[i32](%1)
  let %3: imm data0 = new data0.0(%2, 1i32)
  let %4: imm any = box[imm data0](%3)
  let %5: imm data0 = unbox[imm data0](%4)
  let %6: i32 = get data0.0.0(%5)
  jump ret(%6)
}

//# run fn0(42i32) == 42i32
