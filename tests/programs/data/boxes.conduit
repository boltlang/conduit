// Boxing a scalar allocates, and boxing an object is free. Both unbox to
// what was boxed.

data Pair {
  (i32, i32)
}

fn main(%x: i32) -> (i32) {
  let %boxed: imm any = box[i32](%x)
  let %x2: i32 = unbox[i32](%boxed)
  let %pair: imm Pair = new Pair.0(%x2, 1i32)
  let %boxed2: imm any = box[imm Pair](%pair)
  let %pair2: imm Pair = unbox[imm Pair](%boxed2)
  let %r: i32 = get Pair.0.0(%pair2)
  jump ret(%r)
}

//# run main(42i32) == 42i32
