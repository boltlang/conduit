// Functions with mutability parameters: one function serves callers of
// either mutability, and each call says which.

// A box holding an array whose mutability the box's type chooses.
data Box['m1] {
  ('m1 [i32])
}

// Gives back what it gets, at the caller's mutability.
fn id['m1](%xs: 'm1 [i32]) -> ('m1 [i32]) {
  jump ret(%xs)
}

// Makes an array of the caller's mutability.
fn fill['m1](%n: i32, %x: i32) -> ('m1 [i32]) {
  let %xs: 'm1 [i32] = array_fill(%n, %x)
  jump ret(%xs)
}

// Puts an array in a box. The box can hold the array only if the array is
// at most the box's mutability: an `imm` box can't hold a `mut` array.
fn box['m1, 'm2](%xs: 'm2 [i32]) -> ('m1 Box['m2]) where 'm2: 'm1 {
  let %b: 'm1 Box['m2] = new Box.0(%xs)
  jump ret(%b)
}

// Passes its own parameter on, and reads what it gets.
fn pass_on['m1](%xs: 'm1 [i32]) -> (i32) {
  let %ys: 'm1 [i32] = call id['m1](%xs)
  let %b: 'm1 Box['m1] = call box['m1, 'm1](%ys)
  let %zs: 'm1 [i32] = get Box.0.0(%b)
  let %x: i32 = array_get(%zs, 0i32)
  jump ret(%x)
}

// A `mut` array comes back `mut`, so it can be written.
fn mut_back() -> (i32) {
  let %xs: mut [i32] = array_fill(2i32, 1i32)
  let %ys: mut [i32] = call id[mut](%xs)
  let = array_set(%ys, 0i32, 7i32)
  let %x: i32 = array_get(%xs, 0i32)
  jump ret(%x)
}

// An `imm` array comes back `imm`, so an `imm` box can hold it.
fn imm_back() -> (i32) {
  let %xs: imm [i32] = array_new(4i32)
  let %ys: imm [i32] = call id[imm](%xs)
  let %b: imm Box[imm] = new Box.0(%ys)
  let %zs: imm [i32] = get Box.0.0(%b)
  let %x: i32 = array_get(%zs, 0i32)
  jump ret(%x)
}

// The caller chooses the mutability of what's made: the `mut` array can
// be written.
fn made() -> (i32) {
  let %xs: mut [i32] = call fill[mut](3i32, 2i32)
  let = array_set(%xs, 2i32, 5i32)
  let %ys: imm [i32] = call fill[imm](1i32, 10i32)
  let %a: i32 = array_get(%xs, 2i32)
  let %b: i32 = array_get(%ys, 0i32)
  let %sum: i32 = add(%a, %b)
  jump ret(%sum)
}

// A `mut` box of an `imm` array, a `mut` box of a `mut` one, and an `imm`
// box of an `imm` one, all from one function.
fn boxes() -> (i32) {
  let %xs: imm [i32] = array_new(1i32)
  let %mut_imm: mut Box[imm] = call box[mut, imm](%xs)
  let %imm_imm: imm Box[imm] = call box[imm, imm](%xs)
  let %ys: mut [i32] = array_new(20i32)
  let %mut_mut: mut Box[mut] = call box[mut, mut](%ys)
  let %ys2: mut [i32] = get Box.0.0(%mut_mut)
  let = array_set(%ys2, 0i32, 30i32)
  let %a: imm [i32] = get Box.0.0(%mut_imm)
  let %b: imm [i32] = get Box.0.0(%imm_imm)
  let %x: i32 = array_get(%a, 0i32)
  let %y: i32 = array_get(%b, 0i32)
  let %z: i32 = array_get(%ys, 0i32)
  let %xy: i32 = add(%x, %y)
  let %r: i32 = add(%xy, %z)
  jump ret(%r)
}

// Generic code calling generic code, at both mutabilities.
fn generic_calls() -> (i32) {
  let %xs: mut [i32] = array_new(100i32)
  let %ys: imm [i32] = array_new(200i32)
  let %a: i32 = call pass_on[mut](%xs)
  let %b: i32 = call pass_on[imm](%ys)
  let %sum: i32 = add(%a, %b)
  jump ret(%sum)
}

// A closure of a generic function keeps its arguments: applying it makes a
// `mut` array.
fn closure() -> (i32) {
  let %f: imm fn(i32) -> (mut [i32]) = closure fill[mut](2i32)
  let %xs: mut [i32] = apply(%f, 6i32)
  let = array_set(%xs, 1i32, 8i32)
  let %a: i32 = array_get(%xs, 0i32)
  let %b: i32 = array_get(%xs, 1i32)
  let %sum: i32 = add(%a, %b)
  jump ret(%sum)
}

// A generic function can box and unbox at its parameter.
fn round_trip['m1](%xs: 'm1 [i32]) -> ('m1 [i32]) {
  let %boxed: mut any = box['m1 [i32]](%xs)
  let %ys: 'm1 [i32] = unbox['m1 [i32]](%boxed)
  jump ret(%ys)
}

fn main_round_trip() -> (i32) {
  let %xs: mut [i32] = array_new(3i32)
  let %ys: mut [i32] = call round_trip[mut](%xs)
  let = array_set(%ys, 0i32, 4i32)
  let %x: i32 = array_get(%xs, 0i32)
  jump ret(%x)
}

//# run mut_back() == 7i32
//# run imm_back() == 4i32
//# run made() == 15i32
//# run boxes() == 32i32
//# run generic_calls() == 300i32
//# run closure() == 14i32
//# run main_round_trip() == 4i32
