// An array's elements can inherit its mutability, as a struct's fields
// can: `mut [inherit Cell]` holds `mut` cells, which belong to the array.
// Seen as `ro`, the cells are `ro` too.

data Cell {
  (i32)
}

// A struct that owns an array of cells it owns.
data Owner {
  (inherit [inherit Cell])
}

// A struct that owns an array of cells it shares.
data Sharer {
  (inherit [imm Cell])
}

// Through an `ro` view, the cells are `ro` as well.
fn through_ro(%x: i32) -> (i32) {
  let %cell: mut Cell = new Cell.0(%x)
  let %cells: mut [inherit Cell] = array_new(%cell)
  let = set Cell.0.0(%cell, 4i32)
  let %r: i32 = call read(%cells)
  jump ret(%r)
}

fn read(%cells: ro [inherit Cell]) -> (i32) {
  let %cell: ro Cell = array_get(%cells, 0i32)
  let %x: i32 = get Cell.0.0(%cell)
  jump ret(%x)
}

// A clone shares the cells, even ones the array owns: a write to a cell
// of the clone is seen through the original.
fn shared_cells() -> (i32) {
  let %cell: mut Cell = new Cell.0(1i32)
  let %cells: mut [inherit Cell] = array_new(%cell)
  let %copy: mut [inherit Cell] = array_clone(%cells)
  let %cell2: mut Cell = array_get(%copy, 0i32)
  let = set Cell.0.0(%cell2, 5i32)
  let %cell3: mut Cell = array_get(%cells, 0i32)
  let %x: i32 = get Cell.0.0(%cell3)
  jump ret(%x)
}

// A `mut` struct rebuilt from an `imm` one around a clone of its array:
// the cells are shared, and the new array can take another cell without
// changing the original.
fn rebuilt() -> (i32) {
  let %cell: imm Cell = new Cell.0(1i32)
  let %cells: imm [imm Cell] = array_new(%cell)
  let %s: imm Sharer = new Sharer.0(%cells)
  let %cells1: imm [imm Cell] = get Sharer.0.0(%s)
  let %copy: mut [imm Cell] = array_clone(%cells1)
  let %cells3: mut Sharer = new Sharer.0(%copy)
  let %cell3: mut [imm Cell] = get Sharer.0.0(%cells3)
  let %three: imm Cell = new Cell.0(3i32)
  let = array_set(%cell3, 0i32, %three)
  let %cells4: imm [imm Cell] = get Sharer.0.0(%s)
  let %cell4: imm Cell = array_get(%cells4, 0i32)
  let %a: i32 = get Cell.0.0(%cell4)
  let %cell5: imm Cell = array_get(%cell3, 0i32)
  let %b: i32 = get Cell.0.0(%cell5)
  let %b10: i32 = mul(%b, 10i32)
  let %r: i32 = add(%b10, %a)
  jump ret(%r)
}

// Through a `mut` struct that owns its array and the array's cells, the
// cells are `mut`: a write to one is seen through the cell itself.
fn owned(%x: i32) -> (i32) {
  let %cell: mut Cell = new Cell.0(%x)
  let %cells: mut [inherit Cell] = array_new(%cell)
  let %o: mut Owner = new Owner.0(%cells)
  let %cells2: mut [inherit Cell] = get Owner.0.0(%o)
  let %cell2: mut Cell = array_get(%cells2, 0i32)
  let = set Cell.0.0(%cell2, 6i32)
  let %r: i32 = get Cell.0.0(%cell)
  jump ret(%r)
}

// An `imm` array of cells it owns is made of `imm` cells.
fn imm_cells() -> (i32) {
  let %cell: imm Cell = new Cell.0(2i32)
  let %cells: imm [inherit Cell] = array_new(%cell, %cell)
  let %len: i32 = array_len(%cells)
  let %cell2: imm Cell = array_get(%cells, 1i32)
  let %x: i32 = get Cell.0.0(%cell2)
  let %r: i32 = add(%len, %x)
  jump ret(%r)
}

//# run through_ro(1i32) == 4i32
//# run shared_cells() == 5i32
//# run rebuilt() == 31i32
//# run imm_cells() == 4i32
//# run owned(1i32) == 6i32
