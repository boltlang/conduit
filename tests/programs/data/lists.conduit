// A list: build one, match on it, and read its fields.

data List {
  ()
  (i32, inherit List)
}

// build(n) = if n == 0 { Nil } else { Cons(n, build(n - 1)) }
fn build(%n: i32) -> (imm List) {
  case %n {
    0 =>
      let %nil: imm List = new List.0()
      jump ret(%nil)
    _ =>
      let %n1: i32 = sub(%n, 1i32)
      let %rest: imm List = call build(%n1)
      let %list: imm List = new List.1(%n, %rest)
      jump ret(%list)
  }
}

// sum(l) = case l { Nil => 0, Cons => l.0 + sum(l.1) }
fn sum(%l: imm List) -> (i32) {
  case %l {
    List.0 => jump ret(0i32)
    List.1 =>
      let %head: i32 = get List.1.0(%l)
      let %tail: imm List = get List.1.1(%l)
      let %rest: i32 = call sum(%tail)
      let %r: i32 = add(%head, %rest)
      jump ret(%r)
  }
}

// sum(build(n))
fn sum_build(%n: i32) -> (i32) {
  let %l: imm List = call build(%n)
  let %r: i32 = call sum(%l)
  jump ret(%r)
}

// is_nil(build(n)), with a default arm
fn is_nil(%n: i32) -> (i32) {
  let %l: imm List = call build(%n)
  case %l {
    List.1 => jump ret(0i32)
    _ => jump ret(1i32)
  }
}

//# run sum_build(0i32) == 0i32
//# run sum_build(10i32) == 55i32
//# run is_nil(0i32) == 1i32
//# run is_nil(3i32) == 0i32
