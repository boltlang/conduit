// Data types with mutability parameters: one declaration serves every
// mutability its fields can have, chosen by each type's arguments.

// A box holding an array whose mutability the box's type chooses.
data Box['m1] {
  ('m1 [i32])
}

// A list of boxes: the list owns its cells (`inherit`), and the arrays in
// the boxes have the mutability its argument chooses.
data List['m1] {
  ()
  (inherit Box['m1], inherit List['m1])
}

// A `mut` box can hold an `imm` array, and take another one.
fn imm_in_mut() -> (i32) {
  let %xs: imm [i32] = array_new(1i32, 2i32)
  let %b: mut Box[imm] = new Box.0(%xs)
  let %ys: imm [i32] = array_new(5i32)
  let = set Box.0.0(%b, %ys)
  let %xs2: imm [i32] = get Box.0.0(%b)
  let %x: i32 = array_get(%xs2, 0i32)
  jump ret(%x)
}

// A `mut` box of a `mut` array: a write through the array is seen
// through the box.
fn mut_in_mut() -> (i32) {
  let %xs: mut [i32] = array_fill(2i32, 0i32)
  let %b: mut Box[mut] = new Box.0(%xs)
  let = array_set(%xs, 1i32, 9i32)
  let %ys: mut [i32] = get Box.0.0(%b)
  let %x: i32 = array_get(%ys, 1i32)
  jump ret(%x)
}

// An `imm` box rebuilt from a `mut` box of a `mut` array, around an `imm`
// clone of the array: later writes to the original don't show in it.
fn frozen_box() -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, 1i32)
  let %b: mut Box[mut] = new Box.0(%xs)
  let %ys: mut [i32] = get Box.0.0(%b)
  let %frozen: imm [i32] = array_clone(%ys)
  let %fb: imm Box[imm] = new Box.0(%frozen)
  let = array_set(%xs, 0i32, 8i32)
  let %fs: imm [i32] = get Box.0.0(%fb)
  let %x: i32 = array_get(%fs, 0i32)
  jump ret(%x)
}

// Two `mut` boxes rebuilt from an `imm` one: one shares the array, and the
// other holds a `mut` clone of it.
fn rebuilt() -> (i32) {
  let %xs: imm [i32] = array_new(1i32)
  let %b: imm Box[imm] = new Box.0(%xs)
  let %ys: imm [i32] = get Box.0.0(%b)
  let %shared: mut Box[imm] = new Box.0(%ys)
  let %copy: mut [i32] = array_clone(%ys)
  let %owned: mut Box[mut] = new Box.0(%copy)
  let %xs2: mut [i32] = get Box.0.0(%owned)
  let = array_set(%xs2, 0i32, 4i32)
  let %xs3: imm [i32] = get Box.0.0(%shared)
  let %x: i32 = array_get(%xs3, 0i32)
  let %y: i32 = array_get(%xs2, 0i32)
  let %y10: i32 = mul(%y, 10i32)
  let %r: i32 = add(%y10, %x)
  jump ret(%r)
}

// Seen as `ro`, a box still gives its argument's mutability.
fn through_ro() -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, 0i32)
  let %b: mut Box[mut] = new Box.0(%xs)
  let = call write3(%b)
  let %x: i32 = array_get(%xs, 0i32)
  jump ret(%x)
}

fn write3(%b: ro Box[mut]) -> () {
  let %xs: mut [i32] = get Box.0.0(%b)
  let = array_set(%xs, 0i32, 3i32)
  jump ret()
}

// A list of two boxes of `imm` arrays, summed through an `ro` view.
fn list() -> (i32) {
  let %nil: mut List[imm] = new List.0()
  let %xs: imm [i32] = array_new(2i32)
  let %b: mut Box[imm] = new Box.0(%xs)
  let %l: mut List[imm] = new List.1(%b, %nil)
  let %ys: imm [i32] = array_new(5i32)
  let %b2: mut Box[imm] = new Box.0(%ys)
  let %l2: mut List[imm] = new List.1(%b2, %l)
  let %sum: i32 = call sum(%l2)
  jump ret(%sum)
}

fn sum(%l: ro List[imm]) -> (i32) {
  join rec loop(%rest: ro List[imm], %acc: i32) =
    case %rest {
      List.0 => jump ret(%acc)
      List.1 =>
        let %b: ro Box[imm] = get List.1.0(%rest)
        let %xs: imm [i32] = get Box.0.0(%b)
        let %x: i32 = array_get(%xs, 0i32)
        let %acc1: i32 = add(%acc, %x)
        let %tail: ro List[imm] = get List.1.1(%rest)
        jump loop(%tail, %acc1)
    }
  in jump loop(%l, 0i32)
}

//# run imm_in_mut() == 5i32
//# run mut_in_mut() == 9i32
//# run frozen_box() == 1i32
//# run rebuilt() == 41i32
//# run through_ro() == 3i32
//# run list() == 7i32
