fn count(%n: i32) -> (i32) {
  join rec loop(%i: i32) =
    let %more: i32 = lt.s(%i, %n)
    case %more {
      1 =>
        let %i2: i32 = add(%i, 1i32)
        jump loop(%i2)
      _ => jump ret(%i)
    }
  in jump loop(0i32)
}

fn sum(%n: i32) -> (i32) {
  join rec loop(%acc: i32, %i: i32) =
    let %more: i32 = lt.s(%i, %n)
    case %more {
      1 =>
        let %acc2: i32 = add(%acc, %i)
        let %i2: i32 = add(%i, 1i32)
        jump loop(%acc2, %i2)
      _ => jump ret(%acc)
    }
  in jump loop(0i32, 0i32)
}
