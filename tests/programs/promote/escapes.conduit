// Refs that escape stay refs: they're captured, passed to a call, stored,
// boxed or passed to a join point. One that doesn't escape, next to them,
// is still promoted.
fn captured() -> (i32) {
  let %local: ref i32 = ref_new(1i32)
  let %f: mut fn() -> (i32) = closure read(%local)
  let = ref_set(%local, 2i32)
  let %r: i32 = apply(%f)
  jump ret(%r)
}

fn passed() -> (i32) {
  let %local: ref i32 = ref_new(1i32)
  let = call write9(%local)
  let %r: i32 = ref_get(%local)
  jump ret(%r)
}

fn stored() -> (i32) {
  let %local: ref i32 = ref_new(1i32)
  let %outer: ref ref i32 = ref_new(%local)
  let %inner: ref i32 = ref_get(%outer)
  let = ref_set(%inner, 5i32)
  let %r: i32 = ref_get(%local)
  jump ret(%r)
}

fn jumped() -> (i32) {
  let %a: ref i32 = ref_new(1i32)
  let %b: ref i32 = ref_new(2i32)
  join read(%r: ref i32) =
    let %x: i32 = ref_get(%r)
    let %y: i32 = ref_get(%b)
    let %sum: i32 = add(%x, %y)
    jump ret(%sum)
  in jump read(%a)
}

fn boxed() -> (i32) {
  let %local: ref i32 = ref_new(8i32)
  let %boxed: mut any = box[ref i32](%local)
  let %unboxed: ref i32 = unbox[ref i32](%boxed)
  let %r: i32 = ref_get(%unboxed)
  jump ret(%r)
}

fn read(%cell: ref i32) -> (i32) {
  let %x: i32 = ref_get(%cell)
  jump ret(%x)
}

fn write9(%cell: ref i32) -> () {
  let = ref_set(%cell, 9i32)
  jump ret()
}

//# run captured() == 2i32
//# run passed() == 9i32
//# run stored() == 5i32
//# run jumped() == 3i32
//# run boxed() == 8i32
//# opt: promote
