// Refs that escape stay refs: they're captured, passed to a call, stored,
// boxed or passed to a join point. One that doesn't escape, next to them,
// is still promoted.
fn fn0() -> (i32) {
  let %0: ref i32 = ref_new(1i32)
  let %1: mut fn() -> (i32) = closure fn5(%0)
  let = ref_set(%0, 2i32)
  let %2: i32 = apply(%1)
  jump ret(%2)
}

fn fn1() -> (i32) {
  let %0: ref i32 = ref_new(1i32)
  let = call fn6(%0)
  let %1: i32 = ref_get(%0)
  jump ret(%1)
}

fn fn2() -> (i32) {
  let %0: ref i32 = ref_new(1i32)
  let %1: ref ref i32 = ref_new(%0)
  let %2: ref i32 = ref_get(%1)
  let = ref_set(%2, 5i32)
  let %3: i32 = ref_get(%0)
  jump ret(%3)
}

fn fn3() -> (i32) {
  let %0: ref i32 = ref_new(1i32)
  let %1: ref i32 = ref_new(2i32)
  join j1(%2: ref i32) =
    let %3: i32 = ref_get(%2)
    let %4: i32 = ref_get(%1)
    let %5: i32 = add(%3, %4)
    jump ret(%5)
  in jump j1(%0)
}

fn fn4() -> (i32) {
  let %0: ref i32 = ref_new(8i32)
  let %1: mut any = box[ref i32](%0)
  let %2: ref i32 = unbox[ref i32](%1)
  let %3: i32 = ref_get(%2)
  jump ret(%3)
}

fn fn5(%0: ref i32) -> (i32) {
  let %1: i32 = ref_get(%0)
  jump ret(%1)
}

fn fn6(%0: ref i32) -> () {
  let = ref_set(%0, 9i32)
  jump ret()
}

//# run fn0() == 2i32
//# run fn1() == 9i32
//# run fn2() == 5i32
//# run fn3() == 3i32
//# run fn4() == 8i32
//# opt: promote
