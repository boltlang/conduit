#[export(emu)]
fn count_up(%n: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(%n, 0i32)
  join rec loop(%i: i32, %local: mut [i32]) =
    let %more: i32 = lt.s(%i, %n)
    case %more {
      1 =>
        let = array_set(%local, %i, %i)
        let %i1: i32 = add(%i, 1i32)
        jump loop(%i1, %local)
      _ =>
        let %frozen: imm [i32] = array_freeze(%local)
        let %last: i32 = sub(%n, 1i32)
        let %r: i32 = array_get(%frozen, %last)
        jump ret(%r)
    }
  in jump loop(0i32, %xs)
}
