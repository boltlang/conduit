fn fn0(%0: i32) -> (i32) vars(%1: ref i32, %2: i32) {
  join j1(%4: i32) = jump ret(%4)
  in
  case %0 {
    0 => jump j1(1i32)
    1 => jump j1(10i32)
    _ =>
      let %3: i32 = mul(%0, 100i32)
      jump j1(%3)
  }
}

fn fn1() -> (i32) vars(%0: ref i32, %1: i32, %2: i32) {
  let %3: i32 = mul(3i32, 10i32)
  let %4: i32 = add(%3, 4i32)
  jump ret(%4)
}

fn fn2(%0: i32) -> (i32) vars(%1: ref i32, %2: i32) {
  join j1() = jump ret(7i32)
  in
  case %0 {
    0 => jump j1()
    _ => jump j1()
  }
}

fn fn3(%0: i32) -> (i32) vars(%1: ref i32, %2: i32) {
  join j2(%5: i32) = jump ret(%5)
  in
  join j1(%4: i32) =
    let %3: i32 = add(%0, 1i32)
    jump j2(%4)
  in jump j1(40i32)
}
