#[export(emu)]
fn set_in_branches(%x: i32) -> (i32) {
  join meet(%local: i32) = jump ret(%local)
  in
  case %x {
    0 => jump meet(1i32)
    1 => jump meet(10i32)
    _ =>
      let %y: i32 = mul(%x, 100i32)
      jump meet(%y)
  }
}

#[export(emu)]
fn read_before_write() -> (i32) {
  let %old10: i32 = mul(3i32, 10i32)
  let %r: i32 = add(%old10, 4i32)
  jump ret(%r)
}

#[export(emu)]
fn write_first(%x: i32) -> (i32) {
  join meet() = jump ret(7i32)
  in
  case %x {
    0 => jump meet()
    _ => jump meet()
  }
}

#[export(emu)]
fn passed_on(%x: i32) -> (i32) {
  join second(%local#1: i32) = jump ret(%local#1)
  in
  join first(%local#2: i32) =
    let %x1: i32 = add(%x, 1i32)
    jump second(%local#2)
  in jump first(40i32)
}
