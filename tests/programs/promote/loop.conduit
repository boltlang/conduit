// The loop from rule 6 of docs/ir/ir.md: `var i = 0; while i < n { i = i + 1 };
// return i`. The ref becomes a parameter of the loop.
fn count(%n: i32) -> (i32) {
  let %i: ref i32 = ref_new(0i32)
  join rec loop() =
    let %i1: i32 = ref_get(%i)
    let %more: i32 = lt.s(%i1, %n)
    case %more {
      1 =>
        let %i2: i32 = add(%i1, 1i32)
        let = ref_set(%i, %i2)
        jump loop()
      _ =>
        let %r: i32 = ref_get(%i)
        jump ret(%r)
    }
  in jump loop()
}

// Two locals: a sum and a counter.
fn sum(%n: i32) -> (i32) {
  let %acc: ref i32 = ref_new(0i32)
  let %i: ref i32 = ref_new(0i32)
  join rec loop() =
    let %i1: i32 = ref_get(%i)
    let %more: i32 = lt.s(%i1, %n)
    case %more {
      1 =>
        let %acc1: i32 = ref_get(%acc)
        let %acc2: i32 = add(%acc1, %i1)
        let = ref_set(%acc, %acc2)
        let %i2: i32 = add(%i1, 1i32)
        let = ref_set(%i, %i2)
        jump loop()
      _ =>
        let %r: i32 = ref_get(%acc)
        jump ret(%r)
    }
  in jump loop()
}

//# run count(5i32) == 5i32
//# run count(-1i32) == 0i32
//# run sum(5i32) == 10i32
//# opt: promote
