// The loop from rule 6 of docs/ir.md: `var i = 0; while i < n { i = i + 1 };
// return i`. The ref becomes a parameter of the loop.
fn fn0(%0: i32) -> (i32) {
  let %1: ref i32 = ref_new(0i32)
  join rec j1() =
    let %2: i32 = ref_get(%1)
    let %3: i32 = lt.s(%2, %0)
    case %3 {
      1 =>
        let %4: i32 = add(%2, 1i32)
        let = ref_set(%1, %4)
        jump j1()
      _ =>
        let %5: i32 = ref_get(%1)
        jump ret(%5)
    }
  in jump j1()
}

// Two locals: a sum and a counter.
fn fn1(%0: i32) -> (i32) {
  let %1: ref i32 = ref_new(0i32)
  let %2: ref i32 = ref_new(0i32)
  join rec j1() =
    let %3: i32 = ref_get(%2)
    let %4: i32 = lt.s(%3, %0)
    case %4 {
      1 =>
        let %5: i32 = ref_get(%1)
        let %6: i32 = add(%5, %3)
        let = ref_set(%1, %6)
        let %7: i32 = add(%3, 1i32)
        let = ref_set(%2, %7)
        jump j1()
      _ =>
        let %8: i32 = ref_get(%1)
        jump ret(%8)
    }
  in jump j1()
}

//# run fn0(5i32) == 5i32
//# run fn0(-1i32) == 0i32
//# run fn1(5i32) == 10i32
//# opt: promote
