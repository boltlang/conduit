// A ref set in some branches and read where they meet: the join point
// gets the value each branch leaves.
fn set_in_branches(%x: i32) -> (i32) {
  let %local: ref i32 = ref_new(1i32)
  join meet() =
    let %value: i32 = ref_get(%local)
    jump ret(%value)
  in
  case %x {
    0 => jump meet()
    1 =>
      let = ref_set(%local, 10i32)
      jump meet()
    _ =>
      let %y: i32 = mul(%x, 100i32)
      let = ref_set(%local, %y)
      jump meet()
  }
}

// A value read before a write keeps the old value.
fn read_before_write() -> (i32) {
  let %local: ref i32 = ref_new(3i32)
  let %old: i32 = ref_get(%local)
  let = ref_set(%local, 4i32)
  let %new: i32 = ref_get(%local)
  let %old10: i32 = mul(%old, 10i32)
  let %r: i32 = add(%old10, %new)
  jump ret(%r)
}

// A join point that writes the ref before reading it doesn't need its
// value, so it gets no parameter.
fn write_first(%x: i32) -> (i32) {
  let %local: ref i32 = ref_new(0i32)
  join meet() =
    let = ref_set(%local, 7i32)
    let %value: i32 = ref_get(%local)
    jump ret(%value)
  in
  case %x {
    0 =>
      let = ref_set(%local, 1i32)
      jump meet()
    _ => jump meet()
  }
}

// A read that a jump to another join point needs: first passes it on to second.
fn passed_on(%x: i32) -> (i32) {
  let %local: ref i32 = ref_new(%x)
  join second() =
    let %value: i32 = ref_get(%local)
    jump ret(%value)
  in
  join first() =
    let %x1: i32 = add(%x, 1i32)
    jump second()
  in
  let = ref_set(%local, 40i32)
  jump first()
}

//# run set_in_branches(0i32) == 1i32
//# run set_in_branches(1i32) == 10i32
//# run set_in_branches(2i32) == 200i32
//# run read_before_write() == 34i32
//# run write_first(0i32) == 7i32
//# run write_first(1i32) == 7i32
//# run passed_on(1i32) == 40i32
//# opt: promote
