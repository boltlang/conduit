// A local holding an array: once the ref is gone, nothing else can reach
// the array, so its clone to `imm` is frozen in place.
fn fn0(%0: i32) -> (i32) {
  let %1: mut [i32] = array_fill(%0, 0i32)
  let %2: ref mut [i32] = ref_new(%1)
  join rec j1(%3: i32) =
    let %4: i32 = lt.s(%3, %0)
    case %4 {
      1 =>
        let %5: mut [i32] = ref_get(%2)
        let = array_set(%5, %3, %3)
        let %6: i32 = add(%3, 1i32)
        jump j1(%6)
      _ =>
        let %7: mut [i32] = ref_get(%2)
        let %8: imm [i32] = array_clone(%7)
        let %9: i32 = sub(%0, 1i32)
        let %10: i32 = array_get(%8, %9)
        jump ret(%10)
    }
  in jump j1(0i32)
}

//# run fn0(4i32) == 3i32
//# opt
