// A local holding an array: once the ref is gone, nothing else can reach
// the array, so its clone to `imm` is frozen in place.
fn count_up(%n: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(%n, 0i32)
  let %local: ref mut [i32] = ref_new(%xs)
  join rec loop(%i: i32) =
    let %more: i32 = lt.s(%i, %n)
    case %more {
      1 =>
        let %xs1: mut [i32] = ref_get(%local)
        let = array_set(%xs1, %i, %i)
        let %i1: i32 = add(%i, 1i32)
        jump loop(%i1)
      _ =>
        let %xs2: mut [i32] = ref_get(%local)
        let %frozen: imm [i32] = array_clone(%xs2)
        let %last: i32 = sub(%n, 1i32)
        let %r: i32 = array_get(%frozen, %last)
        jump ret(%r)
    }
  in jump loop(0i32)
}

//# run count_up(4i32) == 3i32
//# opt
