// Values passed to a join point are in the same region as its parameters.

// Both arms pass the array on, and only the clone is used after.
fn both_arms(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, %x)
  join meet(%ys: mut [i32]) =
    let %frozen: imm [i32] = array_clone(%ys)
    let %first: i32 = array_get(%frozen, 0i32)
    jump ret(%first)
  in
  case %x {
    0 => jump meet(%xs)
    _ =>
      let = array_set(%xs, 0i32, 9i32)
      jump meet(%xs)
  }
}

// The join point gets the original twice, and writes it through the
// second after cloning the first.
fn twice(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, %x)
  join meet(%a: mut [i32], %b: mut [i32]) =
    let %frozen: imm [i32] = array_clone(%a)
    let = array_set(%b, 0i32, 9i32)
    let %first: i32 = array_get(%frozen, 0i32)
    jump ret(%first)
  in jump meet(%xs, %xs)
}

//# run both_arms(0i32) == 0i32
//# run both_arms(1i32) == 9i32
//# run twice(1i32) == 1i32
//# opt: copies
