// Values passed to a join point are in the same region as its parameters.

// Both arms pass the array on, and only the clone is used after.
fn fn0(%0: i32) -> (i32) {
  let %1: mut [i32] = array_fill(1i32, %0)
  join j1(%2: mut [i32]) =
    let %3: imm [i32] = array_clone(%2)
    let %4: i32 = array_get(%3, 0i32)
    jump ret(%4)
  in
  case %0 {
    0 => jump j1(%1)
    _ =>
      let = array_set(%1, 0i32, 9i32)
      jump j1(%1)
  }
}

// The join point gets the original twice, and writes it through the
// second after cloning the first.
fn fn1(%0: i32) -> (i32) {
  let %1: mut [i32] = array_fill(1i32, %0)
  join j1(%2: mut [i32], %3: mut [i32]) =
    let %4: imm [i32] = array_clone(%2)
    let = array_set(%3, 0i32, 9i32)
    let %5: i32 = array_get(%4, 0i32)
    jump ret(%5)
  in jump j1(%1, %1)
}

//# run fn0(0i32) == 0i32
//# run fn0(1i32) == 9i32
//# run fn1(1i32) == 1i32
//# opt: copies
