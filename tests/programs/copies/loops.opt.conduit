fn fn0(%0: i32) -> (i32) {
  let %1: mut [i32] = array_fill(1i32, 0i32)
  join rec j1(%2: i32, %3: i32) =
    let %4: i32 = ge.s(%2, %0)
    case %4 {
      1 => jump ret(%3)
      _ =>
        let = array_set(%1, 0i32, %2)
        let %5: imm [i32] = array_clone(%1)
        let %6: i32 = array_get(%5, 0i32)
        let %7: i32 = add(%3, %6)
        let %8: i32 = add(%2, 1i32)
        jump j1(%8, %7)
    }
  in jump j1(0i32, 0i32)
}

fn fn1(%0: i32) -> (i32) {
  join rec j1(%1: i32, %2: i32) =
    let %3: i32 = ge.s(%1, %0)
    case %3 {
      1 => jump ret(%2)
      _ =>
        let %4: mut [i32] = array_fill(1i32, 0i32)
        let = array_set(%4, 0i32, %1)
        let %5: imm [i32] = array_freeze(%4)
        let %6: i32 = array_get(%5, 0i32)
        let %7: i32 = add(%2, %6)
        let %8: i32 = add(%1, 1i32)
        jump j1(%8, %7)
    }
  in jump j1(0i32, 0i32)
}
