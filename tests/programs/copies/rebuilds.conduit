// A rebuild of an `imm` object from its own fields, at the same type, is
// the object. Rebuilds of anything else stay.
data Point {
  (i32, i32)
}

// A line between two points.
data Line {
  (inherit Point, inherit Point)
}

// None, or Some.
data Option {
  ()
  (i32)
}

// Removed: the fields, in order, of one `imm` object.
fn point(%p: imm Point) -> (imm Point) {
  let %x: i32 = get Point.0.0(%p)
  let %y: i32 = get Point.0.1(%p)
  let %q: imm Point = new Point.0(%x, %y)
  jump ret(%q)
}

// Removed: a rebuild whose fields are rebuilds, so all three go.
fn line(%l: imm Line) -> (imm Line) {
  let %a: imm Point = get Line.0.0(%l)
  let %ax: i32 = get Point.0.0(%a)
  let %ay: i32 = get Point.0.1(%a)
  let %a2: imm Point = new Point.0(%ax, %ay)
  let %b: imm Point = get Line.0.1(%l)
  let %bx: i32 = get Point.0.0(%b)
  let %by: i32 = get Point.0.1(%b)
  let %b2: imm Point = new Point.0(%bx, %by)
  let %l2: imm Line = new Line.0(%a2, %b2)
  jump ret(%l2)
}

// Removed: in the arm that knows the constructor.
fn option(%o: imm Option) -> (imm Option) {
  case %o {
    Option.1 =>
      let %x: i32 = get Option.1.0(%o)
      let %o2: imm Option = new Option.1(%x)
      jump ret(%o2)
    _ => jump ret(%o)
  }
}

// Kept: a `mut` object, which may change after.
fn from_mut(%p: mut Point) -> (imm Point) {
  let %x: i32 = get Point.0.0(%p)
  let %y: i32 = get Point.0.1(%p)
  let %q: imm Point = new Point.0(%x, %y)
  jump ret(%q)
}

// Kept: a `ro` view, which may be of a `mut` object.
fn from_ro(%p: ro Point) -> (imm Point) {
  let %x: i32 = get Point.0.0(%p)
  let %y: i32 = get Point.0.1(%p)
  let %q: imm Point = new Point.0(%x, %y)
  jump ret(%q)
}

// Kept: the fields swapped, a field from another object, and a field that
// isn't read from one.
fn not_rebuilds(%p: imm Point, %q: imm Point) -> (imm Point, imm Point, imm Point) {
  let %x: i32 = get Point.0.0(%p)
  let %y: i32 = get Point.0.1(%p)
  let %swapped: imm Point = new Point.0(%y, %x)
  let %qy: i32 = get Point.0.1(%q)
  let %mixed: imm Point = new Point.0(%x, %qy)
  let %zeroed: imm Point = new Point.0(%x, 0i32)
  jump ret(%swapped, %mixed, %zeroed)
}

// Kept: a `mut` rebuild, which is a new object that can be changed.
fn to_mut(%p: imm Point) -> (mut Point) {
  let %x: i32 = get Point.0.0(%p)
  let %y: i32 = get Point.0.1(%p)
  let %q: mut Point = new Point.0(%x, %y)
  jump ret(%q)
}

fn main() -> (i32) {
  let %a: imm Point = new Point.0(1i32, 2i32)
  let %b: imm Point = new Point.0(3i32, 4i32)
  let %l: imm Line = new Line.0(%a, %b)
  let %p: imm Point = call point(%a)
  let %l2: imm Line = call line(%l)
  let %b2: imm Point = get Line.0.1(%l2)
  let %x: i32 = get Point.0.0(%p)
  let %y: i32 = get Point.0.1(%b2)
  let %sum: i32 = add(%x, %y)
  jump ret(%sum)
}

//# run main() == 5i32
//# opt: copies
