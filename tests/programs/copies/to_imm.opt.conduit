data Vec {
  (inherit [i32], i32)
}

fn to_imm['m1](%v: 'm1 Vec) -> (imm Vec) {
  let %items: 'm1 [i32] = get Vec.0.0(%v)
  let %frozen: imm [i32] = array_clone(%items)
  let %len: i32 = get Vec.0.1(%v)
  let %w: imm Vec = new Vec.0(%frozen, %len)
  jump ret(%w)
}

fn to_imm_imm(%v: imm Vec) -> (imm Vec) {
  jump ret(%v)
}

fn fresh(%n: i32) -> (i32) {
  let %items#1: mut [i32] = array_fill(%n, 1i32)
  let %v: mut Vec = new Vec.0(%items#1, %n)
  join j1(%w#3: imm Vec) =
    let %len#4: i32 = get Vec.0.1(%w#3)
    jump ret(%len#4)
  in
  let %items#5: mut [i32] = get Vec.0.0(%v)
  let %frozen: imm [i32] = array_clone(%items#5)
  let %len#7: i32 = get Vec.0.1(%v)
  let %w#8: imm Vec = new Vec.0(%frozen, %len#7)
  jump j1(%w#8)
}

fn main() -> (i32) {
  let %items: imm [i32] = array_new(1i32, 2i32)
  let %v: imm Vec = new Vec.0(%items, 2i32)
  join j1(%w: imm Vec) =
    let %len: i32 = get Vec.0.1(%w)
    jump ret(%len)
  in jump j1(%v)
}
