// A dead `new` that holds the original after the copy, and puts it in the
// same region as a parameter, doesn't keep the copy once it's removed.

data data0 {
  (i32, i32)
}

data data1 {
  (mut data0, mut data0)
}

fn fn0(%0: i32) -> (i32) {
  let %1: mut data0 = new data0.0(%0, 2i32)
  let %2: imm data0 = copy[imm](%1)
  let %3: mut data0 = new data0.0(0i32, 0i32)
  let %4: i32 = call fn1(%3)
  let %5: mut data1 = new data1.0(%1, %3)
  let %6: i32 = get data0.0.0(%2)
  jump ret(%6)
}

fn fn1(%0: mut data0) -> (i32) {
  jump ret(0i32)
}

//# run fn0(1i32) == 1i32
//# wasm-error: copy isn't supported yet
//# opt: dce, copies
