// A dead `new` that holds the original after the clone, and puts it in the
// same region as an array passed to a call, doesn't keep the clone once
// it's removed.

data Two {
  (mut [i32], mut [i32])
}

fn main(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, %x)
  let %frozen: imm [i32] = array_clone(%xs)
  let %other: mut [i32] = array_fill(1i32, 0i32)
  let %r: i32 = call take(%other)
  let %both: mut Two = new Two.0(%xs, %other)
  let %first: i32 = array_get(%frozen, 0i32)
  jump ret(%first)
}

fn take(%xs: mut [i32]) -> (i32) {
  jump ret(0i32)
}

//# run main(1i32) == 1i32
//# opt: copies
//# opt: dce, copies
