// A copy whose type shows it changes nothing is the value itself: an
// `imm` value copied to `imm`, and a `mut` one copied to `mut` whose
// fields all have its mutability.

data data0 {
  (i32, i32)
}

fn fn0(%0: i32) -> (i32) {
  let %1: imm data0 = new data0.0(%0, 2i32)
  let %2: imm data0 = copy[imm](%1)
  let %3: mut data0 = new data0.0(%0, 3i32)
  let %4: mut data0 = copy[mut](%3)
  let = set data0.0.0(%4, 7i32)
  let %5: i32 = get data0.0.0(%2)
  let %6: i32 = get data0.0.0(%3)
  let %7: i32 = add(%5, %6)
  jump ret(%7)
}

