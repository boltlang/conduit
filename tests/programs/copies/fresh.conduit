// An array built here, written, and then only used through its `imm`
// clone is frozen in place instead of cloned.

fn fn0(%0: i32) -> (i32) {
  let %1: mut [i32] = array_fill(2i32, %0)
  let = array_set(%1, 1i32, 5i32)
  let %2: imm [i32] = array_clone(%1)
  let %3: i32 = array_get(%2, 0i32)
  let %4: i32 = array_get(%2, 1i32)
  let %5: i32 = add(%3, %4)
  jump ret(%5)
}

//# run fn0(1i32) == 6i32
//# opt: copies
