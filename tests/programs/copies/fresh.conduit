// An array built here, written, and then only used through its `imm`
// clone is frozen in place instead of cloned.

fn main(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(2i32, %x)
  let = array_set(%xs, 1i32, 5i32)
  let %frozen: imm [i32] = array_clone(%xs)
  let %a: i32 = array_get(%frozen, 0i32)
  let %b: i32 = array_get(%frozen, 1i32)
  let %sum: i32 = add(%a, %b)
  jump ret(%sum)
}

//# run main(1i32) == 6i32
//# opt: copies
