// Edge cases of freezing clones.

// Only the default arm uses the original after the clone, which is enough
// to keep it. The other arm ends in `unreachable`.
fn fn0(%0: i32) -> (i32) {
  let %1: mut [i32] = array_fill(1i32, %0)
  let %2: imm [i32] = array_clone(%1)
  case %0 {
    0 => unreachable
    _ =>
      let = array_set(%1, 0i32, 9i32)
      let %3: i32 = array_get(%2, 0i32)
      jump ret(%3)
  }
}

// Two loops that jump to each other: the second writes the array made
// before both, so cloning it in the first stays a clone.
fn fn1(%0: i32) -> (i32) {
  let %1: mut [i32] = array_fill(1i32, 0i32)
  join rec j1(%2: i32, %3: i32) =
    let %4: imm [i32] = array_clone(%1)
    let %5: i32 = array_get(%4, 0i32)
    let %6: i32 = add(%3, %5)
    case %2 {
      0 => jump ret(%6)
      _ => jump j2(%2, %6)
    }
  and j2(%7: i32, %8: i32) =
    let = array_set(%1, 0i32, %7)
    let %9: i32 = sub(%7, 1i32)
    jump j1(%9, %8)
  in jump j1(%0, 0i32)
}

// A ref holds the original, and is read after the clone.
fn fn2(%0: i32) -> (i32) {
  let %1: mut [i32] = array_fill(1i32, %0)
  let %2: ref mut [i32] = ref_new(%1)
  let %3: imm [i32] = array_clone(%1)
  let %4: mut [i32] = ref_get(%2)
  let = array_set(%4, 0i32, 9i32)
  let %5: i32 = array_get(%3, 0i32)
  jump ret(%5)
}

// A closure captured the original, and is called after the clone.
fn fn3(%0: i32) -> (i32) {
  let %1: mut [i32] = array_fill(1i32, %0)
  let %2: mut fn() -> () = closure fn4(%1)
  let %3: imm [i32] = array_clone(%1)
  let = apply(%2)
  let %4: i32 = array_get(%3, 0i32)
  jump ret(%4)
}

fn fn4(%0: mut [i32]) -> () {
  let = array_set(%0, 0i32, 9i32)
  jump ret()
}

// A box holds the original, and is unboxed after the clone.
fn fn5(%0: i32) -> (i32) {
  let %1: mut [i32] = array_fill(1i32, %0)
  let %2: mut any = box[mut [i32]](%1)
  let %3: imm [i32] = array_clone(%1)
  let %4: mut [i32] = unbox[mut [i32]](%2)
  let = array_set(%4, 0i32, 9i32)
  let %5: i32 = array_get(%3, 0i32)
  jump ret(%5)
}

// The original is only read after the clone, but even that keeps it,
// since the analysis doesn't tell reads from writes.
fn fn6(%0: i32) -> (i32) {
  let %1: mut [i32] = array_fill(1i32, %0)
  let %2: imm [i32] = array_clone(%1)
  let %3: i32 = array_get(%1, 0i32)
  let %4: i32 = array_get(%2, 0i32)
  let %5: i32 = add(%3, %4)
  jump ret(%5)
}

// The elements are shared, so a clone of an array of `mut` arrays to
// `mut` shares them with the original: it's in the same region.
fn fn7(%0: i32) -> (i32) {
  let %1: mut [i32] = array_fill(1i32, %0)
  let %2: mut [mut [i32]] = array_new(%1)
  let %3: mut [mut [i32]] = array_clone(%2)
  let %4: mut [i32] = array_get(%3, 0i32)
  let = array_set(%4, 0i32, 9i32)
  let %5: i32 = array_get(%1, 0i32)
  jump ret(%5)
}

//# run fn0(1i32) == 1i32
//# run fn1(3i32) == 6i32
//# run fn2(1i32) == 1i32
//# run fn3(1i32) == 1i32
//# run fn5(1i32) == 1i32
//# run fn6(1i32) == 2i32
//# run fn7(1i32) == 9i32
//# opt: copies
