// Edge cases of freezing clones.

// Only the default arm uses the original after the clone, which is enough
// to keep it. The other arm ends in `unreachable`.
fn one_arm(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, %x)
  let %frozen: imm [i32] = array_clone(%xs)
  case %x {
    0 => unreachable
    _ =>
      let = array_set(%xs, 0i32, 9i32)
      let %first: i32 = array_get(%frozen, 0i32)
      jump ret(%first)
  }
}

// Two loops that jump to each other: the second writes the array made
// before both, so cloning it in the first stays a clone.
fn two_loops(%n: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, 0i32)
  join rec read(%i: i32, %acc: i32) =
    let %frozen: imm [i32] = array_clone(%xs)
    let %first: i32 = array_get(%frozen, 0i32)
    let %acc1: i32 = add(%acc, %first)
    case %i {
      0 => jump ret(%acc1)
      _ => jump write(%i, %acc1)
    }
  and write(%i2: i32, %acc2: i32) =
    let = array_set(%xs, 0i32, %i2)
    let %i3: i32 = sub(%i2, 1i32)
    jump read(%i3, %acc2)
  in jump read(%n, 0i32)
}

// A ref holds the original, and is read after the clone.
fn in_ref(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, %x)
  let %cell: ref mut [i32] = ref_new(%xs)
  let %frozen: imm [i32] = array_clone(%xs)
  let %xs2: mut [i32] = ref_get(%cell)
  let = array_set(%xs2, 0i32, 9i32)
  let %first: i32 = array_get(%frozen, 0i32)
  jump ret(%first)
}

// A closure captured the original, and is called after the clone.
fn in_closure(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, %x)
  let %write: mut fn() -> () = closure write9(%xs)
  let %frozen: imm [i32] = array_clone(%xs)
  let = apply(%write)
  let %first: i32 = array_get(%frozen, 0i32)
  jump ret(%first)
}

fn write9(%xs: mut [i32]) -> () {
  let = array_set(%xs, 0i32, 9i32)
  jump ret()
}

// A box holds the original, and is unboxed after the clone.
fn in_box(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, %x)
  let %boxed: mut any = box[mut [i32]](%xs)
  let %frozen: imm [i32] = array_clone(%xs)
  let %xs2: mut [i32] = unbox[mut [i32]](%boxed)
  let = array_set(%xs2, 0i32, 9i32)
  let %first: i32 = array_get(%frozen, 0i32)
  jump ret(%first)
}

// The original is only read after the clone, but even that keeps it,
// since the analysis doesn't tell reads from writes.
fn read_after(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, %x)
  let %frozen: imm [i32] = array_clone(%xs)
  let %a: i32 = array_get(%xs, 0i32)
  let %b: i32 = array_get(%frozen, 0i32)
  let %sum: i32 = add(%a, %b)
  jump ret(%sum)
}

// The elements are shared, so a clone of an array of `mut` arrays to
// `mut` shares them with the original: it's in the same region.
fn nested(%x: i32) -> (i32) {
  let %inner: mut [i32] = array_fill(1i32, %x)
  let %outer: mut [mut [i32]] = array_new(%inner)
  let %copy: mut [mut [i32]] = array_clone(%outer)
  let %inner2: mut [i32] = array_get(%copy, 0i32)
  let = array_set(%inner2, 0i32, 9i32)
  let %first: i32 = array_get(%inner, 0i32)
  jump ret(%first)
}

//# run one_arm(1i32) == 1i32
//# run two_loops(3i32) == 6i32
//# run in_ref(1i32) == 1i32
//# run in_closure(1i32) == 1i32
//# run in_box(1i32) == 1i32
//# run read_after(1i32) == 2i32
//# run nested(1i32) == 9i32
//# opt: copies
