data Holder {
  (mut [i32])
}

#[export(emu)]
fn written_after(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, %x)
  let %frozen: imm [i32] = array_clone(%xs)
  let = array_set(%xs, 0i32, 5i32)
  let %first: i32 = array_get(%frozen, 0i32)
  jump ret(%first)
}

#[export(emu)]
fn held(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, %x)
  let %holder: mut Holder = new Holder.0(%xs)
  let %frozen: imm [i32] = array_clone(%xs)
  let %xs2: mut [i32] = get Holder.0.0(%holder)
  let = array_set(%xs2, 0i32, 5i32)
  let %first: i32 = array_get(%frozen, 0i32)
  jump ret(%first)
}

fn param(%xs: mut [i32]) -> (i32) {
  let %frozen: imm [i32] = array_clone(%xs)
  let %first: i32 = array_get(%frozen, 0i32)
  jump ret(%first)
}

#[export(emu)]
fn passed(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, %x)
  let %r: i32 = call param(%xs)
  let %frozen: imm [i32] = array_clone(%xs)
  let %first: i32 = array_get(%frozen, 0i32)
  jump ret(%first)
}
