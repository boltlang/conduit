// In a loop, an array made before the loop is used again on the next
// round, so cloning it each round stays a clone. An array made in the
// round itself is frozen.

// Clones one array every round, writing it in between.
fn outside(%n: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, 0i32)
  join rec loop(%i: i32, %acc: i32) =
    let %done: i32 = ge.s(%i, %n)
    case %done {
      1 => jump ret(%acc)
      _ =>
        let = array_set(%xs, 0i32, %i)
        let %frozen: imm [i32] = array_clone(%xs)
        let %first: i32 = array_get(%frozen, 0i32)
        let %acc1: i32 = add(%acc, %first)
        let %i1: i32 = add(%i, 1i32)
        jump loop(%i1, %acc1)
    }
  in jump loop(0i32, 0i32)
}

// Makes a new array every round.
fn inside(%n: i32) -> (i32) {
  join rec loop(%i: i32, %acc: i32) =
    let %done: i32 = ge.s(%i, %n)
    case %done {
      1 => jump ret(%acc)
      _ =>
        let %xs: mut [i32] = array_fill(1i32, 0i32)
        let = array_set(%xs, 0i32, %i)
        let %frozen: imm [i32] = array_clone(%xs)
        let %first: i32 = array_get(%frozen, 0i32)
        let %acc1: i32 = add(%acc, %first)
        let %i1: i32 = add(%i, 1i32)
        jump loop(%i1, %acc1)
    }
  in jump loop(0i32, 0i32)
}

//# run outside(4i32) == 6i32
//# run inside(4i32) == 6i32
//# opt: copies
