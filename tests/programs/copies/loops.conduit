// In a loop, an object made before the loop is used again on the next
// round, so copying it each round stays a copy. An object made in the
// round itself is frozen.

data data0 {
  (i32, i32)
}

// Copies one object every round, writing it in between.
fn fn0(%0: i32) -> (i32) {
  let %1: mut data0 = new data0.0(0i32, 0i32)
  join rec j1(%2: i32, %3: i32) =
    let %4: i32 = ge.s(%2, %0)
    case %4 {
      1 => jump ret(%3)
      _ =>
        let = set data0.0.0(%1, %2)
        let %5: imm data0 = copy[imm](%1)
        let %6: i32 = get data0.0.0(%5)
        let %7: i32 = add(%3, %6)
        let %8: i32 = add(%2, 1i32)
        jump j1(%8, %7)
    }
  in jump j1(0i32, 0i32)
}

// Makes a new object every round.
fn fn1(%0: i32) -> (i32) {
  join rec j1(%1: i32, %2: i32) =
    let %3: i32 = ge.s(%1, %0)
    case %3 {
      1 => jump ret(%2)
      _ =>
        let %4: mut data0 = new data0.0(0i32, 0i32)
        let = set data0.0.0(%4, %1)
        let %5: imm data0 = copy[imm](%4)
        let %6: i32 = get data0.0.0(%5)
        let %7: i32 = add(%2, %6)
        let %8: i32 = add(%1, 1i32)
        jump j1(%8, %7)
    }
  in jump j1(0i32, 0i32)
}

//# run fn0(4i32) == 6i32
//# run fn1(4i32) == 6i32
//# wasm-error: copy isn't supported yet
//# opt: copies
