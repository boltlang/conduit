// Copies that must stay copies, because something other than the copy can
// still reach the objects afterwards.

data data0 {
  (i32, i32)
}

data data1 {
  (mut data0)
}

// The original is written after the copy.
fn fn0(%0: i32) -> (i32) {
  let %1: mut data0 = new data0.0(%0, 2i32)
  let %2: imm data0 = copy[imm](%1)
  let = set data0.0.0(%1, 5i32)
  let %3: i32 = get data0.0.0(%2)
  jump ret(%3)
}

// Another object holds the original, and it's used after the copy.
fn fn1(%0: i32) -> (i32) {
  let %1: mut data0 = new data0.0(%0, 2i32)
  let %2: mut data1 = new data1.0(%1)
  let %3: imm data0 = copy[imm](%1)
  let %4: mut data0 = get data1.0.0(%2)
  let = set data0.0.0(%4, 5i32)
  let %5: i32 = get data0.0.0(%3)
  jump ret(%5)
}

// A parameter: the caller may still hold it.
fn fn2(%0: mut data0) -> (i32) {
  let %1: imm data0 = copy[imm](%0)
  let %2: i32 = get data0.0.0(%1)
  jump ret(%2)
}

// The original was passed to a call, which may have kept it.
fn fn3(%0: i32) -> (i32) {
  let %1: mut data0 = new data0.0(%0, 2i32)
  let %2: i32 = call fn2(%1)
  let %3: imm data0 = copy[imm](%1)
  let %4: i32 = get data0.0.0(%3)
  jump ret(%4)
}

//# run fn0(1i32) == 1i32
//# run fn1(1i32) == 1i32
//# run fn3(1i32) == 1i32
//# wasm-error: copy isn't supported yet
//# opt: copies
