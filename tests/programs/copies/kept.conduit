// Clones that must stay clones, because something other than the clone can
// still reach the array afterwards.

data Holder {
  (mut [i32])
}

// The original is written after the clone.
fn written_after(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, %x)
  let %frozen: imm [i32] = array_clone(%xs)
  let = array_set(%xs, 0i32, 5i32)
  let %first: i32 = array_get(%frozen, 0i32)
  jump ret(%first)
}

// An object holds the original, and it's used after the clone.
fn held(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, %x)
  let %holder: mut Holder = new Holder.0(%xs)
  let %frozen: imm [i32] = array_clone(%xs)
  let %xs2: mut [i32] = get Holder.0.0(%holder)
  let = array_set(%xs2, 0i32, 5i32)
  let %first: i32 = array_get(%frozen, 0i32)
  jump ret(%first)
}

// A parameter: the caller may still hold it.
fn param(%xs: mut [i32]) -> (i32) {
  let %frozen: imm [i32] = array_clone(%xs)
  let %first: i32 = array_get(%frozen, 0i32)
  jump ret(%first)
}

// The original was passed to a call, which may have kept it.
fn passed(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(1i32, %x)
  let %r: i32 = call param(%xs)
  let %frozen: imm [i32] = array_clone(%xs)
  let %first: i32 = array_get(%frozen, 0i32)
  jump ret(%first)
}

//# run written_after(1i32) == 1i32
//# run held(1i32) == 1i32
//# run passed(1i32) == 1i32
//# opt: copies
