// Bolt's `to_imm` for a `Vec`, `Vec { items: array_freeze(v.items), len:
// v.len }`, with a mutability parameter for the `Vec` it's given. For an
// `imm` `Vec`, inlining it, dropping the clone of its `imm` buffer and
// then the rebuild leaves the `Vec` itself, with no copy. For a fresh
// `mut` one, both copies stay for now: the buffer isn't frozen in place,
// since `v.len` is read after the clone, and the `Vec` is built again
// (see #9).
data data10 {
  (inherit [i32], i32)
}

fn fn0['m1](%0: 'm1 data10) -> (imm data10) {
  let %1: 'm1 [i32] = get data10.0.0(%0)
  let %2: imm [i32] = array_clone(%1)
  let %3: i32 = get data10.0.1(%0)
  let %4: imm data10 = new data10.0(%2, %3)
  jump ret(%4)
}

fn fn1(%0: imm data10) -> (imm data10) {
  let %1: imm data10 = call fn0[imm](%0)
  jump ret(%1)
}

fn fn2(%0: i32) -> (i32) {
  let %1: mut [i32] = array_fill(%0, 1i32)
  let %2: mut data10 = new data10.0(%1, %0)
  let %3: imm data10 = call fn0[mut](%2)
  let %4: i32 = get data10.0.1(%3)
  jump ret(%4)
}

fn fn3() -> (i32) {
  let %0: imm [i32] = array_new(1i32, 2i32)
  let %1: imm data10 = new data10.0(%0, 2i32)
  let %2: imm data10 = call fn1(%1)
  let %3: i32 = get data10.0.1(%2)
  jump ret(%3)
}

//# run fn2(3i32) == 3i32
//# run fn3() == 2i32
//# opt
