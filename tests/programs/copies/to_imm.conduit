// Bolt's `to_imm` for a `Vec`, `Vec { items: array_freeze(v.items), len:
// v.len }`, with a mutability parameter for the `Vec` it's given. For an
// `imm` `Vec`, inlining it, dropping the clone of its `imm` buffer and
// then the rebuild leaves the `Vec` itself, with no copy. For a fresh
// `mut` one whose copy is only read, inlining the join point that holds
// the rest of the caller lets `simplify` read the length from the rebuilt
// `Vec`'s `new`, which is the original's, and `cse` reads that from the
// original's `new`, so neither copy, nor the original, is used.
data Vec {
  (inherit [i32], i32)
}

fn to_imm['m1](%v: 'm1 Vec) -> (imm Vec) {
  let %items: 'm1 [i32] = get Vec.0.0(%v)
  let %frozen: imm [i32] = array_clone(%items)
  let %len: i32 = get Vec.0.1(%v)
  let %w: imm Vec = new Vec.0(%frozen, %len)
  jump ret(%w)
}

fn to_imm_imm(%v: imm Vec) -> (imm Vec) {
  let %w: imm Vec = call to_imm[imm](%v)
  jump ret(%w)
}

fn fresh(%n: i32) -> (i32) {
  let %items: mut [i32] = array_fill(%n, 1i32)
  let %v: mut Vec = new Vec.0(%items, %n)
  let %w: imm Vec = call to_imm[mut](%v)
  let %len: i32 = get Vec.0.1(%w)
  jump ret(%len)
}

fn main() -> (i32) {
  let %items: imm [i32] = array_new(1i32, 2i32)
  let %v: imm Vec = new Vec.0(%items, 2i32)
  let %w: imm Vec = call to_imm_imm(%v)
  let %len: i32 = get Vec.0.1(%w)
  jump ret(%len)
}

//# run fresh(3i32) == 3i32
//# run main() == 2i32
//# opt
