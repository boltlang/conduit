effect Ask {
  () -> (i32)
}

effect Log {
  (i32) -> ()
}

effect Bump {
  (i32) -> (i32)
}

handler answer for Ask env(i32) ops(ask) ret id

handler answer_logged for Ask does Log env(i32) ops(ask_logged) ret id

handler logging for Log env() ops(log) ret id1

handler bumping for Bump env() ops(bump) ret id1

handler answer_bumped for Ask does Bump env(i32) ops(ask_bumped) ret id

handler doubling for Ask env(i32) ops(ask_doubled) ret id

fn ask(%x: i32, %k: cont(i32) -> (i32)) -> (i32) {
  let %r: i32 = resume(%k, %x)
  jump ret(%r)
}

fn ask_logged(%x: i32, %k: cont(i32) -> (i32) does Log) -> (i32) does Log {
  let %r: i32 = resume(%k, %x)
  jump ret(%r)
}

fn log(%x: i32, %k: cont() -> (i32)) -> (i32) {
  let %r: i32 = resume(%k)
  jump ret(%r)
}

fn bump(%x: i32, %k: cont(i32) -> (i32)) -> (i32) {
  let %x1: i32 = add(%x, 1i32)
  let %r: i32 = resume(%k, %x1)
  jump ret(%r)
}

fn ask_bumped(%x: i32, %k: cont(i32) -> (i32) does Bump) -> (i32) does Bump {
  let %r: i32 = discontinue Bump.0(%k, %x)
  jump ret(%r)
}

fn ask_doubled(%x: i32, %k: cont(i32) -> (i32)) -> (i32) {
  let %r: i32 = resume(%k, %x)
  let %r2: i32 = mul(%r, 2i32)
  jump ret(%r2)
}

fn id(%x: i32, %r: i32) -> (i32) {
  jump ret(%r)
}

fn id1(%r: i32) -> (i32) {
  jump ret(%r)
}

fn just_ask() -> (i32) does Ask {
  let %x: i32 = perform Ask.0()
  jump ret(%x)
}

fn big_ask() -> (i32) does Ask {
  let %x: i32 = perform Ask.0()
  let %a: i32 = add(%x, 1i32)
  let %b: i32 = add(%a, 1i32)
  let %c: i32 = add(%b, 1i32)
  let %d: i32 = add(%c, 1i32)
  let %e: i32 = add(%d, 1i32)
  let %f: i32 = add(%e, 1i32)
  let %g: i32 = add(%f, 1i32)
  let %h: i32 = add(%g, 1i32)
  let %i: i32 = add(%h, 1i32)
  let %j: i32 = add(%i, 1i32)
  let %k: i32 = add(%j, 1i32)
  let %l: i32 = add(%k, 1i32)
  let %m: i32 = add(%l, 1i32)
  let %n: i32 = add(%m, 1i32)
  let %o: i32 = add(%n, 1i32)
  let %p: i32 = add(%o, 1i32)
  let %q: i32 = add(%p, 1i32)
  let %r: i32 = add(%q, 1i32)
  let %s: i32 = add(%r, 1i32)
  let %t: i32 = add(%s, 1i32)
  jump ret(%t)
}

fn calls_big() -> (i32) does Ask {
  let %x: i32 = call big_ask()
  jump ret(%x)
}

fn through_callee() -> (i32) {
  let %body: imm fn() -> (i32) does Ask = closure calls_big()
  let %r: i32 = handle answer(5i32, %body)
  jump ret(%r)
}

fn ask_and_log() -> (i32) does Ask + Log {
  let %x: i32 = perform Ask.0()
  let = perform Log.0(%x)
  jump ret(%x)
}

fn also_logs() -> (i32) does Log {
  let %body: imm fn() -> (i32) does Ask + Log = closure ask_and_log()
  let %r: i32 = handle answer_logged(5i32, %body)
  jump ret(%r)
}

fn logs_outside() -> (i32) {
  let %body: imm fn() -> (i32) does Log = closure also_logs()
  let %r: i32 = handle logging(%body)
  jump ret(%r)
}

fn asks_bumped() -> (i32) does Bump {
  let %body: imm fn() -> (i32) does Ask = closure just_ask()
  let %r: i32 = handle answer_bumped(5i32, %body)
  jump ret(%r)
}

fn discontinues() -> (i32) {
  let %body: imm fn() -> (i32) does Bump = closure asks_bumped()
  let %r: i32 = handle bumping(%body)
  jump ret(%r)
}

fn doubled() -> (i32) {
  let %body: imm fn() -> (i32) does Ask = closure just_ask()
  let %r: i32 = handle doubling(5i32, %body)
  jump ret(%r)
}
