// Cases whose tags don't fit what they branch on.

data data0 {
  ()
  (i32)
}

data data1 {
  ()
}

fn fn0(%0: i32) -> () {
  case %0 {
    4294967296 => jump ret()
    _ => jump ret()
  }
}

fn fn1(%0: i64) -> () {
  case %0 {
    1 => jump ret()
    1 => jump ret()
    _ => jump ret()
  }
}

fn fn2(%0: i32) -> () {
  case %0 {
    data0.0 => jump ret()
    _ => jump ret()
  }
}

fn fn3(%0: imm data0) -> () {
  case %0 {
    data1.0 => jump ret()
    data0.5 => jump ret()
    _ => jump ret()
  }
}

fn fn4(%0: imm data0) -> () {
  case %0 {
    data0.0 => jump ret()
    data0.0 => jump ret()
    data0.1 => jump ret()
  }
}

fn fn5(%0: imm data0) -> () {
  case %0 {
    3 => jump ret()
    _ => jump ret()
  }
}

fn fn6(%0: f64) -> () {
  case %0 {
    _ => jump ret()
  }
}

fn fn7(%0: imm data0) -> () {
  case %0 {
    data0.1 => jump ret()
  }
}

fn fn8(%0: i32) -> () {
  case %0 {
    0 => jump ret()
  }
}

