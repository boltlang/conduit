// A reuse token: `drop_reuse` of an object known to be built by the
// token's constructor, `reuse` of a token of the same shape, and only
// variables hold tokens.

data List {
  ()
  (i32, inherit List)
}

data Pair {
  (f64, inherit List)
}

data Holder {
  (reuse List.1)
}

fn fn1(%l: imm List) -> () {
  let %t: reuse List.1 = drop_reuse(%l)
  case %l {
    List.1 =>
      let %u: reuse List.1 = drop_reuse(%l)
      let %nil: imm List = new List.0()
      let %p: imm Pair = reuse Pair.0(%u, 1.5f64, %nil)
      let %b: imm any = box[reuse List.1](%u)
      jump ret()
    _ => jump ret()
  }
}

//# verify-error: Holder (data2): field 0 of constructor 0: reuse data0.1 can only be a variable's type
//# verify-error: fn1: drop_reuse to a token of data0.1: %0 isn't known to be built by data0.1 here
//# verify-error: fn1: reuse data1.0 takes a token of data0.1, which isn't of the same shape
//# verify-error: fn1: a reuse token can't be boxed
