// `copy[mut]` of a `mut` array keeps the array, so its `imm` elements stay
// `imm` too: claiming they're `mut` would let a write change an `imm`
// object.

data data0 {
  (i32)
}

fn fn0() -> () {
  let %0: imm data0 = new data0.0(1i32)
  let %1: mut [imm data0] = array_new(%0)
  let %2: mut [mut data0] = copy[mut](%1)
  let %3: mut data0 = array_get(%2, 0i32)
  let = set data0.0.0(%3, 5i32)
  jump ret()
}

//# verify-error: fn0: the op gives a mut [imm data0], but %2 has type mut [mut data0]
