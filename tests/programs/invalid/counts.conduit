// `dup`, `drop` and the ops of specialized drops take one object: not a
// scalar, and not two.

fn fn1(%0: i32, %1: imm [i32]) -> () {
  let = dup(%0)
  let = drop(1.5f64)
  let = drop(%1, %1)
  let %2: i32 = is_unique(%0)
  let = free(%0)
  let = decref(%1, %1)
  jump ret()
}

//# verify-error: fn1: dup of a i32, which isn't an object
//# verify-error: fn1: drop of a f64, which isn't an object
//# verify-error: fn1: drop needs one object
//# verify-error: fn1: is_unique of a i32, which isn't an object
//# verify-error: fn1: free of a i32, which isn't an object
//# verify-error: fn1: decref needs one object
