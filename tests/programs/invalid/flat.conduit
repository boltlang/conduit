// What the flat ABI can't pass: data, closures, host values, arrays of
// objects other than byte buffers, `#[addr]` on what isn't an array of scalars, objects
// as results, and `#[addr]` without it.

data data0 {
  (i32)
}

#[link(wasm, module = "env", name = "a")]
#[abi(flat)]
extern extern1(imm data0) -> ()

#[link(wasm, module = "env", name = "b")]
#[abi(flat)]
extern extern2(imm fn() -> ()) -> ()

#[link(wasm, module = "env", name = "c")]
#[abi(flat)]
extern extern3(imm [imm [i32]]) -> ()

#[link(wasm, module = "env", name = "d")]
#[abi(flat)]
extern extern4(#[addr] i32) -> ()

#[link(wasm, module = "env", name = "e")]
#[abi(flat)]
extern extern5(#[addr] imm [imm [i8]]) -> ()

#[link(wasm, module = "env", name = "f")]
#[abi(flat)]
extern extern6() -> (i32, imm [i8])

#[link(wasm, module = "env", name = "g")]
extern extern7(#[addr] imm [i8]) -> ()

#[link(wasm, module = "env", name = "h")]
#[abi(flat)]
extern extern8(host) -> ()

#[link(wasm, module = "env", name = "i")]
#[abi(flat)]
extern extern9() -> (host)

//# verify-error: extern1: the flat ABI can't pass parameter 0, a imm data0
//# verify-error: extern2: the flat ABI can't pass parameter 0, a imm fn() -> ()
//# verify-error: extern3: the flat ABI can't pass parameter 0, a imm [imm [i32]]
//# verify-error: extern4: the flat ABI can't pass parameter 0, a #[addr] i32
//# verify-error: extern5: the flat ABI can't pass parameter 0, a #[addr] imm [imm [i8]]
//# verify-error: extern6: the flat ABI can't give result 1, a imm [i8]: only scalars
//# verify-error: extern7: parameter 0 is #[addr], which only the flat ABI has
//# verify-error: extern8: the flat ABI can't pass parameter 0, a host
//# verify-error: extern9: the flat ABI can't give result 0, a host: only scalars
