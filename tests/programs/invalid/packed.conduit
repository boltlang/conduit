// Packed types are only array elements, and an array of them only gets
// i32s.

data data0 {
  (u8)
}

extern extern1 "test" "byte" (u8) -> ()

fn fn0(%0: u8) -> () {
  jump ret()
}

fn fn1(%0: i32) -> () {
  let %1: ref i16 = ref_new(%0)
  jump ret()
}

fn fn2(%0: mut [u8]) -> (imm [i32]) {
  let %1: imm [i32] = array_clone(%0)
  jump ret(%1)
}

fn fn3(%0: i64) -> () {
  let %1: imm [u8] = array_new(%0)
  jump ret()
}

fn fn4(%0: mut [i8]) -> () {
  let = array_set(%0, 0i32, 1.5f64)
  jump ret()
}

fn fn5(%0: i32) -> (i32) {
  let %1: i32 = convert.u[u8](%0)
  jump ret(%1)
}

//# verify-error: data0: field 0 of constructor 0: u8 is only allowed as an array's element type
//# verify-error: extern1: u8 is only allowed as an array's element type
//# verify-error: fn0: type of %0: u8 is only allowed as an array's element type
//# verify-error: fn1: type of %1: i16 is only allowed as an array's element type
//# verify-error: fn2: array clone of a mut [u8] can't give a imm [i32]: its elements are u8
//# verify-error: fn3: array of u8 gets an element of type i64
//# verify-error: fn4: array of i8 gets an element of type f64
//# verify-error: fn5: can't convert to u8
