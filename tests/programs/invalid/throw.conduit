// `throw`, the built-in effect of exceptions from the host (#59, #38):
// it's in the row of everything that can reach an extern that has it,
// only a handler for it takes it out, and none of that handler's clauses
// may resume.

effect Ask {
  () -> (i32)
}

#[link(wasm, module = "env", name = "boom")]
extern boom() -> () does throw

// Calls an extern that throws, without `throw` in its row.
fn fn0() -> () {
  let = call_extern boom()
  jump ret()
}

fn fn1() -> () does throw {
  let = call_extern boom()
  jump ret()
}

// A closure that throws, of a type that doesn't.
fn fn2() -> () {
  let %f: imm fn() -> () = closure fn1()
  jump ret()
}

// Calls a function that throws.
fn fn3() -> () does Ask {
  let = call fn1()
  jump ret()
}

// A handler for `Ask` doesn't take out `throw`: the body throws, and the
// handler's row doesn't have it.
handler asker for Ask env() ops(fn4) ret fn5

fn fn4(%k: cont(i32) -> ()) -> () {
  let = resume(%k, 1i32)
  jump ret()
}

fn fn5() -> () {
  jump ret()
}

fn fn6() -> () does Ask + throw {
  let %x: i32 = perform Ask.0()
  let = call_extern boom()
  jump ret()
}

fn fn7() -> () does throw {
  let %b: imm fn() -> () does Ask + throw = closure fn6()
  let = handle asker(%b)
  jump ret()
}

// One whose row has `throw` lets it through.
handler passes for Ask does throw env() ops(fn8) ret fn5

fn fn8(%k: cont(i32) -> () does throw) -> () does throw {
  let = resume(%k, 1i32)
  jump ret()
}

fn fn9() -> () does throw {
  let %b: imm fn() -> () does Ask + throw = closure fn6()
  let = handle passes(%b)
  jump ret()
}

// `Any` has `throw`.
fn fn10() -> () does Any {
  let = call fn1()
  jump ret()
}

// A clause for `raise` that resumes: nothing can be resumed after an
// exception.
handler resumes for throw env() ops(fn11) ret fn5

fn fn11(%e: nullable host, %k: cont() -> ()) -> () {
  let = resume(%k)
  jump ret()
}

// One that aborts catches, and takes `throw` out of the row.
handler catches for throw env() ops(fn12) ret fn5

fn fn12(%e: nullable host, %k: cont() -> ()) -> () {
  jump ret()
}

fn fn13() -> () {
  let %b: imm fn() -> () does throw = closure fn1()
  let = handle catches(%b)
  jump ret()
}

//# verify-error: fn0: call_extern extern0 may perform throw, but the function has no effects
//# verify-error: fn2: fn1 does throw, which isn't in the row of fn() -> ()
//# verify-error: fn3: call fn1 may perform throw, but the function only does effect0
//# verify-error: fn7: the body of handle handler0 does throw + effect0, which isn't in effect0
//# verify-error: resumes (handler2): clause fn11 for throw.0 may resume its continuation, but nothing can be resumed after an exception
