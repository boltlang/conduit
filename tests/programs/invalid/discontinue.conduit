// `discontinue` given the wrong arguments, an operation whose results don't
// fit the continuation, or a continuation that's also resumed.

effect effect20 {
  () -> (i64)
}

effect effect21 {
  (i32) -> (i32)
}

fn fn0(%0: i32) -> (i32) {
  let %1: i32 = discontinue effect21.0(%0, 1i32)
  jump ret(%1)
}

fn fn1(%0: cont(i32) -> (i32)) -> (i32) {
  let %1: i32 = discontinue effect20.0(%0)
  jump ret(%1)
}

fn fn2(%0: cont(i32) -> (i32)) -> (i32) {
  let %1: i32 = discontinue effect21.0(%0, 1i64)
  jump ret(%1)
}

fn fn3(%0: cont(i32) -> (i32)) -> (i32) {
  let %1: i32 = discontinue effect21.3(%0, 1i32)
  jump ret(%1)
}

fn fn4(%0: cont(i32) -> (i32)) -> (i32) {
  let %1: i32 = resume(%0, 1i32)
  let %2: i32 = discontinue effect21.0(%0, %1)
  jump ret(%2)
}

// It gives what the continuation gives, not what the operation gives.
fn fn5(%0: cont(i32) -> (i64)) -> (i32) {
  let %1: i32 = discontinue effect21.0(%0, 1i32)
  jump ret(%1)
}

//# verify-error: fn0: discontinue needs a continuation as its first argument
//# verify-error: fn1: discontinue effect20.0: its results don't fit the continuation: value 0 has type i64, but should have i32
//# verify-error: fn2: discontinue effect21.0: value 0 has type i64, but should have i32
//# verify-error: fn3: effect21 has no operation 3
//# verify-error: fn4: continuation %0 may be used more than once
//# verify-error: fn5: the op gives a i64, but %1 has type i32
