// Conversions between every pair of scalar types, by value and by bits,
// at the edges of each type: rounding, wrapping, unsigned readings and
// truncation toward zero. Generated, with results following Wasm.

fn i32_to_i32_s(%x: i32) -> (i32) {
  let %r: i32 = convert.s[i32](%x)
  jump ret(%r)
}

fn i32_to_i64_s(%x: i32) -> (i64) {
  let %r: i64 = convert.s[i64](%x)
  jump ret(%r)
}

fn i32_to_i64_u(%x: i32) -> (i64) {
  let %r: i64 = convert.u[i64](%x)
  jump ret(%r)
}

fn i64_to_i32_s(%x: i64) -> (i32) {
  let %r: i32 = convert.s[i32](%x)
  jump ret(%r)
}

