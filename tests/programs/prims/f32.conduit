// Every f32 operation on edge cases: signed zeros, infinities,
// overflow and NaN. A NaN result is checked with `ne(r, r)`, since
// Wasm doesn't fix a NaN's sign or payload. Generated, with results
// following Wasm.

fn fn0(%0: f32, %1: f32) -> (f32) {
  let %2: f32 = add(%0, %1)
  jump ret(%2)
}

fn fn1(%0: f32, %1: f32) -> (i32) {
  let %2: f32 = add(%0, %1)
  let %3: i32 = ne(%2, %2)
  jump ret(%3)
}

fn fn2(%0: f32, %1: f32) -> (f32) {
  let %2: f32 = sub(%0, %1)
  jump ret(%2)
}

fn fn3(%0: f32, %1: f32) -> (i32) {
  let %2: f32 = sub(%0, %1)
  let %3: i32 = ne(%2, %2)
  jump ret(%3)
}

fn fn4(%0: f32, %1: f32) -> (f32) {
  let %2: f32 = mul(%0, %1)
  jump ret(%2)
}

fn fn5(%0: f32, %1: f32) -> (i32) {
  let %2: f32 = mul(%0, %1)
  let %3: i32 = ne(%2, %2)
  jump ret(%3)
}

fn fn6(%0: f32, %1: f32) -> (f32) {
  let %2: f32 = div.s(%0, %1)
  jump ret(%2)
}

fn fn7(%0: f32, %1: f32) -> (i32) {
  let %2: f32 = div.s(%0, %1)
  let %3: i32 = ne(%2, %2)
  jump ret(%3)
}

fn fn8(%0: f32, %1: f32) -> (f32) {
  let %2: f32 = min(%0, %1)
  jump ret(%2)
}

fn fn9(%0: f32, %1: f32) -> (i32) {
  let %2: f32 = min(%0, %1)
  let %3: i32 = ne(%2, %2)
  jump ret(%3)
}

fn fn10(%0: f32, %1: f32) -> (f32) {
  let %2: f32 = max(%0, %1)
  jump ret(%2)
}

fn fn11(%0: f32, %1: f32) -> (i32) {
  let %2: f32 = max(%0, %1)
  let %3: i32 = ne(%2, %2)
  jump ret(%3)
}

fn fn12(%0: f32, %1: f32) -> (i32) {
  let %2: i32 = eq(%0, %1)
  jump ret(%2)
}

fn fn13(%0: f32, %1: f32) -> (i32) {
  let %2: i32 = ne(%0, %1)
  jump ret(%2)
}

fn fn14(%0: f32, %1: f32) -> (i32) {
  let %2: i32 = lt.s(%0, %1)
  jump ret(%2)
}

fn fn15(%0: f32, %1: f32) -> (i32) {
  let %2: i32 = le.s(%0, %1)
  jump ret(%2)
}

fn fn16(%0: f32, %1: f32) -> (i32) {
  let %2: i32 = gt.s(%0, %1)
  jump ret(%2)
}

fn fn17(%0: f32, %1: f32) -> (i32) {
  let %2: i32 = ge.s(%0, %1)
  jump ret(%2)
}

fn fn18(%0: f32) -> (f32) {
  let %1: f32 = neg(%0)
  jump ret(%1)
}

fn fn19(%0: f32) -> (f32) {
  let %1: f32 = abs(%0)
  jump ret(%1)
}

fn fn20(%0: f32) -> (f32) {
  let %1: f32 = sqrt(%0)
  jump ret(%1)
}

fn fn21(%0: f32) -> (i32) {
  let %1: f32 = sqrt(%0)
  let %2: i32 = ne(%1, %1)
  jump ret(%2)
}

