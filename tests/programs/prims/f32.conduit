// Every f32 operation on edge cases: signed zeros, infinities,
// overflow and NaN. A NaN result is checked with `ne(r, r)`, since
// Wasm doesn't fix a NaN's sign or payload. Generated, with results
// following Wasm.

fn add(%x: f32, %y: f32) -> (f32) {
  let %r: f32 = add(%x, %y)
  jump ret(%r)
}

fn add_is_nan(%x: f32, %y: f32) -> (i32) {
  let %r: f32 = add(%x, %y)
  let %nan: i32 = ne(%r, %r)
  jump ret(%nan)
}

fn sub(%x: f32, %y: f32) -> (f32) {
  let %r: f32 = sub(%x, %y)
  jump ret(%r)
}

fn sub_is_nan(%x: f32, %y: f32) -> (i32) {
  let %r: f32 = sub(%x, %y)
  let %nan: i32 = ne(%r, %r)
  jump ret(%nan)
}

fn mul(%x: f32, %y: f32) -> (f32) {
  let %r: f32 = mul(%x, %y)
  jump ret(%r)
}

fn mul_is_nan(%x: f32, %y: f32) -> (i32) {
  let %r: f32 = mul(%x, %y)
  let %nan: i32 = ne(%r, %r)
  jump ret(%nan)
}

fn div_s(%x: f32, %y: f32) -> (f32) {
  let %r: f32 = div.s(%x, %y)
  jump ret(%r)
}

fn div_s_is_nan(%x: f32, %y: f32) -> (i32) {
  let %r: f32 = div.s(%x, %y)
  let %nan: i32 = ne(%r, %r)
  jump ret(%nan)
}

fn min(%x: f32, %y: f32) -> (f32) {
  let %r: f32 = min(%x, %y)
  jump ret(%r)
}

fn min_is_nan(%x: f32, %y: f32) -> (i32) {
  let %r: f32 = min(%x, %y)
  let %nan: i32 = ne(%r, %r)
  jump ret(%nan)
}

fn max(%x: f32, %y: f32) -> (f32) {
  let %r: f32 = max(%x, %y)
  jump ret(%r)
}

fn max_is_nan(%x: f32, %y: f32) -> (i32) {
  let %r: f32 = max(%x, %y)
  let %nan: i32 = ne(%r, %r)
  jump ret(%nan)
}

fn eq(%x: f32, %y: f32) -> (i32) {
  let %r: i32 = eq(%x, %y)
  jump ret(%r)
}

fn ne(%x: f32, %y: f32) -> (i32) {
  let %r: i32 = ne(%x, %y)
  jump ret(%r)
}

fn lt_s(%x: f32, %y: f32) -> (i32) {
  let %r: i32 = lt.s(%x, %y)
  jump ret(%r)
}

fn le_s(%x: f32, %y: f32) -> (i32) {
  let %r: i32 = le.s(%x, %y)
  jump ret(%r)
}

fn gt_s(%x: f32, %y: f32) -> (i32) {
  let %r: i32 = gt.s(%x, %y)
  jump ret(%r)
}

fn ge_s(%x: f32, %y: f32) -> (i32) {
  let %r: i32 = ge.s(%x, %y)
  jump ret(%r)
}

fn neg(%x: f32) -> (f32) {
  let %r: f32 = neg(%x)
  jump ret(%r)
}

fn abs(%x: f32) -> (f32) {
  let %r: f32 = abs(%x)
  jump ret(%r)
}

fn sqrt(%x: f32) -> (f32) {
  let %r: f32 = sqrt(%x)
  jump ret(%r)
}

fn sqrt_is_nan(%x: f32) -> (i32) {
  let %r: f32 = sqrt(%x)
  let %nan: i32 = ne(%r, %r)
  jump ret(%nan)
}

