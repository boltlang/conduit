// Every i8 operation on edge cases: wrapping, signed and unsigned
// views, division by zero, which gives 0, and its remainder, which
// gives the dividend, the overflow of signed division, which traps, and
// shift amounts taken modulo the width.
// Each operand is first added to the smallest value twice, which
// gives it back but leaves the high bits of its Wasm i32 set.
// Generated, with results following the same rules as i32.

fn add(%x: i8, %y: i8) -> (i8) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i8 = add(%x2, %y2)
  jump ret(%r)
}

fn sub(%x: i8, %y: i8) -> (i8) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i8 = sub(%x2, %y2)
  jump ret(%r)
}

fn mul(%x: i8, %y: i8) -> (i8) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i8 = mul(%x2, %y2)
  jump ret(%r)
}

fn div_s(%x: i8, %y: i8) -> (i8) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i8 = div.s(%x2, %y2)
  jump ret(%r)
}

fn div_u(%x: i8, %y: i8) -> (i8) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i8 = div.u(%x2, %y2)
  jump ret(%r)
}

fn rem_s(%x: i8, %y: i8) -> (i8) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i8 = rem.s(%x2, %y2)
  jump ret(%r)
}

fn rem_u(%x: i8, %y: i8) -> (i8) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i8 = rem.u(%x2, %y2)
  jump ret(%r)
}

fn bitand(%x: i8, %y: i8) -> (i8) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i8 = and(%x2, %y2)
  jump ret(%r)
}

fn bitor(%x: i8, %y: i8) -> (i8) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i8 = or(%x2, %y2)
  jump ret(%r)
}

fn bitxor(%x: i8, %y: i8) -> (i8) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i8 = xor(%x2, %y2)
  jump ret(%r)
}

fn shl(%x: i8, %y: i8) -> (i8) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i8 = shl(%x2, %y2)
  jump ret(%r)
}

fn shr_s(%x: i8, %y: i8) -> (i8) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i8 = shr.s(%x2, %y2)
  jump ret(%r)
}

fn shr_u(%x: i8, %y: i8) -> (i8) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i8 = shr.u(%x2, %y2)
  jump ret(%r)
}

fn eq(%x: i8, %y: i8) -> (i32) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i32 = eq(%x2, %y2)
  jump ret(%r)
}

fn ne(%x: i8, %y: i8) -> (i32) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i32 = ne(%x2, %y2)
  jump ret(%r)
}

fn lt_s(%x: i8, %y: i8) -> (i32) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i32 = lt.s(%x2, %y2)
  jump ret(%r)
}

fn lt_u(%x: i8, %y: i8) -> (i32) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i32 = lt.u(%x2, %y2)
  jump ret(%r)
}

fn le_s(%x: i8, %y: i8) -> (i32) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i32 = le.s(%x2, %y2)
  jump ret(%r)
}

fn le_u(%x: i8, %y: i8) -> (i32) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i32 = le.u(%x2, %y2)
  jump ret(%r)
}

fn gt_s(%x: i8, %y: i8) -> (i32) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i32 = gt.s(%x2, %y2)
  jump ret(%r)
}

fn gt_u(%x: i8, %y: i8) -> (i32) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i32 = gt.u(%x2, %y2)
  jump ret(%r)
}

fn ge_s(%x: i8, %y: i8) -> (i32) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i32 = ge.s(%x2, %y2)
  jump ret(%r)
}

fn ge_u(%x: i8, %y: i8) -> (i32) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %y1: i8 = add(%y, -128i8)
  let %y2: i8 = add(%y1, -128i8)
  let %r: i32 = ge.u(%x2, %y2)
  jump ret(%r)
}

fn neg(%x: i8) -> (i8) {
  let %x1: i8 = add(%x, -128i8)
  let %x2: i8 = add(%x1, -128i8)
  let %r: i8 = neg(%x2)
  jump ret(%r)
}

