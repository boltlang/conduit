// Converting a float to an integer traps when the float is NaN or out of
// the integer's range, after truncating toward zero.

fn fn0(%0: f64) -> (i32) {
  let %1: i32 = convert.s[i32](%0)
  jump ret(%1)
}

fn fn1(%0: f64) -> (i32) {
  let %1: i32 = convert.u[i32](%0)
  jump ret(%1)
}

fn fn2(%0: f32) -> (i64) {
  let %1: i64 = convert.s[i64](%0)
  jump ret(%1)
}

fn fn3(%0: f32) -> (i64) {
  let %1: i64 = convert.u[i64](%0)
  jump ret(%1)
}

//# run fn0(2147483648.0f64) traps
//# run fn0(-2147483649.0f64) traps
//# run fn0(f64_bits(9221120237041090560)) traps
//# run fn0(f64_bits(9218868437227405312)) traps
//# run fn1(-1.0f64) traps
//# run fn1(-0.9f64) == 0i32
//# run fn1(4294967296.0f64) traps
//# run fn2(9223372036854775807.0f32) traps
//# run fn2(-9223372036854775808.0f32) == -9223372036854775808i64
//# run fn3(-1.0f32) traps
//# run fn3(f32_bits(2139095040)) traps
