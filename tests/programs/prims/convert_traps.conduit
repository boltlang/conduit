// Converting a float to an integer traps when the float is NaN or out of
// the integer's range, after truncating toward zero.

fn f64_to_i32_s(%x: f64) -> (i32) {
  let %r: i32 = convert.s[i32](%x)
  jump ret(%r)
}

fn f64_to_i32_u(%x: f64) -> (i32) {
  let %r: i32 = convert.u[i32](%x)
  jump ret(%r)
}

fn f32_to_i64_s(%x: f32) -> (i64) {
  let %r: i64 = convert.s[i64](%x)
  jump ret(%r)
}

fn f32_to_i64_u(%x: f32) -> (i64) {
  let %r: i64 = convert.u[i64](%x)
  jump ret(%r)
}

//# run f64_to_i32_s(2147483648.0f64) traps
//# run f64_to_i32_s(-2147483649.0f64) traps
//# run f64_to_i32_s(f64_bits(9221120237041090560)) traps
//# run f64_to_i32_s(f64_bits(9218868437227405312)) traps
//# run f64_to_i32_u(-1.0f64) traps
//# run f64_to_i32_u(-0.9f64) == 0i32
//# run f64_to_i32_u(4294967296.0f64) traps
//# run f32_to_i64_s(9223372036854775807.0f32) traps
//# run f32_to_i64_s(-9223372036854775808.0f32) == -9223372036854775808i64
//# run f32_to_i64_u(-1.0f32) traps
//# run f32_to_i64_u(f32_bits(2139095040)) traps
