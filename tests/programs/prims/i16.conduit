// Every i16 operation on edge cases: wrapping, signed and unsigned
// views, division by zero, which gives 0, and its remainder, which
// gives the dividend, the overflow of signed division, which traps, and
// shift amounts taken modulo the width.
// Each operand is first added to the smallest value twice, which
// gives it back but leaves the high bits of its Wasm i32 set.
// Generated, with results following the same rules as i32.

fn add(%x: i16, %y: i16) -> (i16) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i16 = add(%x2, %y2)
  jump ret(%r)
}

fn sub(%x: i16, %y: i16) -> (i16) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i16 = sub(%x2, %y2)
  jump ret(%r)
}

fn mul(%x: i16, %y: i16) -> (i16) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i16 = mul(%x2, %y2)
  jump ret(%r)
}

fn div_s(%x: i16, %y: i16) -> (i16) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i16 = div.s(%x2, %y2)
  jump ret(%r)
}

fn div_u(%x: i16, %y: i16) -> (i16) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i16 = div.u(%x2, %y2)
  jump ret(%r)
}

fn rem_s(%x: i16, %y: i16) -> (i16) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i16 = rem.s(%x2, %y2)
  jump ret(%r)
}

fn rem_u(%x: i16, %y: i16) -> (i16) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i16 = rem.u(%x2, %y2)
  jump ret(%r)
}

fn bitand(%x: i16, %y: i16) -> (i16) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i16 = and(%x2, %y2)
  jump ret(%r)
}

fn bitor(%x: i16, %y: i16) -> (i16) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i16 = or(%x2, %y2)
  jump ret(%r)
}

fn bitxor(%x: i16, %y: i16) -> (i16) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i16 = xor(%x2, %y2)
  jump ret(%r)
}

fn shl(%x: i16, %y: i16) -> (i16) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i16 = shl(%x2, %y2)
  jump ret(%r)
}

fn shr_s(%x: i16, %y: i16) -> (i16) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i16 = shr.s(%x2, %y2)
  jump ret(%r)
}

fn shr_u(%x: i16, %y: i16) -> (i16) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i16 = shr.u(%x2, %y2)
  jump ret(%r)
}

fn eq(%x: i16, %y: i16) -> (i32) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i32 = eq(%x2, %y2)
  jump ret(%r)
}

fn ne(%x: i16, %y: i16) -> (i32) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i32 = ne(%x2, %y2)
  jump ret(%r)
}

fn lt_s(%x: i16, %y: i16) -> (i32) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i32 = lt.s(%x2, %y2)
  jump ret(%r)
}

fn lt_u(%x: i16, %y: i16) -> (i32) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i32 = lt.u(%x2, %y2)
  jump ret(%r)
}

fn le_s(%x: i16, %y: i16) -> (i32) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i32 = le.s(%x2, %y2)
  jump ret(%r)
}

fn le_u(%x: i16, %y: i16) -> (i32) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i32 = le.u(%x2, %y2)
