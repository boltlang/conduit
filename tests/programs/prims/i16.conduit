}

fn gt_s(%x: i16, %y: i16) -> (i32) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i32 = gt.s(%x2, %y2)
  jump ret(%r)
}

fn gt_u(%x: i16, %y: i16) -> (i32) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i32 = gt.u(%x2, %y2)
  jump ret(%r)
}

fn ge_s(%x: i16, %y: i16) -> (i32) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i32 = ge.s(%x2, %y2)
  jump ret(%r)
}

fn ge_u(%x: i16, %y: i16) -> (i32) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %y1: i16 = add(%y, -32768i16)
  let %y2: i16 = add(%y1, -32768i16)
  let %r: i32 = ge.u(%x2, %y2)
  jump ret(%r)
}

fn neg(%x: i16) -> (i16) {
  let %x1: i16 = add(%x, -32768i16)
  let %x2: i16 = add(%x1, -32768i16)
  let %r: i16 = neg(%x2)
  jump ret(%r)
}

