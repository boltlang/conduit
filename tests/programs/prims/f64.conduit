// Every f64 operation on edge cases: signed zeros, infinities,
// overflow and NaN. A NaN result is checked with `ne(r, r)`, since
// Wasm doesn't fix a NaN's sign or payload. Generated, with results
// following Wasm.

fn add(%x: f64, %y: f64) -> (f64) {
  let %r: f64 = add(%x, %y)
  jump ret(%r)
}

fn add_is_nan(%x: f64, %y: f64) -> (i32) {
  let %r: f64 = add(%x, %y)
  let %nan: i32 = ne(%r, %r)
  jump ret(%nan)
}

fn sub(%x: f64, %y: f64) -> (f64) {
  let %r: f64 = sub(%x, %y)
  jump ret(%r)
}

fn sub_is_nan(%x: f64, %y: f64) -> (i32) {
  let %r: f64 = sub(%x, %y)
  let %nan: i32 = ne(%r, %r)
  jump ret(%nan)
}

fn mul(%x: f64, %y: f64) -> (f64) {
  let %r: f64 = mul(%x, %y)
  jump ret(%r)
}

fn mul_is_nan(%x: f64, %y: f64) -> (i32) {
  let %r: f64 = mul(%x, %y)
  let %nan: i32 = ne(%r, %r)
  jump ret(%nan)
}

fn div_s(%x: f64, %y: f64) -> (f64) {
  let %r: f64 = div.s(%x, %y)
  jump ret(%r)
}

fn div_s_is_nan(%x: f64, %y: f64) -> (i32) {
  let %r: f64 = div.s(%x, %y)
  let %nan: i32 = ne(%r, %r)
  jump ret(%nan)
}

fn min(%x: f64, %y: f64) -> (f64) {
  let %r: f64 = min(%x, %y)
  jump ret(%r)
}

fn min_is_nan(%x: f64, %y: f64) -> (i32) {
  let %r: f64 = min(%x, %y)
  let %nan: i32 = ne(%r, %r)
  jump ret(%nan)
}

fn max(%x: f64, %y: f64) -> (f64) {
  let %r: f64 = max(%x, %y)
  jump ret(%r)
}

fn max_is_nan(%x: f64, %y: f64) -> (i32) {
  let %r: f64 = max(%x, %y)
  let %nan: i32 = ne(%r, %r)
  jump ret(%nan)
}

fn eq(%x: f64, %y: f64) -> (i32) {
  let %r: i32 = eq(%x, %y)
  jump ret(%r)
}

fn ne(%x: f64, %y: f64) -> (i32) {
  let %r: i32 = ne(%x, %y)
  jump ret(%r)
}

fn lt_s(%x: f64, %y: f64) -> (i32) {
  let %r: i32 = lt.s(%x, %y)
  jump ret(%r)
}

fn le_s(%x: f64, %y: f64) -> (i32) {
  let %r: i32 = le.s(%x, %y)
  jump ret(%r)
}

fn gt_s(%x: f64, %y: f64) -> (i32) {
  let %r: i32 = gt.s(%x, %y)
  jump ret(%r)
}

fn ge_s(%x: f64, %y: f64) -> (i32) {
  let %r: i32 = ge.s(%x, %y)
  jump ret(%r)
}

fn neg(%x: f64) -> (f64) {
  let %r: f64 = neg(%x)
  jump ret(%r)
}

fn abs(%x: f64) -> (f64) {
  let %r: f64 = abs(%x)
  jump ret(%r)
}

fn sqrt(%x: f64) -> (f64) {
  let %r: f64 = sqrt(%x)
  jump ret(%r)
}

fn sqrt_is_nan(%x: f64) -> (i32) {
  let %r: f64 = sqrt(%x)
  let %nan: i32 = ne(%r, %r)
  jump ret(%nan)
}

