// Every i32 operation on edge cases: wrapping, signed and unsigned
// views, division by zero, which gives 0, and its remainder, which
// gives the dividend, the overflow of signed division, which traps, and
// shift amounts taken modulo the width.
// Generated, with results following Wasm.

fn add(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = add(%x, %y)
  jump ret(%r)
}

fn sub(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = sub(%x, %y)
  jump ret(%r)
}

fn mul(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = mul(%x, %y)
  jump ret(%r)
}

fn div_s(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = div.s(%x, %y)
  jump ret(%r)
}

fn div_u(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = div.u(%x, %y)
  jump ret(%r)
}

fn rem_s(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = rem.s(%x, %y)
  jump ret(%r)
}

fn rem_u(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = rem.u(%x, %y)
  jump ret(%r)
}

fn bitand(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = and(%x, %y)
  jump ret(%r)
}

fn bitor(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = or(%x, %y)
  jump ret(%r)
}

fn bitxor(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = xor(%x, %y)
  jump ret(%r)
}

fn shl(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = shl(%x, %y)
  jump ret(%r)
}

fn shr_s(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = shr.s(%x, %y)
  jump ret(%r)
}

fn shr_u(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = shr.u(%x, %y)
  jump ret(%r)
}

fn eq(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = eq(%x, %y)
  jump ret(%r)
}

fn ne(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = ne(%x, %y)
  jump ret(%r)
}

fn lt_s(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = lt.s(%x, %y)
  jump ret(%r)
}

fn lt_u(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = lt.u(%x, %y)
  jump ret(%r)
}

fn le_s(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = le.s(%x, %y)
  jump ret(%r)
}

fn le_u(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = le.u(%x, %y)
  jump ret(%r)
}

fn gt_s(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = gt.s(%x, %y)
  jump ret(%r)
}

fn gt_u(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = gt.u(%x, %y)
  jump ret(%r)
}

fn ge_s(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = ge.s(%x, %y)
  jump ret(%r)
}

fn ge_u(%x: i32, %y: i32) -> (i32) {
  let %r: i32 = ge.u(%x, %y)
  jump ret(%r)
}

fn neg(%x: i32) -> (i32) {
  let %r: i32 = neg(%x)
  jump ret(%r)
}

