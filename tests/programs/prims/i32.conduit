// Every i32 operation on edge cases: wrapping, signed and unsigned
// views, division traps, and shift amounts taken modulo the width.
// Generated, with results following Wasm.

fn fn0(%0: i32, %1: i32) -> (i32) {
  let %2: i32 = add(%0, %1)
  jump ret(%2)
}

fn fn1(%0: i32, %1: i32) -> (i32) {
  let %2: i32 = sub(%0, %1)
  jump ret(%2)
}

fn fn2(%0: i32, %1: i32) -> (i32) {
