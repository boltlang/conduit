// Every i64 operation on edge cases: wrapping, signed and unsigned
// views, division by zero, which gives 0, and its remainder, which
// gives the dividend, the overflow of signed division, which traps, and
// shift amounts taken modulo the width.
// Generated, with results following Wasm.

fn add(%x: i64, %y: i64) -> (i64) {
  let %r: i64 = add(%x, %y)
  jump ret(%r)
}

fn sub(%x: i64, %y: i64) -> (i64) {
  let %r: i64 = sub(%x, %y)
  jump ret(%r)
}

fn mul(%x: i64, %y: i64) -> (i64) {
  let %r: i64 = mul(%x, %y)
  jump ret(%r)
}

fn div_s(%x: i64, %y: i64) -> (i64) {
  let %r: i64 = div.s(%x, %y)
  jump ret(%r)
}

fn div_u(%x: i64, %y: i64) -> (i64) {
  let %r: i64 = div.u(%x, %y)
  jump ret(%r)
}

fn rem_s(%x: i64, %y: i64) -> (i64) {
  let %r: i64 = rem.s(%x, %y)
  jump ret(%r)
}

fn rem_u(%x: i64, %y: i64) -> (i64) {
  let %r: i64 = rem.u(%x, %y)
  jump ret(%r)
}

fn bitand(%x: i64, %y: i64) -> (i64) {
  let %r: i64 = and(%x, %y)
  jump ret(%r)
}

fn bitor(%x: i64, %y: i64) -> (i64) {
  let %r: i64 = or(%x, %y)
  jump ret(%r)
}

fn bitxor(%x: i64, %y: i64) -> (i64) {
  let %r: i64 = xor(%x, %y)
  jump ret(%r)
}

fn shl(%x: i64, %y: i64) -> (i64) {
  let %r: i64 = shl(%x, %y)
  jump ret(%r)
}

fn shr_s(%x: i64, %y: i64) -> (i64) {
  let %r: i64 = shr.s(%x, %y)
  jump ret(%r)
}

fn shr_u(%x: i64, %y: i64) -> (i64) {
  let %r: i64 = shr.u(%x, %y)
  jump ret(%r)
}

fn eq(%x: i64, %y: i64) -> (i32) {
  let %r: i32 = eq(%x, %y)
  jump ret(%r)
}

fn ne(%x: i64, %y: i64) -> (i32) {
  let %r: i32 = ne(%x, %y)
  jump ret(%r)
}

fn lt_s(%x: i64, %y: i64) -> (i32) {
  let %r: i32 = lt.s(%x, %y)
  jump ret(%r)
}

fn lt_u(%x: i64, %y: i64) -> (i32) {
  let %r: i32 = lt.u(%x, %y)
  jump ret(%r)
}

fn le_s(%x: i64, %y: i64) -> (i32) {
  let %r: i32 = le.s(%x, %y)
  jump ret(%r)
}

fn le_u(%x: i64, %y: i64) -> (i32) {
  let %r: i32 = le.u(%x, %y)
  jump ret(%r)
}

fn gt_s(%x: i64, %y: i64) -> (i32) {
  let %r: i32 = gt.s(%x, %y)
  jump ret(%r)
}

fn gt_u(%x: i64, %y: i64) -> (i32) {
  let %r: i32 = gt.u(%x, %y)
  jump ret(%r)
}

fn ge_s(%x: i64, %y: i64) -> (i32) {
  let %r: i32 = ge.s(%x, %y)
  jump ret(%r)
}

fn ge_u(%x: i64, %y: i64) -> (i32) {
  let %r: i32 = ge.u(%x, %y)
  jump ret(%r)
}

fn neg(%x: i64) -> (i64) {
  let %r: i64 = neg(%x)
  jump ret(%r)
}

