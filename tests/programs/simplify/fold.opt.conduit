fn constants() -> (i32) vars(%wrapped: i32, %wrapped_i8: i8, %widened: i32, %lt_u: i32, %q: i32, %a: i32, %b: i32, %c: i32) {
  jump ret(-2147483607i32)
}

fn overflow() -> (i32) {
  let %q: i32 = div.s(-2147483648i32, -1i32)
  jump ret(%q)
}

fn by_zero() -> (i32) vars(%q: i32, %r: i32, %sum: i32) {
  jump ret(-7i32)
}

fn out_of_range() -> (i32) {
  let %x: i32 = convert.s[i32](10000000000.0f64)
  jump ret(%x)
}

fn nan() -> (i32) {
  let %nan: f64 = div.s(0.0f64, 0.0f64)
  let %same: i32 = eq(%nan, %nan)
  jump ret(%same)
}

fn floats() -> (f64) vars(%p: f64, %size#2: f64) {
  let %root: f64 = sqrt(-3.0f64)
  jump ret(3.0f64)
}
