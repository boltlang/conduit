// The example of #19: once `fn1` is inlined with a literal, its
// comparison folds and its `case` takes the first arm.

fn fn0(%0: i32) -> (i32) {
  let %1: i32 = call fn1(3i32, %0)
  jump ret(%1)
}

fn fn1(%0: i32, %1: i32) -> (i32) {
  let %2: i32 = lt.s(%0, 10i32)
  case %2 {
    1 => jump ret(%1)
    _ => jump ret(0i32)
  }
}

//# run fn0(8i32) == 8i32
//# opt
