// The example of #19: once `below10` is inlined with a literal, its
// comparison folds and its `case` takes the first arm.

fn main(%x: i32) -> (i32) {
  let %r: i32 = call below10(3i32, %x)
  jump ret(%r)
}

fn below10(%n: i32, %x: i32) -> (i32) {
  let %small: i32 = lt.s(%n, 10i32)
  case %small {
    1 => jump ret(%x)
    _ => jump ret(0i32)
  }
}

//# run main(8i32) == 8i32
//# opt
