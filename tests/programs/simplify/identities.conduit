// Integer ops with a literal that leaves the other argument as it is, or
// that give a literal whatever the other argument is. `add(x, 0.0)` stays,
// since it isn't `x` when `x` is `-0.0`.

fn ints(%x: i32) -> (i32) {
  let %a: i32 = add(%x, 0i32)
  let %b: i32 = mul(1i32, %a)
  let %c: i32 = and(%b, -1i32)
  let %d: i32 = shl(%c, 0i32)
  let %e: i32 = sub(%d, 0i32)
  jump ret(%e)
}

fn zeros(%x: i64) -> (i64) {
  let %a: i64 = mul(%x, 0i64)
  let %b: i64 = and(0i64, %x)
  let %c: i64 = add(%a, %b)
  jump ret(%c)
}

fn plus_zero(%x: f64) -> (f64) {
  let %y: f64 = add(%x, 0.0f64)
  jump ret(%y)
}

// `sub(0, x)` isn't `x`.
fn negate(%x: i8) -> (i8) {
  let %y: i8 = sub(0i8, %x)
  jump ret(%y)
}

//# run ints(7i32) == 7i32
//# run zeros(7i64) == 0i64
//# run plus_zero(-0.0f64) == 0.0f64
//# run negate(5i8) == -5i8
//# opt: simplify
