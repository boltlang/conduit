// Integer ops with a literal that leaves the other argument as it is, or
// that give a literal whatever the other argument is. `add(x, 0.0)` stays,
// since it isn't `x` when `x` is `-0.0`.

fn fn0(%0: i32) -> (i32) {
  let %1: i32 = add(%0, 0i32)
  let %2: i32 = mul(1i32, %1)
  let %3: i32 = and(%2, -1i32)
  let %4: i32 = shl(%3, 0i32)
  let %5: i32 = sub(%4, 0i32)
  jump ret(%5)
}

fn fn1(%0: i64) -> (i64) {
  let %1: i64 = mul(%0, 0i64)
  let %2: i64 = and(0i64, %0)
  let %3: i64 = add(%1, %2)
  jump ret(%3)
}

fn fn2(%0: f64) -> (f64) {
  let %1: f64 = add(%0, 0.0f64)
  jump ret(%1)
}

// `sub(0, x)` isn't `x`.
fn fn3(%0: i8) -> (i8) {
  let %1: i8 = sub(0i8, %0)
  jump ret(%1)
}

//# run fn0(7i32) == 7i32
//# run fn1(7i64) == 0i64
//# run fn2(-0.0f64) == 0.0f64
//# run fn3(5i8) == -5i8
//# opt: simplify
