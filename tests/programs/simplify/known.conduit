// A `case` on a literal or on an object made here takes its arm, and a
// field of an `imm` object made here is the `new`'s argument. A `mut`
// object's constructor is known too, but not its fields, which `set` may
// change.

data data0 {
  ()
  (i32, i32)
}

fn fn0(%0: i32) -> (i32) {
  let %1: imm data0 = new data0.1(%0, 5i32)
  case %1 {
    data0.0 => jump ret(0i32)
    data0.1 =>
      let %2: i32 = get data0.1.0(%1)
      let %3: i32 = get data0.1.1(%1)
      let %4: i32 = add(%2, %3)
      jump ret(%4)
  }
}

fn fn1(%0: i32) -> (i32) {
  let %1: mut data0 = new data0.1(%0, 5i32)
  let = set data0.1.0(%1, 9i32)
  case %1 {
    data0.0 => jump ret(0i32)
    data0.1 =>
      let %2: i32 = get data0.1.0(%1)
      jump ret(%2)
  }
}

// A literal takes its arm or the default, and the arm it takes can end in
// another `case` that's known too.
fn fn2(%0: i32) -> (i32) {
  let %1: i32 = add(1i32, 2i32)
  case %1 {
    0 => jump ret(0i32)
    3 =>
      let %2: i32 = mul(%1, 2i32)
      case %2 {
        1 => jump ret(1i32)
        _ => jump ret(%0)
      }
    _ => jump ret(2i32)
  }
}

// A constructor no arm names takes the default.
fn fn3() -> (i32) {
  let %0: imm data0 = new data0.0()
  case %0 {
    data0.1 => jump ret(1i32)
    _ => jump ret(2i32)
  }
}

// What comes into a join point isn't known.
fn fn4(%0: i32) -> (i32) {
  join j1(%1: imm data0) =
    case %1 {
      data0.0 => jump ret(0i32)
      _ => jump ret(1i32)
    }
  in
  let %2: imm data0 = new data0.0()
  jump j1(%2)
}

//# run fn0(4i32) == 9i32
//# run fn1(4i32) == 9i32
//# run fn2(7i32) == 7i32
//# run fn3() == 2i32
//# run fn4(0i32) == 0i32
//# opt: simplify
