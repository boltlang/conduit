// A `case` on a literal or on an object made here takes its arm, and a
// field of an `imm` object made here is the `new`'s argument. A `mut`
// object's constructor is known too, but not its fields, which `set` may
// change.

data Pair {
  ()
  (i32, i32)
}

fn imm_fields(%x: i32) -> (i32) {
  let %pair: imm Pair = new Pair.1(%x, 5i32)
  case %pair {
    Pair.0 => jump ret(0i32)
    Pair.1 =>
      let %a: i32 = get Pair.1.0(%pair)
      let %b: i32 = get Pair.1.1(%pair)
      let %sum: i32 = add(%a, %b)
      jump ret(%sum)
  }
}

fn mut_fields(%x: i32) -> (i32) {
  let %pair: mut Pair = new Pair.1(%x, 5i32)
  let = set Pair.1.0(%pair, 9i32)
  case %pair {
    Pair.0 => jump ret(0i32)
    Pair.1 =>
      let %a: i32 = get Pair.1.0(%pair)
      jump ret(%a)
  }
}

// A literal takes its arm or the default, and the arm it takes can end in
// another `case` that's known too.
fn literals(%x: i32) -> (i32) {
  let %three: i32 = add(1i32, 2i32)
  case %three {
    0 => jump ret(0i32)
    3 =>
      let %six: i32 = mul(%three, 2i32)
      case %six {
        1 => jump ret(1i32)
        _ => jump ret(%x)
      }
    _ => jump ret(2i32)
  }
}

// A constructor no arm names takes the default.
fn default() -> (i32) {
  let %empty: imm Pair = new Pair.0()
  case %empty {
    Pair.1 => jump ret(1i32)
    _ => jump ret(2i32)
  }
}

// What comes into a join point isn't known.
fn through_join(%x: i32) -> (i32) {
  join check(%p: imm Pair) =
    case %p {
      Pair.0 => jump ret(0i32)
      _ => jump ret(1i32)
    }
  in
  let %empty: imm Pair = new Pair.0()
  jump check(%empty)
}

//# run imm_fields(4i32) == 9i32
//# run mut_fields(4i32) == 9i32
//# run literals(7i32) == 7i32
//# run default() == 2i32
//# run through_join(0i32) == 0i32
//# opt: simplify
