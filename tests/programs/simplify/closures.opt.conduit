  jump ret(%2)
}

fn fn1(%0: i32) -> (i32) {
  let %1: imm fn(i32) -> (i32) = closure fn0(3i32)
  let %2: i32 = call fn0(3i32, %0)
  let %3: i32 = call fn0(3i32, %2)
