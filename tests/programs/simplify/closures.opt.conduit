fn fn2(%0: i32) -> (i32) {
  join j1(%1: imm fn(i32) -> (i32)) =
    let %2: i32 = apply(%1, %0)
    jump ret(%2)
  in
  let %3: imm fn(i32) -> (i32) = closure fn0(%0)
  jump j1(%3)
}

fn fn3['m1](%0: 'm1 [i32], %1: i32) -> (i32) {
  let %2: i32 = array_get(%0, %1)
  jump ret(%2)
}

fn fn4(%0: i32) -> (i32) {
  let %1: mut [i32] = array_fill(3i32, %0)
  let %2: mut fn(i32) -> (i32) = closure fn3[mut](%1)
  let %3: i32 = call fn3[mut](%1, 1i32)
  jump ret(%3)
}

