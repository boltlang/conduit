fn ints(%x: i32) -> (i32) vars(%a: i32, %b: i32, %c: i32, %d: i32, %e: i32) {
  jump ret(%x)
}

fn zeros(%x: i64) -> (i64) vars(%a: i64, %b: i64, %c: i64) {
  jump ret(0i64)
}

fn plus_zero(%x: f64) -> (f64) {
  let %y: f64 = add(%x, 0.0f64)
  jump ret(%y)
}

fn negate(%x: i8) -> (i8) {
  let %y: i8 = sub(0i8, %x)
  jump ret(%y)
}
