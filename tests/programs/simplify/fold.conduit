// Ops on literals fold to what they give: wrapping, i8 kept to 8 bits,
// comparisons, conversions, and a division that can't trap. A division
// by zero, a float conversion out of range and a NaN stay.

fn fn0() -> (i32) {
  let %0: i32 = add(2147483647i32, 1i32)
  let %1: i8 = mul(100i8, 3i8)
  let %2: i32 = convert.s[i32](%1)
  let %3: i32 = lt.u(-1i32, 0i32)
  let %4: i32 = div.s(-7i32, 2i32)
  let %5: i32 = add(%0, %2)
  let %6: i32 = add(%5, %3)
  let %7: i32 = add(%6, %4)
  jump ret(%7)
}

fn fn1() -> (i32) {
  let %0: i32 = div.s(1i32, 0i32)
  jump ret(%0)
}

fn fn2() -> (i32) {
  let %0: i32 = convert.s[i32](1e10f64)
  jump ret(%0)
}

// 0.0 / 0.0 is a NaN, whose bits Wasm doesn't fix: it stays, and so does
// the comparison on it.
fn fn3() -> (i32) {
  let %0: f64 = div.s(0.0f64, 0.0f64)
  let %1: i32 = eq(%0, %0)
  jump ret(%1)
}

// Float ops that don't give a NaN fold, but `sqrt(-3.0)` is one, so it
// stays.
fn fn4() -> (f64) {
  let %0: f64 = mul(1.5f64, -2.0f64)
  let %1: f64 = sqrt(%0)
  let %2: f64 = abs(%0)
  jump ret(%2)
}

//# run fn0() == -2147483607i32
//# run fn1() traps
//# run fn2() traps
//# run fn3() == 0i32
//# run fn4() == 3.0f64
//# opt: simplify
