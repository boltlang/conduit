data Pair {
  ()
  (i32, i32)
}

fn imm_fields(%x: i32) -> (i32) vars(%a#2: i32, %b#3: i32) {
  let %pair: imm Pair = new Pair.1(%x, 5i32)
  let %sum: i32 = add(%x, 5i32)
  jump ret(%sum)
}

fn mut_fields(%x: i32) -> (i32) {
  let %pair: mut Pair = new Pair.1(%x, 5i32)
  let = set Pair.1.0(%pair, 9i32)
  let %a: i32 = get Pair.1.0(%pair)
  jump ret(%a)
}

fn literals(%x: i32) -> (i32) vars(%three: i32, %six: i32) {
  jump ret(%x)
}

fn default() -> (i32) {
  let %empty: imm Pair = new Pair.0()
  jump ret(2i32)
}

fn through_join(%x: i32) -> (i32) {
  join check(%p: imm Pair) =
    case %p {
      Pair.0 => jump ret(0i32)
      _ => jump ret(1i32)
    }
  in
  let %empty: imm Pair = new Pair.0()
  jump check(%empty)
}
