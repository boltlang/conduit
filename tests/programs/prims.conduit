// -(i32(f64(x) * 2.5))
fn fn0(%0: i32) -> (i32) {
  let %1: f64 = convert.s[f64](%0)
  let %2: f64 = mul(%1, 2.5f64)
  let %3: i32 = convert.s[i32](%2)
  let %4: i32 = neg(%3)
  jump ret(%4)
}

fn fn1(%0: i32) -> (i32) {
  let %1: i32 = lt.u(%0, 1i32)
  jump ret(%1)
}

fn fn2(%0: i32, %1: i32) -> (i32) {
  let %2: i32 = div.s(%0, %1)
  jump ret(%2)
}

//# run fn0(4i32) == -10i32
//# run fn1(0i32) == 1i32
//# run fn1(-1i32) == 0i32
//# run fn2(7i32, 2i32) == 3i32
//# run fn2(7i32, 0i32) traps
