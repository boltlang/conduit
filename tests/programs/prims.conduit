// -(i32(f64(x) * 2.5))
fn neg_scaled(%x: i32) -> (i32) {
  let %f: f64 = convert.s[f64](%x)
  let %g: f64 = mul(%f, 2.5f64)
  let %y: i32 = convert.s[i32](%g)
  let %r: i32 = neg(%y)
  jump ret(%r)
}

fn is_zero(%x: i32) -> (i32) {
  let %r: i32 = lt.u(%x, 1i32)
  jump ret(%r)
}

fn quotient(%x: i32, %y: i32) -> (i32) {
  let %q: i32 = div.s(%x, %y)
  jump ret(%q)
}

//# run neg_scaled(4i32) == -10i32
//# run is_zero(0i32) == 1i32
//# run is_zero(-1i32) == 0i32
//# run quotient(7i32, 2i32) == 3i32
//# run quotient(7i32, 0i32) == 0i32
//# run quotient(-2147483648i32, -1i32) traps
