// after joins

data Pair {
  ()
  (i32, i32)
}

const origin: imm Pair = Pair.1(0i32, 0i32)

#[export(emu)]
fn once(%x: i32) -> (i32) {
  let %x1: i32 = add(%x, 1i32)
  let %z: i32 = mul(%x1, 2i32)
  jump ret(%z)
}

#[export(emu)]
fn literals(%c: i32) -> (i32) {
  join pick(%n: i32) =
    case %n {
      0 => jump ret(10i32)
      _ =>
        let %m#2: i32 = mul(%n, %c)
        jump ret(%m#2)
    }
  in
  case %c {
    0 =>
      case 0i32 {
        0 => jump ret(10i32)
        _ =>
          let %m#3: i32 = mul(0i32, %c)
          jump ret(%m#3)
      }
    _ =>
      case 3i32 {
        0 => jump ret(10i32)
        _ =>
          let %m#4: i32 = mul(3i32, %c)
          jump ret(%m#4)
      }
  }
}

fn objects(%c: i32, %p: imm Pair) -> (i32) {
  case %c {
    0 =>
      let %made: imm Pair = new Pair.1(5i32, 6i32)
      case %made {
        Pair.0 => jump ret(-1i32)
        Pair.1 =>
          let %a#3: i32 = get Pair.1.0(%made)
          jump ret(%a#3)
      }
    1 =>
      let %o: imm Pair = const origin()
      case %o {
        Pair.0 => jump ret(-1i32)
        Pair.1 =>
          let %a#5: i32 = get Pair.1.0(%o)
          jump ret(%a#5)
      }
    _ =>
      case %p {
        Pair.0 => jump ret(-1i32)
        Pair.1 =>
          let %a#6: i32 = get Pair.1.0(%p)
          jump ret(%a#6)
      }
  }
}

#[export(emu)]
fn sum_to(%n: i32) -> (i32) {
  join rec go(%i: i32, %acc: i32) =
    case %i {
      0 => jump ret(%acc)
      _ =>
        let %acc1: i32 = add(%acc, %i)
        let %i1: i32 = sub(%i, 1i32)
        jump go(%i1, %acc1)
    }
  in jump go(%n, 0i32)
}

#[export(emu)]
fn moved_copy(%c: i32) -> (i32) {
  let %c1: i32 = add(%c, 100i32)
  join inner(%n: i32) =
    case %n {
      0 => jump ret(%c1)
      _ =>
        let %m#3: i32 = add(%n, %c1)
        jump ret(%m#3)
    }
  in
  case %c {
    0 =>
      case 0i32 {
        0 => jump ret(%c1)
        _ =>
          let %m#4: i32 = add(0i32, %c1)
          jump ret(%m#4)
      }
    _ =>
      case 5i32 {
        0 => jump ret(%c1)
        _ =>
          let %m#5: i32 = add(5i32, %c1)
          jump ret(%m#5)
      }
  }
}

#[export(emu)]
fn objects_of(%c: i32) -> (i32) {
  let %p: imm Pair = new Pair.0()
  let %r: i32 = call objects(%c, %p)
  jump ret(%r)
}

// after joins, simplify, dce

data Pair {
  ()
  (i32, i32)
}

const origin: imm Pair = Pair.1(0i32, 0i32)

#[export(emu)]
fn once(%x: i32) -> (i32) {
  let %x1: i32 = add(%x, 1i32)
  let %z: i32 = mul(%x1, 2i32)
  jump ret(%z)
}

#[export(emu)]
fn literals(%c: i32) -> (i32) {
  case %c {
    0 => jump ret(10i32)
    _ =>
      let %m: i32 = mul(3i32, %c)
      jump ret(%m)
  }
}

fn objects(%c: i32, %p: imm Pair) -> (i32) {
  case %c {
    0 => jump ret(5i32)
    1 => jump ret(0i32)
    _ =>
      case %p {
        Pair.0 => jump ret(-1i32)
        Pair.1 =>
          let %a: i32 = get Pair.1.0(%p)
          jump ret(%a)
      }
  }
}

#[export(emu)]
fn sum_to(%n: i32) -> (i32) {
  join rec go(%i: i32, %acc: i32) =
    case %i {
      0 => jump ret(%acc)
      _ =>
        let %acc1: i32 = add(%acc, %i)
        let %i1: i32 = sub(%i, 1i32)
        jump go(%i1, %acc1)
    }
  in jump go(%n, 0i32)
}

#[export(emu)]
fn moved_copy(%c: i32) -> (i32) {
  let %c1: i32 = add(%c, 100i32)
  case %c {
    0 => jump ret(%c1)
    _ =>
      let %m: i32 = add(5i32, %c1)
      jump ret(%m)
  }
}

#[export(emu)]
fn objects_of(%c: i32) -> (i32) {
  let %p: imm Pair = new Pair.0()
  let %r: i32 = call objects(%c, %p)
  jump ret(%r)
}
