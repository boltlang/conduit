// Inlining a function that returns a value built by `new` leaves the rest
// of the caller in a join point, which the `new` is jumped to. Copying the
// join point into that jump lets `simplify` pick the arm of its `case`:
// case-of-case.

data Option {
  ()
  (i32)
}

fn safe_div(%x: i32, %y: i32) -> (imm Option) {
  case %y {
    0 =>
      let %none: imm Option = new Option.0()
      jump ret(%none)
    _ =>
      let %q: i32 = div.s(%x, %y)
      let %some: imm Option = new Option.1(%q)
      jump ret(%some)
  }
}

// `safe_div(x, y)` or `-1`, plus one.
fn div_or(%x: i32, %y: i32) -> (i32) {
  let %r: imm Option = call safe_div(%x, %y)
  let %v: i32 = call unwrap_or(%r, -1i32)
  let %v1: i32 = add(%v, 1i32)
  jump ret(%v1)
}

fn unwrap_or(%o: imm Option, %default: i32) -> (i32) {
  case %o {
    Option.0 => jump ret(%default)
    Option.1 =>
      let %x: i32 = get Option.1.0(%o)
      jump ret(%x)
  }
}

//# run div_or(7i32, 2i32) == 4i32
//# run div_or(7i32, 0i32) == 0i32
//# opt
