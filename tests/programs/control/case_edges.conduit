// Cases at the edges: dense tags starting below zero, a case on data with
// an arm for every constructor and no default, a case with only a default,
// and `unreachable`.

data Shape {
  ()
  (i32)
  (i32, i32)
}

// Dense, from -2: Wasm subtracts the smallest tag before `br_table`.
fn dense(%x: i32) -> (i32) {
  case %x {
    -2 => jump ret(20i32)
    -1 => jump ret(21i32)
    0 => jump ret(22i32)
    1 => jump ret(23i32)
    _ => jump ret(99i32)
  }
}

// Every constructor and no default, so the last arm needs no check.
fn shapes(%x: i32) -> (i32) {
  let %empty: imm Shape = new Shape.0()
  let %one: imm Shape = new Shape.1(%x)
  let %two: imm Shape = new Shape.2(%x, %x)
  let %a: i32 = call last_field(%empty)
  let %b: i32 = call last_field(%one)
  let %c: i32 = call last_field(%two)
  let %a100: i32 = mul(%a, 100i32)
  let %b10: i32 = mul(%b, 10i32)
  let %ab: i32 = add(%a100, %b10)
  let %abc: i32 = add(%ab, %c)
  jump ret(%abc)
}

fn last_field(%s: imm Shape) -> (i32) {
  case %s {
    Shape.2 =>
      let %y: i32 = get Shape.2.1(%s)
      jump ret(%y)
    Shape.0 => jump ret(1i32)
    Shape.1 =>
      let %x: i32 = get Shape.1.0(%s)
      jump ret(%x)
  }
}

// Only a default.
fn only_default(%x: i64) -> (i64) {
  case %x {
    _ => jump ret(%x)
  }
}

// An arm for 0, and `unreachable` otherwise.
fn only_zero(%x: i32) -> (i32) {
  case %x {
    0 => jump ret(1i32)
    _ => unreachable
  }
}

// A case on data with one constructor and no default.
fn boxed(%x: i32) -> (i32) {
  let %box: imm Box = new Box.0(%x)
  case %box {
    Box.0 =>
      let %y: i32 = get Box.0.0(%box)
      jump ret(%y)
  }
}

data Box {
  (i32)
}

//# run dense(-3i32) == 99i32
//# run dense(-2i32) == 20i32
//# run dense(-1i32) == 21i32
//# run dense(1i32) == 23i32
//# run dense(2i32) == 99i32
//# run dense(2147483647i32) == 99i32
//# run shapes(3i32) == 133i32
//# run only_default(-5i64) == -5i64
//# run only_zero(0i32) == 1i32
//# run only_zero(1i32) traps
//# run boxed(8i32) == 8i32
