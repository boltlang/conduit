// Cases at the edges: dense tags starting below zero, a case on data with
// an arm for every constructor and no default, a case with only a default,
// and `unreachable`.

data data0 {
  ()
  (i32)
  (i32, i32)
}

// Dense, from -2: Wasm subtracts the smallest tag before `br_table`.
fn fn0(%0: i32) -> (i32) {
  case %0 {
    -2 => jump ret(20i32)
    -1 => jump ret(21i32)
    0 => jump ret(22i32)
    1 => jump ret(23i32)
    _ => jump ret(99i32)
  }
}

// Every constructor and no default, so the last arm needs no check.
fn fn1(%0: i32) -> (i32) {
  let %1: imm data0 = new data0.0()
  let %2: imm data0 = new data0.1(%0)
  let %3: imm data0 = new data0.2(%0, %0)
  let %4: i32 = call fn2(%1)
  let %5: i32 = call fn2(%2)
  let %6: i32 = call fn2(%3)
  let %7: i32 = mul(%4, 100i32)
  let %8: i32 = mul(%5, 10i32)
  let %9: i32 = add(%7, %8)
  let %10: i32 = add(%9, %6)
  jump ret(%10)
}

fn fn2(%0: imm data0) -> (i32) {
  case %0 {
    data0.2 =>
      let %1: i32 = get data0.2.1(%0)
      jump ret(%1)
    data0.0 => jump ret(1i32)
    data0.1 =>
      let %2: i32 = get data0.1.0(%0)
      jump ret(%2)
  }
}

// Only a default.
fn fn3(%0: i64) -> (i64) {
  case %0 {
    _ => jump ret(%0)
  }
}

// An arm for 0, and `unreachable` otherwise.
fn fn4(%0: i32) -> (i32) {
  case %0 {
    0 => jump ret(1i32)
    _ => unreachable
  }
}

// A case on data with one constructor and no default.
fn fn5(%0: i32) -> (i32) {
  let %1: imm data1 = new data1.0(%0)
  case %1 {
    data1.0 =>
      let %2: i32 = get data1.0.0(%1)
      jump ret(%2)
  }
}

data data1 {
  (i32)
}

//# run fn0(-3i32) == 99i32
//# run fn0(-2i32) == 20i32
//# run fn0(-1i32) == 21i32
//# run fn0(1i32) == 23i32
//# run fn0(2i32) == 99i32
//# run fn0(2147483647i32) == 99i32
//# run fn1(3i32) == 133i32
//# run fn3(-5i64) == -5i64
//# run fn4(0i32) == 1i32
//# run fn4(1i32) traps
//# run fn5(8i32) == 8i32
