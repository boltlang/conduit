// `fac` from docs/ir.md: a join point shared by two arms, and a call
// that isn't a tail call.

fn fac(%n: i32) -> (i32) {
  join one() = jump ret(1i32)
  in
  case %n {
    0 => jump one()
    1 => jump one()
    _ =>
      let %n1: i32 = sub(%n, 1i32)
      let %fac_n1: i32 = call fac(%n1)
      let %r: i32 = mul(%n, %fac_n1)
      jump ret(%r)
  }
}

//# run fac(0i32) == 1i32
//# run fac(1i32) == 1i32
//# run fac(5i32) == 120i32
