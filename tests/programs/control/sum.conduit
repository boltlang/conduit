// `sum` from docs/ir.md: a loop as a recursive join point.

fn fn0(%0: i32) -> (i32) {
  join rec j1(%1: i32, %2: i32) =
    let %3: i32 = ge.s(%1, %0)
    case %3 {
      1 => jump ret(%2)
      _ =>
        let %4: i32 = add(%1, 1i32)
        let %5: i32 = add(%2, %1)
        jump j1(%4, %5)
    }
  in jump j1(0i32, 0i32)
}

//# run fn0(0i32) == 0i32
//# run fn0(5i32) == 10i32
