// `sum` from docs/ir/ir.md: a loop as a recursive join point.

fn sum(%n: i32) -> (i32) {
  join rec loop(%i: i32, %acc: i32) =
    let %done: i32 = ge.s(%i, %n)
    case %done {
      1 => jump ret(%acc)
      _ =>
        let %i1: i32 = add(%i, 1i32)
        let %acc1: i32 = add(%acc, %i)
        jump loop(%i1, %acc1)
    }
  in jump loop(0i32, 0i32)
}

//# run sum(0i32) == 0i32
//# run sum(5i32) == 10i32
