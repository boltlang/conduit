// A jump that swaps two parameters mustn't overwrite one before it's read.

fn swap_sub(%a: i32, %b: i32, %n: i32) -> (i32) {
  join rec loop(%x: i32, %y: i32, %k: i32) =
    case %k {
      0 =>
        let %d: i32 = sub(%x, %y)
        jump ret(%d)
      _ =>
        let %k1: i32 = sub(%k, 1i32)
        jump loop(%y, %x, %k1)
    }
  in jump loop(%a, %b, %n)
}

//# run swap_sub(10i32, 3i32, 0i32) == 7i32
//# run swap_sub(10i32, 3i32, 1i32) == -7i32
//# run swap_sub(10i32, 3i32, 2i32) == 7i32
