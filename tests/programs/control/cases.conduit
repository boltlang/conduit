// A dense case on an i32 dispatches with `br_table` in Wasm, a sparse one
// compares each tag, and so does a case on an i64.

fn fn0(%0: i32) -> (i32) {
  case %0 {
    0 => jump ret(10i32)
    1 => jump ret(11i32)
    2 => jump ret(12i32)
    3 => jump ret(13i32)
    5 => jump ret(15i32)
    _ => jump ret(99i32)
  }
}

fn fn1(%0: i32) -> (i32) {
  case %0 {
    -1000 => jump ret(1i32)
    7 => jump ret(2i32)
    1048576 => jump ret(3i32)
    _ => jump ret(0i32)
  }
}

fn fn2(%0: i64) -> (i64) {
  case %0 {
    1099511627776 => jump ret(1i64)
    _ => jump ret(2i64)
  }
}

//# run fn0(-1i32) == 99i32
//# run fn0(0i32) == 10i32
//# run fn0(3i32) == 13i32
//# run fn0(4i32) == 99i32
//# run fn0(5i32) == 15i32
//# run fn0(6i32) == 99i32
//# run fn0(-2147483648i32) == 99i32
//# run fn1(-1000i32) == 1i32
//# run fn1(7i32) == 2i32
//# run fn1(1048576i32) == 3i32
//# run fn1(8i32) == 0i32
//# run fn2(1099511627776i64) == 1i64
//# run fn2(1i64) == 2i64
//# wat
