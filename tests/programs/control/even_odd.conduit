// Two mutually recursive join points.

fn fn0(%0: i32) -> (i32) {
  join rec j1(%1: i32) =
    case %1 {
      0 => jump ret(1i32)
      _ =>
        let %2: i32 = sub(%1, 1i32)
        jump j2(%2)
    }
  and j2(%3: i32) =
    case %3 {
      0 => jump ret(0i32)
      _ =>
        let %4: i32 = sub(%3, 1i32)
        jump j1(%4)
    }
  in jump j1(%0)
}

//# run fn0(0i32) == 1i32
//# run fn0(7i32) == 0i32
//# run fn0(10i32) == 1i32
