// `let r = call f(..); jump ret(r)` is a tail call, so deep recursion
// doesn't grow the stack. In Wasm it's a `return_call`.

fn fn0(%0: i32, %1: i32) -> (i32) {
  case %0 {
    0 => jump ret(%1)
    _ =>
      let %2: i32 = sub(%0, 1i32)
      let %3: i32 = add(%1, 2i32)
      let %4: i32 = call fn0(%2, %3)
      jump ret(%4)
  }
}

//# run fn0(1000000i32, 0i32) == 2000000i32
//# wat
