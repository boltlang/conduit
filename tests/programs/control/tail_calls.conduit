// `let r = call f(..); jump ret(r)` is a tail call, so deep recursion
// doesn't grow the stack. In Wasm it's a `return_call`.

fn count(%n: i32, %acc: i32) -> (i32) {
  case %n {
    0 => jump ret(%acc)
    _ =>
      let %n1: i32 = sub(%n, 1i32)
      let %acc1: i32 = add(%acc, 2i32)
      let %r: i32 = call count(%n1, %acc1)
      jump ret(%r)
  }
}

//# run count(1000000i32, 0i32) == 2000000i32
