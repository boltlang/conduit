data List {
  ()
  (i32, inherit List)
}

fn build(%n: i32) -> (imm List) {
  case %n {
    0 =>
      let %nil: imm List = new List.0()
      jump ret(%nil)
    _ =>
      let %n1: i32 = sub(%n, 1i32)
      let %rest: imm List = call build(%n1)
      let %list: imm List = new List.1(%n, %rest)
      jump ret(%list)
  }
}

fn map(%l: imm List) -> (imm List) {
  case %l {
    List.0 => jump ret(%l)
    List.1 =>
      let %head: i32 = get List.1.0(%l)
      let %tail: imm List = get List.1.1(%l)
      let %7: i32 = is_unique(%l)
      join j1(%6: reuse List.1) =
        let %head1: i32 = add(%head, 1i32)
        let %tail1: imm List = call map(%tail)
        let %cell: imm List = reuse List.1(%6, %head1, %tail1)
        jump ret(%cell)
      in
      case %7 {
        1 =>
          let %8: reuse List.1 = reuse_token(%l)
          jump j1(%8)
        _ =>
          let = dup(%tail)
          let = decref(%l)
          let %9: reuse List.1 = undefined()
          jump j1(%9)
      }
  }
}

fn sum(%l: imm List) -> (i32) {
  case %l {
    List.0 => jump ret(0i32)
    List.1 =>
      let %head: i32 = get List.1.0(%l)
      let %tail: imm List = get List.1.1(%l)
      let %rest: i32 = call sum(%tail)
      let %r: i32 = add(%head, %rest)
      jump ret(%r)
  }
}

fn main(%n: i32) -> (i32) {
  let %l: imm List = call build(%n)
  let %m: imm List = call map(%l)
  let %r: i32 = call sum(%m)
  let = drop(%m)
  jump ret(%r)
}

fn frozen(%n: i32) -> (i32) {
  let %a: mut [i32] = array_fill(3i32, %n)
  let %6: i32 = is_unique(%a)
  join j1(%b: imm [i32]) =
    let %x: i32 = array_get(%b, 0i32)
    let %y: i32 = array_get(%b, 2i32)
    let = drop(%b)
    let %r: i32 = add(%x, %y)
    jump ret(%r)
  in
  case %6 {
    1 =>
      let %7: imm [i32] = array_freeze(%a)
      jump j1(%7)
    _ =>
      let %8: imm [i32] = array_clone(%a)
      let = decref(%a)
      jump j1(%8)
  }
}
