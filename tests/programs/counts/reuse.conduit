// Functional but in-place: `map` takes its list apart and builds one of
// the same shape, so each new cell goes in the memory of the old one when
// that's unique, as it is here, since `main` gives its list away. In
// `frozen`, the last use of `%a`, a fresh array, is an `array_clone` to
// `imm`, which freezes it in place when it's unique.

data List {
  ()
  (i32, inherit List)
}

fn build(%n: i32) -> (imm List) {
  case %n {
    0 =>
      let %nil: imm List = new List.0()
      jump ret(%nil)
    _ =>
      let %n1: i32 = sub(%n, 1i32)
      let %rest: imm List = call build(%n1)
      let %list: imm List = new List.1(%n, %rest)
      jump ret(%list)
  }
}

// map(l) = l with 1 added to each element
fn map(%l: imm List) -> (imm List) {
  case %l {
    List.0 => jump ret(%l)
    List.1 =>
      let %head: i32 = get List.1.0(%l)
      let %tail: imm List = get List.1.1(%l)
      let %head1: i32 = add(%head, 1i32)
      let %tail1: imm List = call map(%tail)
      let %cell: imm List = new List.1(%head1, %tail1)
      jump ret(%cell)
  }
}

fn sum(%l: imm List) -> (i32) {
  case %l {
    List.0 => jump ret(0i32)
    List.1 =>
      let %head: i32 = get List.1.0(%l)
      let %tail: imm List = get List.1.1(%l)
      let %rest: i32 = call sum(%tail)
      let %r: i32 = add(%head, %rest)
      jump ret(%r)
  }
}

// sum(map(build(n)))
fn main(%n: i32) -> (i32) {
  let %l: imm List = call build(%n)
  let %m: imm List = call map(%l)
  let %r: i32 = call sum(%m)
  jump ret(%r)
}

// The sum of an array filled with n, frozen.
fn frozen(%n: i32) -> (i32) {
  let %a: mut [i32] = array_fill(3i32, %n)
  let %b: imm [i32] = array_clone(%a)
  let %x: i32 = array_get(%b, 0i32)
  let %y: i32 = array_get(%b, 2i32)
  let %r: i32 = add(%x, %y)
  jump ret(%r)
}

//# run main(4i32) == 14i32
//# run frozen(5i32) == 10i32
