// Which parameters are borrowed. `len` and `sum_to` only read their list,
// so they borrow it, and so is what they read from it: neither counts
// anything, and `main` frees the list once, at the end. `skip_zeros`
// returns its list, so it owns it, and the cells it skips are freed as it
// goes, with no counts for their tails when they're unique. `add` is made
// into a closure, so it owns its captures, whatever it does with them.

data List {
  ()
  (i32, inherit List)
}

fn build(%n: i32) -> (imm List) {
  case %n {
    0 =>
      let %nil: imm List = new List.0()
      jump ret(%nil)
    _ =>
      let %n1: i32 = sub(%n, 1i32)
      let %rest: imm List = call build(%n1)
      let %list: imm List = new List.1(%n, %rest)
      jump ret(%list)
  }
}

fn len(%l: imm List) -> (i32) {
  case %l {
    List.0 => jump ret(0i32)
    List.1 =>
      let %tail: imm List = get List.1.1(%l)
      let %rest: i32 = call len(%tail)
      let %r: i32 = add(%rest, 1i32)
      jump ret(%r)
  }
}

fn sum_to(%l: imm List, %acc: i32) -> (i32) {
  case %l {
    List.0 => jump ret(%acc)
    List.1 =>
      let %head: i32 = get List.1.0(%l)
      let %tail: imm List = get List.1.1(%l)
      let %acc1: i32 = add(%acc, %head)
      let %r: i32 = call sum_to(%tail, %acc1)
      jump ret(%r)
  }
}

fn add(%l: imm List, %x: i32) -> (i32) {
  let %n: i32 = call len(%l)
  let %r: i32 = add(%n, %x)
  jump ret(%r)
}

// skip_zeros(l) = the list without the zeros it starts with
fn skip_zeros(%l: imm List) -> (imm List) {
  case %l {
    List.0 => jump ret(%l)
    List.1 =>
      let %head: i32 = get List.1.0(%l)
      case %head {
        0 =>
          let %tail: imm List = get List.1.1(%l)
          let %r: imm List = call skip_zeros(%tail)
          jump ret(%r)
        _ => jump ret(%l)
      }
  }
}

// len(skip_zeros([0, 0, 3, 0]))
fn skipped() -> (i32) {
  let %nil: imm List = new List.0()
  let %l4: imm List = new List.1(0i32, %nil)
  let %l3: imm List = new List.1(3i32, %l4)
  let %l2: imm List = new List.1(0i32, %l3)
  let %l1: imm List = new List.1(0i32, %l2)
  let %r: imm List = call skip_zeros(%l1)
  let %n: i32 = call len(%r)
  jump ret(%n)
}

// len(l) + sum_to(l, 0) + (add l)(100)
fn main(%n: i32) -> (i32) {
  let %l: imm List = call build(%n)
  let %a: i32 = call len(%l)
  let %f: imm fn(i32) -> (i32) = closure add(%l)
  let %b: i32 = apply(%f, 100i32)
  let %c: i32 = call sum_to(%l, 0i32)
  let %ab: i32 = add(%a, %b)
  let %r: i32 = add(%ab, %c)
  jump ret(%r)
}

//# run main(4i32) == 118i32
//# run skipped() == 2i32
//# counts
//# bench
