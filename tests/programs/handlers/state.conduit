// State in a ref, with tail-resumptive clauses, which Wasm compiles as
// plain calls.
effect State {
  () -> (i32)
  (i32) -> ()
}

effect Tick {
  () -> ()
}

// State: get and set the ref.
handler state for State env(ref i32) ops(get, set) ret state_done

// Tick: add one to the state, with the State handler outside it.
handler ticker for Tick does State env() ops(tick) ret ticker_done

// State, seen one higher than the State outside it.
handler one_higher for State does State env() ops(get_higher, set_higher) ret higher_done

fn get(%cell: ref i32, %k: cont(i32) -> (i32)) -> (i32) {
  let %x: i32 = ref_get(%cell)
  let %r: i32 = resume(%k, %x)
  jump ret(%r)
}

fn set(%cell: ref i32, %x: i32, %k: cont() -> (i32)) -> (i32) {
  let = ref_set(%cell, %x)
  let %r: i32 = resume(%k)
  jump ret(%r)
}

fn state_done(%cell: ref i32, %r: i32) -> (i32) {
  jump ret(%r)
}

// A `perform` in a clause goes to the handlers outside it.
fn tick(%k: cont() -> (i32) does State) -> (i32) does State {
  let %x: i32 = perform State.0()
  let %x1: i32 = add(%x, 1i32)
  let = perform State.1(%x1)
  let %r: i32 = resume(%k)
  jump ret(%r)
}

fn ticker_done(%r: i32) -> (i32) {
  jump ret(%r)
}

// Even a `perform` of the clause's own effect.
fn get_higher(%k: cont(i32) -> (i32) does State) -> (i32) does State {
  let %x: i32 = perform State.0()
  let %x1: i32 = add(%x, 1i32)
  let %r: i32 = resume(%k, %x1)
  jump ret(%r)
}

fn set_higher(%x: i32, %k: cont() -> (i32) does State) -> (i32) does State {
  let %x1: i32 = sub(%x, 1i32)
  let = perform State.1(%x1)
  let %r: i32 = resume(%k)
  jump ret(%r)
}

fn higher_done(%r: i32) -> (i32) {
  jump ret(%r)
}

// Ticks twice under a State that starts at %start, and gives the state.
fn tick_twice(%start: i32) -> (i32) {
  let %cell: ref i32 = ref_new(%start)
  let %body: imm fn() -> (i32) does State = closure under_ticker()
  let %r: i32 = handle state(%cell, %body)
  jump ret(%r)
}

fn ticks() -> (i32) does State + Tick {
  let = perform Tick.0()
  let = perform Tick.0()
  let %x: i32 = perform State.0()
  jump ret(%x)
}

fn under_ticker() -> (i32) does State {
  let %body: imm fn() -> (i32) does State + Tick = closure ticks()
  let %r: i32 = handle ticker(%body)
  jump ret(%r)
}

// An inner State hides the outer one: 7 inside, 100 outside, so 7100.
fn nested_states() -> (i32) {
  let %cell: ref i32 = ref_new(100i32)
  let %body: imm fn() -> (i32) does State = closure inner_state()
  let %r: i32 = handle state(%cell, %body)
  jump ret(%r)
}

fn inner_state() -> (i32) does State {
  let %cell: ref i32 = ref_new(0i32)
  let %body: imm fn() -> (i32) does State = closure set7()
  let %inner: i32 = handle state(%cell, %body)
  let %outer: i32 = perform State.0()
  let %inner1000: i32 = mul(%inner, 1000i32)
  let %r: i32 = add(%inner1000, %outer)
  jump ret(%r)
}

fn set7() -> (i32) does State {
  let = perform State.1(7i32)
  let %x: i32 = perform State.0()
  jump ret(%x)
}

// one_higher over a State at %start: reads %start + 1, and setting 5 stores 4.
fn through_higher(%start: i32) -> (i32, i32) {
  let %cell: ref i32 = ref_new(%start)
  let %body: imm fn() -> (i32) does State = closure under_higher()
  let %r: i32 = handle state(%cell, %body)
  let %stored: i32 = ref_get(%cell)
  jump ret(%r, %stored)
}

fn under_higher() -> (i32) does State {
  let %body: imm fn() -> (i32) does State = closure get_set5()
  let %r: i32 = handle one_higher(%body)
  jump ret(%r)
}

fn get_set5() -> (i32) does State {
  let %x: i32 = perform State.0()
  let = perform State.1(5i32)
  jump ret(%x)
}

//# run tick_twice(40i32) == 42i32
//# run nested_states() == 7100i32
//# run through_higher(10i32) == (11i32, 4i32)
