// State in a ref, with tail-resumptive clauses, which Wasm compiles as
// plain calls.
effect effect20 {
  () -> (i32)
  (i32) -> ()
}

effect effect21 {
  () -> ()
}

// State: get and set the ref.
handler handler30 for effect20 env(ref i32) ops(fn10, fn11) ret fn12

// Tick: add one to the state, with the State handler outside it.
handler handler31 for effect21 does effect20 env() ops(fn13) ret fn14

// State, seen one higher than the State outside it.
handler handler32 for effect20 does effect20 env() ops(fn15, fn16) ret fn17

fn fn10(%0: ref i32, %1: cont(i32) -> (i32)) -> (i32) {
  let %2: i32 = ref_get(%0)
  let %3: i32 = resume(%1, %2)
  jump ret(%3)
}

fn fn11(%0: ref i32, %1: i32, %2: cont() -> (i32)) -> (i32) {
  let = ref_set(%0, %1)
  let %3: i32 = resume(%2)
  jump ret(%3)
}

fn fn12(%0: ref i32, %1: i32) -> (i32) {
  jump ret(%1)
}

// A `perform` in a clause goes to the handlers outside it.
fn fn13(%0: cont() -> (i32) does effect20) -> (i32) does effect20 {
  let %1: i32 = perform effect20.0()
  let %2: i32 = add(%1, 1i32)
  let = perform effect20.1(%2)
  let %3: i32 = resume(%0)
  jump ret(%3)
}

fn fn14(%0: i32) -> (i32) {
  jump ret(%0)
}

// Even a `perform` of the clause's own effect.
fn fn15(%0: cont(i32) -> (i32) does effect20) -> (i32) does effect20 {
  let %1: i32 = perform effect20.0()
  let %2: i32 = add(%1, 1i32)
  let %3: i32 = resume(%0, %2)
  jump ret(%3)
}

fn fn16(%0: i32, %1: cont() -> (i32) does effect20) -> (i32) does effect20 {
  let %2: i32 = sub(%0, 1i32)
  let = perform effect20.1(%2)
  let %3: i32 = resume(%1)
  jump ret(%3)
}

fn fn17(%0: i32) -> (i32) {
  jump ret(%0)
}

// Ticks twice under a State that starts at %0, and gives the state.
fn fn0(%0: i32) -> (i32) {
  let %1: ref i32 = ref_new(%0)
  let %2: imm fn() -> (i32) does effect20 = closure fn2()
  let %3: i32 = handle handler30(%1, %2)
  jump ret(%3)
}

fn fn1() -> (i32) does effect20 + effect21 {
  let = perform effect21.0()
  let = perform effect21.0()
  let %0: i32 = perform effect20.0()
  jump ret(%0)
}

fn fn2() -> (i32) does effect20 {
  let %0: imm fn() -> (i32) does effect20 + effect21 = closure fn1()
  let %1: i32 = handle handler31(%0)
  jump ret(%1)
}

// An inner State hides the outer one: 7 inside, 100 outside, so 7100.
fn fn3() -> (i32) {
  let %0: ref i32 = ref_new(100i32)
  let %1: imm fn() -> (i32) does effect20 = closure fn4()
  let %2: i32 = handle handler30(%0, %1)
  jump ret(%2)
}

fn fn4() -> (i32) does effect20 {
  let %0: ref i32 = ref_new(0i32)
  let %1: imm fn() -> (i32) does effect20 = closure fn5()
  let %2: i32 = handle handler30(%0, %1)
  let %3: i32 = perform effect20.0()
  let %4: i32 = mul(%2, 1000i32)
  let %5: i32 = add(%4, %3)
  jump ret(%5)
}

fn fn5() -> (i32) does effect20 {
  let = perform effect20.1(7i32)
  let %0: i32 = perform effect20.0()
  jump ret(%0)
}

// handler32 over a State at %0: reads %0 + 1, and setting 5 stores 4.
fn fn6(%0: i32) -> (i32, i32) {
  let %1: ref i32 = ref_new(%0)
  let %2: imm fn() -> (i32) does effect20 = closure fn7()
  let %3: i32 = handle handler30(%1, %2)
  let %4: i32 = ref_get(%1)
  jump ret(%3, %4)
}

fn fn7() -> (i32) does effect20 {
  let %0: imm fn() -> (i32) does effect20 = closure fn8()
  let %1: i32 = handle handler32(%0)
  jump ret(%1)
}

fn fn8() -> (i32) does effect20 {
  let %0: i32 = perform effect20.0()
  let = perform effect20.1(5i32)
  jump ret(%0)
}

//# run fn0(40i32) == 42i32
//# run fn3() == 7100i32
//# run fn6(10i32) == (11i32, 4i32)
