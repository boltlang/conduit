// `discontinue E.i(k, xs)` continues `k` by performing `E.i(xs)` where it
// was captured. Wasm lowers a clause whose ways out all resume or
// discontinue in tail position as a plain call: a `discontinue` then
// performs under the handlers of the `perform` the clause handles.
effect effect20 {                         // Wait
  () -> (i32)
}

effect effect21 {                         // Cancel
  () -> (i32)
}

effect effect22 {                         // Fail with a code
  (i32) -> (i32)
}

effect effect23 {                         // Tag a value
  (i32) -> (i32)
}

effect effect24 {                         // Stop
  () -> (i32)
}

// A scheduler: Wait gives 5 when the environment is 0, and cancels the
// waiting task otherwise.
handler handler30 for effect20 env(i32) ops(fn1) ret fn2

// Catches a cancel: counts it in the ref, and gives -1.
handler handler31 for effect21 env(ref i32) ops(fn3) ret fn4

// A `defer` around a task: on a cancel, adds 10 to the ref and cancels on.
handler handler32 for effect21 env(ref i32) ops(fn5) ret fn4

// Recovers from a failure with twice its code.
handler handler33 for effect22 env() ops(fn7) ret fn8

// A scheduler that fails the waiting task with code 21.
handler handler34 for effect20 env() ops(fn9) ret fn8

// Tags a value by adding the environment.
handler handler35 for effect23 env(i32) ops(fn10) ret fn2

// A scheduler that tags 1 itself, then has the waiting task tag that.
handler handler36 for effect20 env() ops(fn11) ret fn8

// Stop gives 0.
handler handler37 for effect24 env() ops(fn12) ret fn8

// A scheduler that first stops a computation of its own, then has the
// waiting task tag 5.
handler handler38 for effect20 env() ops(fn13) ret fn8

fn fn1(%0: i32, %1: cont(i32) -> (i32)) -> (i32) {
  case %0 {
    0 =>
      let %2: i32 = resume(%1, 5i32)
      jump ret(%2)
    _ =>
      let %3: i32 = discontinue effect21.0(%1)
      jump ret(%3)
  }
}

fn fn2(%0: i32, %1: i32) -> (i32) {
  jump ret(%1)
}

fn fn3(%0: ref i32, %1: cont(i32) -> (i32)) -> (i32) {
  let %2: i32 = ref_get(%0)
  let %3: i32 = add(%2, 1i32)
  let = ref_set(%0, %3)
  jump ret(-1i32)
}

fn fn4(%0: ref i32, %1: i32) -> (i32) {
  jump ret(%1)
}

fn fn5(%0: ref i32, %1: cont(i32) -> (i32)) -> (i32) {
  let %2: i32 = ref_get(%0)
  let %3: i32 = add(%2, 10i32)
  let = ref_set(%0, %3)
  let %4: i32 = perform effect21.0()
  jump ret(%4)
}

fn fn7(%0: i32, %1: cont(i32) -> (i32)) -> (i32) {
  let %2: i32 = mul(%0, 2i32)
  let %3: i32 = resume(%1, %2)
  jump ret(%3)
}

fn fn8(%0: i32) -> (i32) {
  jump ret(%0)
}

fn fn9(%0: cont(i32) -> (i32)) -> (i32) {
  let %1: i32 = discontinue effect22.0(%0, 21i32)
  jump ret(%1)
}

fn fn10(%0: i32, %1: i32, %2: cont(i32) -> (i32)) -> (i32) {
  let %3: i32 = add(%0, %1)
  let %4: i32 = resume(%2, %3)
  jump ret(%4)
}

// The `perform` goes to the handlers outside the scheduler, and the
// `discontinue` to those inside the task.
fn fn11(%0: cont(i32) -> (i32)) -> (i32) {
  let %1: i32 = perform effect23.0(1i32)
  let %2: i32 = discontinue effect23.0(%0, %1)
  jump ret(%2)
}

fn fn12(%0: cont(i32) -> (i32)) -> (i32) {
  jump ret(0i32)
}

// The Stop unwinds out of a `perform`, which then can't put back what the
// `discontinue` needs: the `handle` that catches it must.
fn fn13(%0: cont(i32) -> (i32)) -> (i32) {
  let %1: imm fn() -> (i32) = closure fn14()
  let %2: i32 = handle handler37(%1)
  let %3: i32 = add(%2, 5i32)
  let %4: i32 = discontinue effect23.0(%0, %3)
  jump ret(%4)
}

fn fn14() -> (i32) {
  let %0: i32 = perform effect24.0()
  jump ret(%0)
}

// A task under a `defer`, under a scheduler, under a catch: Wait plus 100,
// and the count of cleanups and catches.
fn fn100(%0: i32) -> (i32, i32) {
  let %1: ref i32 = ref_new(0i32)
  let %2: mut fn() -> (i32) = closure fn101(%0, %1)
  let %3: i32 = handle handler31(%1, %2)
  let %4: i32 = ref_get(%1)
  jump ret(%3, %4)
}

fn fn101(%0: i32, %1: ref i32) -> (i32) {
  let %2: mut fn() -> (i32) = closure fn102(%1)
  let %3: i32 = handle handler30(%0, %2)
  jump ret(%3)
}

fn fn102(%0: ref i32) -> (i32) {
  let %1: imm fn() -> (i32) = closure fn103()
  let %2: i32 = handle handler32(%0, %1)
  jump ret(%2)
}

fn fn103() -> (i32) {
  let %0: i32 = perform effect20.0()
  let %1: i32 = add(%0, 100i32)
  jump ret(%1)
}

// A task that recovers from the failure its Wait gets: 21 * 2 + 1.
fn fn104() -> (i32) {
  let %0: imm fn() -> (i32) = closure fn105()
  let %1: i32 = handle handler34(%0)
  jump ret(%1)
}

fn fn105() -> (i32) {
  let %0: imm fn() -> (i32) = closure fn106()
  let %1: i32 = handle handler33(%0)
  jump ret(%1)
}

fn fn106() -> (i32) {
  let %0: i32 = perform effect20.0()
  let %1: i32 = add(%0, 1i32)
  jump ret(%1)
}

// Tag 1000 outside the scheduler, and Tag 2000 inside the task: the
// scheduler tags 1 outside, 1001, and the task that inside, 3001.
fn fn107() -> (i32) {
  let %0: imm fn() -> (i32) = closure fn108()
  let %1: i32 = handle handler35(1000i32, %0)
  jump ret(%1)
}

fn fn108() -> (i32) {
  let %0: imm fn() -> (i32) = closure fn109()
  let %1: i32 = handle handler36(%0)
  jump ret(%1)
}

fn fn109() -> (i32) {
  let %0: imm fn() -> (i32) = closure fn110()
  let %1: i32 = handle handler35(2000i32, %0)
  jump ret(%1)
}

fn fn110() -> (i32) {
  let %0: i32 = perform effect20.0()
  jump ret(%0)
}

// The same with the scheduler that stops first: the task tags 0 + 5
// inside, 2005.
fn fn111() -> (i32) {
  let %0: imm fn() -> (i32) = closure fn112()
  let %1: i32 = handle handler35(1000i32, %0)
  jump ret(%1)
}

fn fn112() -> (i32) {
  let %0: imm fn() -> (i32) = closure fn109()
  let %1: i32 = handle handler38(%0)
  jump ret(%1)
}

//# run fn100(0i32) == (105i32, 0i32)
//# run fn100(1i32) == (-1i32, 11i32)
//# run fn104() == 43i32
//# run fn107() == 3001i32
//# run fn111() == 2005i32
