// Many handlers at once: deep recursion, aborts that pass through other
// handlers, and frames left behind by an abort, which must not catch a
// later `perform`.
effect Count {
  () -> ()
}

effect Fail {
  () -> ()
}

effect Ask {
  () -> (i32)
}

// Count adds one to the ref.
handler counter for Count does Fail env(ref i32) ops(count) ret counter_done

// Fail gives the first value, or with a second value that isn't 0, fails
// again, to the next Fail out.
handler fail_twice for Fail does Fail env(i32, i32) ops(fail) ret fail_twice_done

// Fail does nothing and resumes.
handler ignore for Fail env() ops(ignore_fail) ret id

// Ask fails, to the next Fail out, before it would resume.
handler ask_fails for Ask does Fail env() ops(ask) ret id

fn count(%cell: ref i32, %k: cont() -> (i32) does Fail) -> (i32) does Fail {
  let %old: i32 = ref_get(%cell)
  let %new: i32 = add(%old, 1i32)
  let = ref_set(%cell, %new)
  let %r: i32 = resume(%k)
  jump ret(%r)
}

fn counter_done(%cell: ref i32, %r: i32) -> (i32) {
  jump ret(%r)
}

fn fail(%first: i32, %again: i32, %k: cont() -> (i32) does Fail) -> (i32) does Fail {
  case %again {
    0 => jump ret(%first)
    _ =>
      let = perform Fail.0()
      unreachable
  }
}

fn fail_twice_done(%first: i32, %again: i32, %r: i32) -> (i32) {
  jump ret(%r)
}

fn ignore_fail(%k: cont() -> (i32)) -> (i32) {
  let %r: i32 = resume(%k)
  jump ret(%r)
}

fn id(%r: i32) -> (i32) {
  jump ret(%r)
}

fn ask(%k: cont(i32) -> (i32) does Fail) -> (i32) does Fail {
  let = perform Fail.0()
  let %r: i32 = resume(%k, 0i32)
  jump ret(%r)
}

fn just_fail() -> (i32) does Fail {
  let = perform Fail.0()
  unreachable
}

// %depth nested Count handlers, the innermost around a Count. Each level adds
// its count times its depth, so only the innermost, at depth 1, counts.
fn nested_counts(%depth: i32) -> (i32) does Count + Fail {
  case %depth {
    0 =>
      let = perform Count.0()
      jump ret(0i32)
    _ =>
      let %cell: ref i32 = ref_new(0i32)
      let %depth1: i32 = sub(%depth, 1i32)
      let %body: imm fn() -> (i32) does Count + Fail = closure nested_counts(%depth1)
      let %inner: i32 = handle counter(%cell, %body)
      let %count: i32 = ref_get(%cell)
      let %weighted: i32 = mul(%count, %depth)
      let %r: i32 = add(%inner, %weighted)
      jump ret(%r)
  }
}

// A Fail to an inner Fail 6 that fails again, to the outer Fail 5. What
// follows the inner handle never runs.
fn outer_fail() -> (i32) does Fail {
  let %body: imm fn() -> (i32) does Fail = closure inner_fail()
  let %r: i32 = handle fail_twice(5i32, 0i32, %body)
  jump ret(%r)
}

fn inner_fail() -> (i32) does Fail {
  let %body: imm fn() -> (i32) does Fail = closure just_fail()
  let %r: i32 = handle fail_twice(6i32, 1i32, %body)
  let %r1000: i32 = add(%r, 1000i32)
  jump ret(%r1000)
}

// A Fail that an inner, resuming handler of the same effect takes first.
fn resumed_first() -> (i32) does Fail {
  let %body: imm fn() -> (i32) = closure ignored()
  let %r: i32 = handle fail_twice(-1i32, 0i32, %body)
  jump ret(%r)
}

fn ignored() -> (i32) {
  let %body: imm fn() -> (i32) does Fail = closure fail_then_42()
  let %r: i32 = handle ignore(%body)
  jump ret(%r)
}

fn fail_then_42() -> (i32) does Fail {
  let = perform Fail.0()
  jump ret(42i32)
}

// Under Count: Fail 77 around Count around Ask, whose clause fails. The
// abort leaves the inner Count's frame behind, and the Count after it must
// go to the outer one: 77 * 10 + 1.
fn frames_left() -> (i32) does Fail {
  let %cell: ref i32 = ref_new(0i32)
  let %body: imm fn() -> (i32) does Count + Fail = closure fail_77()
  let %r: i32 = handle counter(%cell, %body)
  let %count: i32 = ref_get(%cell)
  let %r10: i32 = mul(%r, 10i32)
  let %sum: i32 = add(%r10, %count)
  jump ret(%sum)
}

fn fail_77() -> (i32) does Count + Fail {
  let %body: imm fn() -> (i32) does Fail = closure inner_count()
  let %r: i32 = handle fail_twice(77i32, 0i32, %body)
  let = perform Count.0()
  jump ret(%r)
}

fn inner_count() -> (i32) does Fail {
  let %cell: ref i32 = ref_new(0i32)
  let %body: imm fn() -> (i32) does Fail = closure asked()
  let %r: i32 = handle counter(%cell, %body)
  jump ret(%r)
}

fn asked() -> (i32) does Fail {
  let %body: imm fn() -> (i32) does Ask = closure just_ask()
  let %r: i32 = handle ask_fails(%body)
  jump ret(%r)
}

fn just_ask() -> (i32) does Ask {
  let %x: i32 = perform Ask.0()
  jump ret(%x)
}

// Under Count, 1000 rounds of a Fail i around a Count around a Fail: the
// sum of 0 to 999, then one Count, which must go to the outer handler:
// 499500 * 10 + 1.
fn many_rounds() -> (i32) does Fail {
  let %cell: ref i32 = ref_new(0i32)
  let %body: imm fn() -> (i32) does Count + Fail = closure rounds()
  let %r: i32 = handle counter(%cell, %body)
  let %count: i32 = ref_get(%cell)
  let %r10: i32 = mul(%r, 10i32)
  let %sum: i32 = add(%r10, %count)
  jump ret(%sum)
}

fn rounds() -> (i32) does Count + Fail {
  join rec loop(%i: i32, %acc: i32) =
    let %done: i32 = eq(%i, 1000i32)
    case %done {
      1 =>
        let = perform Count.0()
        jump ret(%acc)
      _ =>
        let %body: imm fn() -> (i32) does Fail = closure round()
        let %r: i32 = handle fail_twice(%i, 0i32, %body)
        let %acc1: i32 = add(%acc, %r)
        let %i1: i32 = add(%i, 1i32)
        jump loop(%i1, %acc1)
    }
  in jump loop(0i32, 0i32)
}

fn round() -> (i32) does Fail {
  let %cell: ref i32 = ref_new(0i32)
  let %body: imm fn() -> (i32) does Fail = closure just_fail()
  let %r: i32 = handle counter(%cell, %body)
  jump ret(%r)
}

//# run nested_counts(1i32) == 1i32
//# run nested_counts(500i32) == 1i32
//# run outer_fail() == 5i32
//# run resumed_first() == 42i32
//# run frames_left() == 771i32
//# run many_rounds() == 4995001i32
