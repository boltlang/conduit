// Many handlers at once: deep recursion, aborts that pass through other
// handlers, and frames left behind by an abort, which must not catch a
// later `perform`.
effect effect20 {                         // Count
  () -> ()
}

effect effect21 {                         // Fail
  () -> ()
}

effect effect22 {                         // Ask
  () -> (i32)
}

// Count adds one to the ref.
handler handler30 for effect20 does effect21 env(ref i32) ops(fn1) ret fn2

// Fail gives the first value, or with a second value that isn't 0, fails
// again, to the next Fail out.
handler handler31 for effect21 does effect21 env(i32, i32) ops(fn3) ret fn4

// Fail does nothing and resumes.
handler handler32 for effect21 env() ops(fn5) ret fn6

// Ask fails, to the next Fail out, before it would resume.
handler handler33 for effect22 does effect21 env() ops(fn7) ret fn6

fn fn1(%0: ref i32, %1: cont() -> (i32) does effect21) -> (i32) does effect21 {
  let %2: i32 = ref_get(%0)
  let %3: i32 = add(%2, 1i32)
  let = ref_set(%0, %3)
  let %4: i32 = resume(%1)
  jump ret(%4)
}

fn fn2(%0: ref i32, %1: i32) -> (i32) {
  jump ret(%1)
}

fn fn3(%0: i32, %1: i32, %2: cont() -> (i32) does effect21) -> (i32) does effect21 {
  case %1 {
    0 => jump ret(%0)
    _ =>
      let = perform effect21.0()
      unreachable
  }
}

fn fn4(%0: i32, %1: i32, %2: i32) -> (i32) {
  jump ret(%2)
}

fn fn5(%0: cont() -> (i32)) -> (i32) {
  let %1: i32 = resume(%0)
  jump ret(%1)
}

fn fn6(%0: i32) -> (i32) {
  jump ret(%0)
}

fn fn7(%0: cont(i32) -> (i32) does effect21) -> (i32) does effect21 {
  let = perform effect21.0()
  let %1: i32 = resume(%0, 0i32)
  jump ret(%1)
}

fn fn8() -> (i32) does effect21 {
  let = perform effect21.0()
  unreachable
}

// %0 nested Count handlers, the innermost around a Count. Each level adds
// its count times its depth, so only the innermost, at depth 1, counts.
fn fn10(%0: i32) -> (i32) does effect20 + effect21 {
  case %0 {
    0 =>
      let = perform effect20.0()
      jump ret(0i32)
    _ =>
      let %1: ref i32 = ref_new(0i32)
      let %2: i32 = sub(%0, 1i32)
      let %3: imm fn() -> (i32) does effect20 + effect21 = closure fn10(%2)
      let %4: i32 = handle handler30(%1, %3)
      let %5: i32 = ref_get(%1)
      let %6: i32 = mul(%5, %0)
      let %7: i32 = add(%4, %6)
      jump ret(%7)
  }
}

// A Fail to an inner Fail 6 that fails again, to the outer Fail 5. What
// follows the inner handle never runs.
fn fn11() -> (i32) does effect21 {
  let %0: imm fn() -> (i32) does effect21 = closure fn12()
  let %1: i32 = handle handler31(5i32, 0i32, %0)
  jump ret(%1)
}

fn fn12() -> (i32) does effect21 {
  let %0: imm fn() -> (i32) does effect21 = closure fn8()
  let %1: i32 = handle handler31(6i32, 1i32, %0)
  let %2: i32 = add(%1, 1000i32)
  jump ret(%2)
}

// A Fail that an inner, resuming handler of the same effect takes first.
fn fn13() -> (i32) does effect21 {
  let %0: imm fn() -> (i32) = closure fn14()
  let %1: i32 = handle handler31(-1i32, 0i32, %0)
  jump ret(%1)
}

fn fn14() -> (i32) {
  let %0: imm fn() -> (i32) does effect21 = closure fn15()
  let %1: i32 = handle handler32(%0)
  jump ret(%1)
}

fn fn15() -> (i32) does effect21 {
  let = perform effect21.0()
  jump ret(42i32)
}

// Under Count: Fail 77 around Count around Ask, whose clause fails. The
// abort leaves the inner Count's frame behind, and the Count after it must
// go to the outer one: 77 * 10 + 1.
fn fn16() -> (i32) does effect21 {
  let %0: ref i32 = ref_new(0i32)
  let %1: imm fn() -> (i32) does effect20 + effect21 = closure fn17()
  let %2: i32 = handle handler30(%0, %1)
  let %3: i32 = ref_get(%0)
  let %4: i32 = mul(%2, 10i32)
  let %5: i32 = add(%4, %3)
  jump ret(%5)
}

fn fn17() -> (i32) does effect20 + effect21 {
  let %0: imm fn() -> (i32) does effect21 = closure fn18()
  let %1: i32 = handle handler31(77i32, 0i32, %0)
  let = perform effect20.0()
  jump ret(%1)
}

fn fn18() -> (i32) does effect21 {
  let %0: ref i32 = ref_new(0i32)
  let %1: imm fn() -> (i32) does effect21 = closure fn19()
  let %2: i32 = handle handler30(%0, %1)
  jump ret(%2)
}

fn fn19() -> (i32) does effect21 {
  let %0: imm fn() -> (i32) does effect22 = closure fn20()
  let %1: i32 = handle handler33(%0)
  jump ret(%1)
}

fn fn20() -> (i32) does effect22 {
  let %0: i32 = perform effect22.0()
  jump ret(%0)
}

// Under Count, 1000 rounds of a Fail i around a Count around a Fail: the
// sum of 0 to 999, then one Count, which must go to the outer handler:
// 499500 * 10 + 1.
fn fn21() -> (i32) does effect21 {
  let %0: ref i32 = ref_new(0i32)
  let %1: imm fn() -> (i32) does effect20 + effect21 = closure fn22()
  let %2: i32 = handle handler30(%0, %1)
  let %3: i32 = ref_get(%0)
  let %4: i32 = mul(%2, 10i32)
  let %5: i32 = add(%4, %3)
  jump ret(%5)
}

fn fn22() -> (i32) does effect20 + effect21 {
  join rec j1(%0: i32, %1: i32) =
    let %2: i32 = eq(%0, 1000i32)
    case %2 {
      1 =>
        let = perform effect20.0()
        jump ret(%1)
      _ =>
        let %3: imm fn() -> (i32) does effect21 = closure fn23()
        let %4: i32 = handle handler31(%0, 0i32, %3)
        let %5: i32 = add(%1, %4)
        let %6: i32 = add(%0, 1i32)
        jump j1(%6, %5)
    }
  in jump j1(0i32, 0i32)
}

fn fn23() -> (i32) does effect21 {
  let %0: ref i32 = ref_new(0i32)
  let %1: imm fn() -> (i32) does effect21 = closure fn8()
  let %2: i32 = handle handler30(%0, %1)
  jump ret(%2)
}

//# run fn10(1i32) == 1i32
//# run fn10(500i32) == 1i32
//# run fn11() == 5i32
//# run fn13() == 42i32
//# run fn16() == 771i32
//# run fn21() == 4995001i32
