// A return clause runs outside its handler, so a `perform` in it goes to
// the handlers further out, even for its own effect.
effect Fail {
  () -> ()
}

effect Ask {
  () -> (i32)
}

// Fail gives the environment. The return clause fails again for a
// negative result.
handler or_default for Fail does Fail env(i32) ops(fail) ret or_default_done

// Ask gives the environment. The return clause gives
// result * 1000 + what the next Ask out gives.
handler answer_more for Ask does Ask env(i32) ops(ask) ret answer_more_done

// Ask gives the environment, with the same clause.
handler answer for Ask does Ask env(i32) ops(ask) ret answer_done

fn fail(%default: i32, %k: cont() -> (i32) does Fail) -> (i32) {
  jump ret(%default)
}

fn or_default_done(%default: i32, %r: i32) -> (i32) does Fail {
  let %negative: i32 = lt.s(%r, 0i32)
  case %negative {
    1 =>
      let = perform Fail.0()
      unreachable
    _ => jump ret(%r)
  }
}

fn ask(%x: i32, %k: cont(i32) -> (i32) does Ask) -> (i32) does Ask {
  let %r: i32 = resume(%k, %x)
  jump ret(%r)
}

fn answer_more_done(%x: i32, %r: i32) -> (i32) does Ask {
  let %next: i32 = perform Ask.0()
  let %r1000: i32 = mul(%r, 1000i32)
  let %sum: i32 = add(%r1000, %next)
  jump ret(%sum)
}

fn answer_done(%x: i32, %r: i32) -> (i32) {
  jump ret(%r)
}

// Fail 100 around Fail 5 around %x: a negative %x makes the inner return
// clause fail, which the outer handler catches.
fn fail_twice(%x: i32) -> (i32) does Fail {
  let %body: imm fn() -> (i32) does Fail = closure inner_fail(%x)
  let %r: i32 = handle or_default(100i32, %body)
  jump ret(%r)
}

fn inner_fail(%x: i32) -> (i32) does Fail {
  let %body: imm fn() -> (i32) = closure id(%x)
  let %r: i32 = handle or_default(5i32, %body)
  jump ret(%r)
}

fn id(%x: i32) -> (i32) {
  jump ret(%x)
}

// Ask 9 around Ask 7 around Ask 2 around an Ask: 2, then 2 * 1000 + 7,
// then 2007 * 1000 + 9.
fn ask9() -> (i32) does Ask {
  let %body: imm fn() -> (i32) does Ask = closure ask7()
  let %r: i32 = handle answer(9i32, %body)
  jump ret(%r)
}

fn ask7() -> (i32) does Ask {
  let %body: imm fn() -> (i32) does Ask = closure ask2()
  let %r: i32 = handle answer_more(7i32, %body)
  jump ret(%r)
}

fn ask2() -> (i32) does Ask {
  let %body: imm fn() -> (i32) does Ask = closure just_ask()
  let %r: i32 = handle answer_more(2i32, %body)
  jump ret(%r)
}

fn just_ask() -> (i32) does Ask {
  let %x: i32 = perform Ask.0()
  jump ret(%x)
}

//# run fail_twice(3i32) == 3i32
//# run fail_twice(-3i32) == 100i32
//# run ask9() == 2007009i32
