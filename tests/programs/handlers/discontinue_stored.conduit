// A clause that keeps its continuation in a ref, then resumes it and
// discontinues it through the ref. The verifier only counts direct uses,
// so it's the evaluator that finds the second use and traps, and in Wasm,
// the second use of a continuation traps too. The clause isn't
// tail-resumptive, so the Wasm backend switches stacks.
effect Wait {
  () -> (i32)
}

effect Cancel {
  () -> (i32)
}

handler stored for Wait does Cancel env(i32) ops(wait) ret stored_done

handler catch_cancel for Cancel env() ops(cancel) ret id

// Resumes with 1, then discontinues with Cancel too, when %mode isn't 0.
fn wait(%mode: i32, %k: cont(i32) -> (i32) does Cancel) -> (i32) does Cancel {
  let %cell: ref cont(i32) -> (i32) does Cancel = ref_new(%k)
  let %k1: cont(i32) -> (i32) does Cancel = ref_get(%cell)
  let %r: i32 = resume(%k1, 1i32)
  case %mode {
    0 => jump ret(%r)
    _ =>
      let %k2: cont(i32) -> (i32) does Cancel = ref_get(%cell)
      let %cancelled: i32 = discontinue Cancel.0(%k2)
      jump ret(%cancelled)
  }
}

fn id(%r: i32) -> (i32) {
  jump ret(%r)
}

fn stored_done(%mode: i32, %r: i32) -> (i32) {
  jump ret(%r)
}

fn cancel(%k: cont(i32) -> (i32)) -> (i32) {
  jump ret(7i32)
}

fn just_wait() -> (i32) does Wait {
  let %x: i32 = perform Wait.0()
  jump ret(%x)
}

fn main(%mode: i32) -> (i32) {
  let %wait: imm fn() -> (i32) does Wait = closure just_wait()
  let %task: imm fn() -> (i32) does Cancel = closure scheduled(%mode, %wait)
  let %r: i32 = handle catch_cancel(%task)
  jump ret(%r)
}

fn scheduled(%mode: i32, %wait: imm fn() -> (i32) does Wait) -> (i32) does Cancel {
  let %r: i32 = handle stored(%mode, %wait)
  jump ret(%r)
}

//# run main(0i32) == 1i32
//# run main(1i32) traps
