// Corners of handler lowering: an effect with no operations, an aborting
// clause that ends in a tail call, an `i8` result stored by an abort, and
// a closure that performs after the handler it was made under is gone,
// and a clause that resumes from a loop.
effect Empty {
}

effect Fail {
  (i8) -> ()
}

effect Ask {
  () -> (i32)
}

// No operations: the body just runs, then the return clause.
handler no_ops for Empty env() ops() ret no_ops_done

// Fail gives code + 1, through a tail call.
handler fail_plus_one for Fail env() ops(fail) ret fail_done

// Ask gives the environment.
handler answer for Ask env(i32) ops(ask) ret answer_done

// Ask gives 2 to the power of the environment, which its clause works
// out in a loop that resumes when it ends.
handler power_of_two for Ask env(i32) ops(ask_power) ret answer_done

// The same, for a body that gives a closure.
handler answer_closure for Ask env(i32) ops(ask_closure) ret answer_closure_done

fn no_ops_done(%r: i32) -> (i32) {
  let %r1: i32 = add(%r, 1i32)
  jump ret(%r1)
}

fn fail(%code: i8, %k: cont() -> (i8)) -> (i8) {
  let %r: i8 = call plus_one(%code)
  jump ret(%r)
}

fn fail_done(%r: i8) -> (i8) {
  jump ret(%r)
}

fn plus_one(%x: i8) -> (i8) {
  let %y: i8 = add(%x, 1i8)
  jump ret(%y)
}

fn ask(%x: i32, %k: cont(i32) -> (i32)) -> (i32) {
  let %r: i32 = resume(%k, %x)
  jump ret(%r)
}

fn answer_done(%x: i32, %r: i32) -> (i32) {
  jump ret(%r)
}

fn no_ops_main() -> (i32) {
  let %body: imm fn() -> (i32) = closure just41()
  let %r: i32 = handle no_ops(%body)
  jump ret(%r)
}

fn just41() -> (i32) {
  jump ret(41i32)
}

// Fails with %code: 127i8 + 1 wraps to -128, which reads as 128 unsigned.
fn fail_with(%code: i8) -> (i32, i32) {
  let %body: imm fn() -> (i8) does Fail = closure do_fail(%code)
  let %r: i8 = handle fail_plus_one(%body)
  let %s: i32 = convert.s[i32](%r)
  let %u: i32 = convert.u[i32](%r)
  jump ret(%s, %u)
}

fn do_fail(%code: i8) -> (i8) does Fail {
  let = perform Fail.0(%code)
  unreachable
}

// A closure made under Ask 1 and applied under Ask 2 asks the handler
// around it when it runs: 2.
fn escapes() -> (i32) {
  let %make: imm fn() -> (imm fn() -> (i32) does Ask) = closure make()
  let %f: imm fn() -> (i32) does Ask = handle answer_closure(1i32, %make)
  let %g: imm fn() -> (i32) does Ask = closure apply_it(%f)
  let %r: i32 = handle answer(2i32, %g)
  jump ret(%r)
}

fn make() -> (imm fn() -> (i32) does Ask) {
  let %f: imm fn() -> (i32) does Ask = closure just_ask()
  jump ret(%f)
}

fn just_ask() -> (i32) does Ask {
  let %x: i32 = perform Ask.0()
  jump ret(%x)
}

fn apply_it(%f: imm fn() -> (i32) does Ask) -> (i32) does Ask {
  let %r: i32 = apply(%f)
  jump ret(%r)
}

fn ask_closure(%x: i32, %k: cont(i32) -> (imm fn() -> (i32) does Ask)) -> (imm fn() -> (i32) does Ask) {
  let %r: imm fn() -> (i32) does Ask = resume(%k, %x)
  jump ret(%r)
}

fn answer_closure_done(%x: i32, %f: imm fn() -> (i32) does Ask) -> (imm fn() -> (i32) does Ask) {
  jump ret(%f)
}

fn ask_power(%n: i32, %k: cont(i32) -> (i32)) -> (i32) {
  join rec loop(%i: i32, %acc: i32) =
    case %i {
      0 =>
        let %r: i32 = resume(%k, %acc)
        jump ret(%r)
      _ =>
        let %i1: i32 = sub(%i, 1i32)
        let %acc1: i32 = mul(%acc, 2i32)
        jump loop(%i1, %acc1)
    }
  in jump loop(%n, 1i32)
}

fn power(%n: i32) -> (i32) {
  let %body: imm fn() -> (i32) does Ask = closure just_ask()
  let %r: i32 = handle power_of_two(%n, %body)
  jump ret(%r)
}

//# run no_ops_main() == 42i32
//# run fail_with(5i8) == (6i32, 6i32)
//# run fail_with(127i8) == (-128i32, 128i32)
//# run escapes() == 2i32
//# run power(10i32) == 1024i32
