// A clause that does something after resuming needs its continuation
// captured, which the Wasm backend can't do yet.
effect effect20 {
  () -> (i32)
}

handler handler30 for effect20 env() ops(fn1) ret fn2

// Resumes with 1, then doubles what the body gave.
fn fn1(%0: cont(i32) -> (i32)) -> (i32) {
  let %1: i32 = resume(%0, 1i32)
  let %2: i32 = mul(%1, 2i32)
  jump ret(%2)
}

fn fn2(%0: i32) -> (i32) {
  jump ret(%0)
}

fn fn3() -> (i32) does effect20 {
  let %0: i32 = perform effect20.0()
  let %1: i32 = add(%0, 10i32)
  jump ret(%1)
}

fn fn0() -> (i32) {
  let %0: imm fn() -> (i32) does effect20 = closure fn3()
  let %1: i32 = handle handler30(%0)
  jump ret(%1)
}

//# run fn0() == 22i32
//# wasm-error: isn't tail-resumptive
