// A clause that does something after resuming needs its continuation
// captured, which the Wasm backend does with stack switching.
effect Ask {
  () -> (i32)
}

handler doubler for Ask env() ops(ask) ret done

// Resumes with 1, then doubles what the body gave.
fn ask(%k: cont(i32) -> (i32)) -> (i32) {
  let %x: i32 = resume(%k, 1i32)
  let %r: i32 = mul(%x, 2i32)
  jump ret(%r)
}

fn done(%r: i32) -> (i32) {
  jump ret(%r)
}

fn ask_plus_10() -> (i32) does Ask {
  let %x: i32 = perform Ask.0()
  let %r: i32 = add(%x, 10i32)
  jump ret(%r)
}

fn main() -> (i32) {
  let %body: imm fn() -> (i32) does Ask = closure ask_plus_10()
  let %r: i32 = handle doubler(%body)
  jump ret(%r)
}

//# run main() == 22i32
//# wat
