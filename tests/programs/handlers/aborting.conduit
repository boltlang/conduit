// Aborting clauses, which never resume: what they give is what the whole
// `handle` gives, without the return clause. Wasm unwinds to the `handle`
// with an exception.
effect Fail {
  () -> ()
}

effect Raise {
  (i32) -> ()
}

effect Ask {
  () -> (i32)
}

effect Stop {
  () -> ()
}

effect GetOrFail {
  () -> (i32)
  () -> ()
}

// Fail gives a default, the environment.
handler or_default for Fail env(i32) ops(fail) ret or_default_done

// Raise gives (0, the code), and a normal return (1, the result).
handler raised for Raise env() ops(raise) ret raised_done

// Ask gives the environment, resuming in tail position.
handler answer for Ask does Fail env(i32) ops(ask) ret answer_done

// Stop gives 0.
handler stopper for Stop does Fail env() ops(stop) ret stopper_done

// Get gives the environment, and Fail -1, while a return adds 1000.
handler get_or_fail for GetOrFail env(i32) ops(get, fail_get) ret get_done

fn fail(%default: i32, %k: cont() -> (i32)) -> (i32) {
  jump ret(%default)
}

fn or_default_done(%default: i32, %r: i32) -> (i32) {
  jump ret(%r)
}

fn raise(%code: i32, %k: cont() -> (i32, i64)) -> (i32, i64) {
  let %code64: i64 = convert.s[i64](%code)
  jump ret(0i32, %code64)
}

fn raised_done(%r: i32) -> (i32, i64) {
  let %r64: i64 = convert.s[i64](%r)
  jump ret(1i32, %r64)
}

fn ask(%x: i32, %k: cont(i32) -> (i32) does Fail) -> (i32) does Fail {
  let %r: i32 = resume(%k, %x)
  jump ret(%r)
}

fn answer_done(%x: i32, %r: i32) -> (i32) {
  jump ret(%r)
}

fn stop(%k: cont() -> (i32) does Fail) -> (i32) {
  jump ret(0i32)
}

fn stopper_done(%r: i32) -> (i32) {
  jump ret(%r)
}

fn get(%x: i32, %k: cont(i32) -> (i32)) -> (i32) {
  let %r: i32 = resume(%k, %x)
  jump ret(%r)
}

fn fail_get(%x: i32, %k: cont() -> (i32)) -> (i32) {
  jump ret(-1i32)
}

fn get_done(%x: i32, %r: i32) -> (i32) {
  let %r1000: i32 = add(%r, 1000i32)
  jump ret(%r1000)
}

// 100 / %x, with a default of -1 for 0.
fn hundred_over(%x: i32) -> (i32) {
  let %body: imm fn() -> (i32) does Fail = closure divide(%x)
  let %r: i32 = handle or_default(-1i32, %body)
  jump ret(%r)
}

fn divide(%x: i32) -> (i32) does Fail {
  case %x {
    0 =>
      let = perform Fail.0()
      unreachable
    _ =>
      let %q: i32 = div.s(100i32, %x)
      jump ret(%q)
  }
}

// %x back if it isn't negative, else it's raised.
fn raise_negative(%x: i32) -> (i32, i64) {
  let %body: imm fn() -> (i32) does Raise = closure check(%x)
  let %ok: i32, %code: i64 = handle raised(%body)
  jump ret(%ok, %code)
}

fn check(%x: i32) -> (i32) does Raise {
  let %negative: i32 = lt.s(%x, 0i32)
  case %negative {
    1 =>
      let = perform Raise.0(%x)
      unreachable
    _ => jump ret(%x)
  }
}

// Under Ask 7: a Fail that unwinds through Stop and Ask 1, then an Ask,
// which must find 7: -1 * 100 + 7.
fn unwinds() -> (i32) does Fail {
  let %body: imm fn() -> (i32) does Ask = closure fail_then_ask()
  let %r: i32 = handle answer(7i32, %body)
  jump ret(%r)
}

fn fail_then_ask() -> (i32) does Ask {
  let %body: imm fn() -> (i32) does Fail = closure under_ask1()
  let %failed: i32 = handle or_default(-1i32, %body)
  let %x: i32 = perform Ask.0()
  let %f100: i32 = mul(%failed, 100i32)
  let %r: i32 = add(%f100, %x)
  jump ret(%r)
}

fn under_ask1() -> (i32) does Fail {
  let %body: imm fn() -> (i32) does Fail = closure under_stop()
  let %r: i32 = handle answer(1i32, %body)
  jump ret(%r)
}

fn under_stop() -> (i32) does Fail {
  let %body: imm fn() -> (i32) does Fail = closure just_fail()
  let %r: i32 = handle stopper(%body)
  jump ret(%r)
}

fn just_fail() -> (i32) does Fail {
  let = perform Fail.0()
  unreachable
}

// One handler with a clause of each kind: 100 / Get, or -1 for 0.
fn each_kind(%x: i32) -> (i32) {
  let %body: imm fn() -> (i32) does GetOrFail = closure hundred_over_get()
  let %r: i32 = handle get_or_fail(%x, %body)
  jump ret(%r)
}

fn hundred_over_get() -> (i32) does GetOrFail {
  let %x: i32 = perform GetOrFail.0()
  case %x {
    0 =>
      let = perform GetOrFail.1()
      unreachable
    _ =>
      let %q: i32 = div.s(100i32, %x)
      jump ret(%q)
  }
}

//# run hundred_over(5i32) == 20i32
//# run hundred_over(0i32) == -1i32
//# run raise_negative(3i32) == (1i32, 3i64)
//# run raise_negative(-4i32) == (0i32, -4i64)
//# run unwinds() == -93i32
//# run each_kind(4i32) == 1025i32
//# run each_kind(0i32) == -1i32
