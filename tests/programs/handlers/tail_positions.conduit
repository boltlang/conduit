// Handlers where the code around them uses tail positions, join points,
// several kinds of value, and an environment holding a closure.
effect effect20 {                         // Ask
  () -> (i32)
}

effect effect21 {                         // Mix
  (i64, f64, i8) -> (i8, i64)
}

effect effect22 {                         // Fail
  () -> ()
}

// Ask gives f(n), from its environment: 0 for 0, and traps for -1.
handler handler30 for effect20 env(i32, imm fn(i32) -> (i32)) ops(fn1) ret fn2

// Mix gives (c + 1, a + trunc(b)).
handler handler31 for effect21 env() ops(fn3) ret fn4

// Fail gives the environment.
handler handler32 for effect22 env(i32) ops(fn5) ret fn6

// Reaches its `resume` through a join point, from two arms.
fn fn1(%0: i32, %1: imm fn(i32) -> (i32), %2: cont(i32) -> (i32)) -> (i32) {
  join j1(%3: i32) =
    let %4: i32 = resume(%2, %3)
    jump ret(%4)
  in case %0 {
    -1 => unreachable
    0 => jump j1(0i32)
    _ =>
      let %5: i32 = apply(%1, %0)
      jump j1(%5)
  }
}

fn fn2(%0: i32, %1: imm fn(i32) -> (i32), %2: i32) -> (i32) {
  jump ret(%2)
}

fn fn3(%0: i64, %1: f64, %2: i8, %3: cont(i8, i64) -> (i64)) -> (i64) {
  let %4: i8 = add(%2, 1i8)
  let %5: i64 = convert.s[i64](%1)
  let %6: i64 = add(%0, %5)
  let %7: i64 = resume(%3, %4, %6)
  jump ret(%7)
}

fn fn4(%0: i64) -> (i64) {
  jump ret(%0)
}

fn fn5(%0: i32, %1: cont() -> (i32)) -> (i32) {
  jump ret(%0)
}

fn fn6(%0: i32, %1: i32) -> (i32) {
  jump ret(%1)
}

fn fn7(%0: i32) -> (i32) {
  let %1: i32 = mul(%0, 2i32)
  jump ret(%1)
}

// A `perform` in tail position.
fn fn8() -> (i32) does effect20 {
  let %0: i32 = perform effect20.0()
  jump ret(%0)
}

// A tail call of a function that performs.
fn fn9() -> (i32) does effect20 {
  let %0: i32 = call fn8()
  jump ret(%0)
}

// A `handle` in tail position: 2 * %0.
fn fn10(%0: i32) -> (i32) {
  let %1: imm fn(i32) -> (i32) = closure fn7()
  let %2: imm fn() -> (i32) does effect20 = closure fn9()
  let %3: i32 = handle handler30(%0, %1, %2)
  jump ret(%3)
}

// 127i8 + 1 wraps to -128, and 40 + trunc(2.9) is 42: -86.
fn fn11() -> (i64) {
  let %0: imm fn() -> (i64) does effect21 = closure fn12()
  let %1: i64 = handle handler31(%0)
  jump ret(%1)
}

fn fn12() -> (i64) does effect21 {
  let %0: i8, %1: i64 = perform effect21.0(40i64, 2.9f64, 127i8)
  let %2: i64 = convert.s[i64](%0)
  let %3: i64 = add(%2, %1)
  jump ret(%3)
}

// An aborting handler in tail position: -1 for 0, else %0 * 10.
fn fn13(%0: i32) -> (i32) {
  let %1: imm fn() -> (i32) does effect22 = closure fn14(%0)
  let %2: i32 = handle handler32(-1i32, %1)
  jump ret(%2)
}

fn fn14(%0: i32) -> (i32) does effect22 {
  case %0 {
    0 =>
      let = perform effect22.0()
      unreachable
    _ =>
      let %1: i32 = mul(%0, 10i32)
      jump ret(%1)
  }
}

//# run fn10(5i32) == 10i32
//# run fn10(0i32) == 0i32
//# run fn10(-1i32) traps
//# run fn11() == -86i64
//# run fn13(0i32) == -1i32
//# run fn13(4i32) == 40i32
