// Handlers where the code around them uses tail positions, join points,
// several kinds of value, and an environment holding a closure.
effect Ask {
  () -> (i32)
}

effect Mix {
  (i64, f64, i8) -> (i8, i64)
}

effect Fail {
  () -> ()
}

// Ask gives f(n), from its environment: 0 for 0, and traps for -1.
handler asker for Ask env(i32, imm fn(i32) -> (i32)) ops(ask) ret asker_done

// Mix gives (c + 1, a + trunc(b)).
handler mixer for Mix env() ops(mix) ret mixer_done

// Fail gives the environment.
handler or_default for Fail env(i32) ops(fail) ret or_default_done

// Reaches its `resume` through a join point, from two arms.
fn ask(%n: i32, %f: imm fn(i32) -> (i32), %k: cont(i32) -> (i32)) -> (i32) {
  join give(%x: i32) =
    let %r: i32 = resume(%k, %x)
    jump ret(%r)
  in case %n {
    -1 => unreachable
    0 => jump give(0i32)
    _ =>
      let %y: i32 = apply(%f, %n)
      jump give(%y)
  }
}

fn asker_done(%n: i32, %f: imm fn(i32) -> (i32), %r: i32) -> (i32) {
  jump ret(%r)
}

fn mix(%a: i64, %b: f64, %c: i8, %k: cont(i8, i64) -> (i64)) -> (i64) {
  let %c1: i8 = add(%c, 1i8)
  let %b64: i64 = convert.s[i64](%b)
  let %sum: i64 = add(%a, %b64)
  let %r: i64 = resume(%k, %c1, %sum)
  jump ret(%r)
}

fn mixer_done(%r: i64) -> (i64) {
  jump ret(%r)
}

fn fail(%default: i32, %k: cont() -> (i32)) -> (i32) {
  jump ret(%default)
}

fn or_default_done(%default: i32, %r: i32) -> (i32) {
  jump ret(%r)
}

fn double(%x: i32) -> (i32) {
  let %y: i32 = mul(%x, 2i32)
  jump ret(%y)
}

// A `perform` in tail position.
fn ask_tail() -> (i32) does Ask {
  let %x: i32 = perform Ask.0()
  jump ret(%x)
}

// A tail call of a function that performs.
fn call_tail() -> (i32) does Ask {
  let %x: i32 = call ask_tail()
  jump ret(%x)
}

// A `handle` in tail position: 2 * %n.
fn handle_tail(%n: i32) -> (i32) {
  let %f: imm fn(i32) -> (i32) = closure double()
  let %body: imm fn() -> (i32) does Ask = closure call_tail()
  let %r: i32 = handle asker(%n, %f, %body)
  jump ret(%r)
}

// 127i8 + 1 wraps to -128, and 40 + trunc(2.9) is 42: -86.
fn mixed() -> (i64) {
  let %body: imm fn() -> (i64) does Mix = closure do_mix()
  let %r: i64 = handle mixer(%body)
  jump ret(%r)
}

fn do_mix() -> (i64) does Mix {
  let %c: i8, %sum: i64 = perform Mix.0(40i64, 2.9f64, 127i8)
  let %c64: i64 = convert.s[i64](%c)
  let %r: i64 = add(%c64, %sum)
  jump ret(%r)
}

// An aborting handler in tail position: -1 for 0, else %x * 10.
fn aborting_tail(%x: i32) -> (i32) {
  let %body: imm fn() -> (i32) does Fail = closure fail_on_zero(%x)
  let %r: i32 = handle or_default(-1i32, %body)
  jump ret(%r)
}

fn fail_on_zero(%x: i32) -> (i32) does Fail {
  case %x {
    0 =>
      let = perform Fail.0()
      unreachable
    _ =>
      let %y: i32 = mul(%x, 10i32)
      jump ret(%y)
  }
}

//# run handle_tail(5i32) == 10i32
//# run handle_tail(0i32) == 0i32
//# run handle_tail(-1i32) traps
//# run mixed() == -86i64
//# run aborting_tail(0i32) == -1i32
//# run aborting_tail(4i32) == 40i32
