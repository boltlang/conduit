// An `apply` of a closure made here is a call of its function, with the
// captures first. With all passes, the call is then inlined and the
// closure is dead. The `closures` pass alone leaves the `apply` of a
// closure that comes into a join point; all passes inline the join point
// first, and then it goes too.

fn times(%n: i32, %x: i32) -> (i32) {
  let %product: i32 = mul(%x, %n)
  jump ret(%product)
}

fn times3_twice(%x: i32) -> (i32) {
  let %times3: imm fn(i32) -> (i32) = closure times(3i32)
  let %once: i32 = apply(%times3, %x)
  let %twice: i32 = apply(%times3, %once)
  jump ret(%twice)
}

fn through_join(%x: i32) -> (i32) {
  join j1(%f: imm fn(i32) -> (i32)) =
    let %r: i32 = apply(%f, %x)
    jump ret(%r)
  in
  let %c: imm fn(i32) -> (i32) = closure times(%x)
  jump j1(%c)
}

// A generic function's closure keeps its mutability arguments.
fn at['m1](%xs: 'm1 [i32], %i: i32) -> (i32) {
  let %x: i32 = array_get(%xs, %i)
  jump ret(%x)
}

fn at1(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(3i32, %x)
  let %at1: mut fn(i32) -> (i32) = closure at[mut](%xs)
  let %r: i32 = apply(%at1, 1i32)
  jump ret(%r)
}

//# run times3_twice(2i32) == 18i32
//# run through_join(4i32) == 16i32
//# run at1(6i32) == 6i32
//# opt: closures
//# opt
