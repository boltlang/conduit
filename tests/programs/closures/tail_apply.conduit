// An `apply` in tail position is a `return_call_indirect` in Wasm.

fn adder(%n: i32, %x: i32) -> (i32) {
  let %sum: i32 = add(%x, %n)
  jump ret(%sum)
}

fn add(%n: i32, %x: i32) -> (i32) {
  let %add_n: imm fn(i32) -> (i32) = closure adder(%n)
  let %r: i32 = apply(%add_n, %x)
  jump ret(%r)
}

