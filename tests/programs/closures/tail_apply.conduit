// An `apply` in tail position is a `return_call_ref` in Wasm.

fn fn0(%0: i32, %1: i32) -> (i32) {
  let %2: i32 = add(%1, %0)
  jump ret(%2)
}

fn fn1(%0: i32, %1: i32) -> (i32) {
  let %2: imm fn(i32) -> (i32) = closure fn0(%0)
  let %3: i32 = apply(%2, %1)
  jump ret(%3)
}

//# run fn1(3i32, 4i32) == 7i32
//# wat
