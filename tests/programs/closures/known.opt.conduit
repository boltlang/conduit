// after closures

fn times(%n: i32, %x: i32) -> (i32) {
  let %product: i32 = mul(%x, %n)
  jump ret(%product)
}

fn times3_twice(%x: i32) -> (i32) {
  let %times3: imm fn(i32) -> (i32) = closure times(3i32)
  let %once: i32 = call times(3i32, %x)
  let %twice: i32 = call times(3i32, %once)
  jump ret(%twice)
}

fn through_join(%x: i32) -> (i32) {
  join j1(%f: imm fn(i32) -> (i32)) =
    let %r: i32 = apply(%f, %x)
    jump ret(%r)
  in
  let %c: imm fn(i32) -> (i32) = closure times(%x)
  jump j1(%c)
}

fn at['m1](%xs: 'm1 [i32], %i: i32) -> (i32) {
  let %x: i32 = array_get(%xs, %i)
  jump ret(%x)
}

fn at1(%x: i32) -> (i32) {
  let %xs: mut [i32] = array_fill(3i32, %x)
  let %at1: mut fn(i32) -> (i32) = closure at[mut](%xs)
  let %r: i32 = call at[mut](%xs, 1i32)
  jump ret(%r)
}

// after all passes

fn times(%n: i32, %x: i32) -> (i32) {
  let %product: i32 = mul(%x, %n)
  jump ret(%product)
}

fn times3_twice(%x: i32) -> (i32) vars(%times3: imm fn(i32) -> (i32), %twice#3: i32) {
  join j1(%once: i32) =
    let %product#4: i32 = mul(%once, 3i32)
    jump ret(%product#4)
  in
  let %product#5: i32 = mul(%x, 3i32)
  jump j1(%product#5)
}

fn through_join(%x: i32) -> (i32) {
  join j1(%f: imm fn(i32) -> (i32)) =
    let %r: i32 = apply(%f, %x)
    jump ret(%r)
  in
  let %c: imm fn(i32) -> (i32) = closure times(%x)
  jump j1(%c)
}

fn at['m1](%xs: 'm1 [i32], %i: i32) -> (i32) {
  let %x: i32 = array_get(%xs, %i)
  jump ret(%x)
}

fn at1(%x#0: i32) -> (i32) vars(%at1#2: mut fn(i32) -> (i32), %r#3: i32) {
  let %xs: mut [i32] = array_fill(3i32, %x#0)
  let %x#4: i32 = array_get(%xs, 1i32)
  jump ret(%x#4)
}
