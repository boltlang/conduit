// Two closures of the same signature with different captures, applied
// through the same join point.

// adder(n, x) = x + n
fn fn0(%0: i32, %1: i32) -> (i32) {
  let %2: i32 = add(%1, %0)
  jump ret(%2)
}

// multiplier(n, x) = x * n
fn fn1(%0: i32, %1: i32) -> (i32) {
  let %2: i32 = mul(%1, %0)
  jump ret(%2)
}

// pick(b, n, x) = (if b { adder(n) } else { multiplier(n) })(x) + 1
fn fn2(%0: i32, %1: i32, %2: i32) -> (i32) {
  join j1(%3: imm fn(i32) -> (i32)) =
    let %4: i32 = apply(%3, %2)
    let %5: i32 = add(%4, 1i32)
    jump ret(%5)
  in
  case %0 {
    1 =>
      let %6: imm fn(i32) -> (i32) = closure fn0(%1)
      jump j1(%6)
    _ =>
      let %7: imm fn(i32) -> (i32) = closure fn1(%1)
      jump j1(%7)
  }
}

//# run fn2(1i32, 3i32, 4i32) == 8i32
//# run fn2(0i32, 3i32, 4i32) == 13i32
