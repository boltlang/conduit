// Two closures of the same signature with different captures, applied
// through the same join point.

// adder(n, x) = x + n
fn adder(%n: i32, %x: i32) -> (i32) {
  let %sum: i32 = add(%x, %n)
  jump ret(%sum)
}

// multiplier(n, x) = x * n
fn multiplier(%n: i32, %x: i32) -> (i32) {
  let %product: i32 = mul(%x, %n)
  jump ret(%product)
}

// pick(b, n, x) = (if b { adder(n) } else { multiplier(n) })(x) + 1
fn pick(%b: i32, %n: i32, %x: i32) -> (i32) {
  join apply(%f: imm fn(i32) -> (i32)) =
    let %r: i32 = apply(%f, %x)
    let %r1: i32 = add(%r, 1i32)
    jump ret(%r1)
  in
  case %b {
    1 =>
      let %add_n: imm fn(i32) -> (i32) = closure adder(%n)
      jump apply(%add_n)
    _ =>
      let %times_n: imm fn(i32) -> (i32) = closure multiplier(%n)
      jump apply(%times_n)
  }
}

//# run pick(1i32, 3i32, 4i32) == 8i32
//# run pick(0i32, 3i32, 4i32) == 13i32
