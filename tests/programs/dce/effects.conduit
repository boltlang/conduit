// Unused `new`s, closures and refs are pure and go, and so do unused
// reads, which never trap, and unsigned divisions and every remainder,
// which don't trap, even by zero. Calls, writes, array accesses and signed
// divisions, which can trap, stay, and so does the `new` whose object is
// written.

data Pair {
  (i32, i32)
}

fn main(%x: i32) -> (i32) {
  let %written: mut Pair = new Pair.0(%x, %x)
  let = set Pair.0.0(%written, 1i32)
  let %unused_new: imm Pair = new Pair.0(1i32, 2i32)
  let %closure: imm fn() -> (i32) = closure id2(%x)
  let %cell: ref i32 = ref_new(%x)
  let %called: i32 = call id(%x)
  let %read_field: i32 = get Pair.0.1(%written)
  let %read_cell: i32 = ref_get(%cell)
  let %array: mut [i32] = array_fill(2i32, %x)
  let %length: i32 = array_len(%array)
  let %cloned: imm [i32] = array_clone(%array)
  let %element: i32 = array_get(%array, 1i32)
  let %by_zero: i32 = div.u(%x, 0i32)
  let %rem: i32 = rem.s(%x, %x)
  let %div: i32 = div.s(%x, %x)
  jump ret(%x)
}

fn id(%x: i32) -> (i32) {
  jump ret(%x)
}

fn id2(%x: i32) -> (i32) {
  jump ret(%x)
}

//# run main(3i32) == 3i32
//# opt: dce
