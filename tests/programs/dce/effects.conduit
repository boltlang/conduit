// Unused `new`s, closures and refs are pure and go, and so do unused
// reads, which never trap, and unsigned divisions and remainders, which
// don't trap even by zero. Calls, writes, array accesses and signed
// divisions, which can trap, stay, and so does the `new` whose object is
// written.

data data0 {
  (i32, i32)
}

fn fn0(%0: i32) -> (i32) {
  let %1: mut data0 = new data0.0(%0, %0)
  let = set data0.0.0(%1, 1i32)
  let %2: imm data0 = new data0.0(1i32, 2i32)
  let %3: imm fn() -> (i32) = closure fn2(%0)
  let %4: ref i32 = ref_new(%0)
  let %5: i32 = call fn1(%0)
  let %6: i32 = get data0.0.1(%1)
  let %7: i32 = ref_get(%4)
  let %8: mut [i32] = array_fill(2i32, %0)
  let %9: i32 = array_len(%8)
  let %10: imm [i32] = array_clone(%8)
  let %11: i32 = array_get(%8, 1i32)
  let %12: i32 = div.u(%0, 0i32)
  let %13: i32 = rem.s(%0, %0)
  let %14: i32 = div.s(%0, %0)
  jump ret(%0)
}

fn fn1(%0: i32) -> (i32) {
  jump ret(%0)
}

fn fn2(%0: i32) -> (i32) {
  jump ret(%0)
}

//# run fn0(3i32) == 3i32
//# opt: dce
