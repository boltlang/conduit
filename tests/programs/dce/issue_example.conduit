// The example from issue #5: the unused join point and `add` go, and
// `div.s` stays even though its result is unused, because it can trap: on
// the smallest value divided by -1, not by zero.

fn fn0(%0: i32, %1: i32) -> (i32) {
  join j1() = jump ret(0i32)
  in
  let %2: i32 = add(%0, 1i32)
  let %3: i32 = div.s(%0, %1)
  let %4: i32 = mul(%0, 2i32)
  jump ret(%4)
}

//# run fn0(6i32, 3i32) == 12i32
//# run fn0(6i32, 0i32) == 12i32
//# run fn0(-2147483648i32, -1i32) traps
//# opt: dce
