// The example from issue #5: the unused join point and `add` go, and
// `div.s` stays even though its result is unused, because it can trap: on
// the smallest value divided by -1, not by zero.

fn main(%x: i32, %y: i32) -> (i32) {
  join unused() = jump ret(0i32)
  in
  let %x1: i32 = add(%x, 1i32)
  let %q: i32 = div.s(%x, %y)
  let %x2: i32 = mul(%x, 2i32)
  jump ret(%x2)
}

//# run main(6i32, 3i32) == 12i32
//# run main(6i32, 0i32) == 12i32
//# run main(-2147483648i32, -1i32) traps
//# opt: dce
