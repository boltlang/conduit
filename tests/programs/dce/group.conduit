// In a group of recursive join points, the ones reached from the body
// stay, even when only reached through each other, and the rest go.

fn fn0(%0: i32) -> (i32) {
  join rec j3() = jump j1(0i32)
  and j1(%1: i32) =
    case %1 {
      0 => jump ret(1i32)
      _ =>
        let %2: i32 = sub(%1, 1i32)
        jump j2(%2)
    }
  and j2(%3: i32) =
    case %3 {
      0 => jump ret(0i32)
      _ =>
        let %4: i32 = sub(%3, 1i32)
        jump j1(%4)
    }
  in jump j1(%0)
}

//# run fn0(0i32) == 1i32
//# run fn0(7i32) == 0i32
//# run fn0(10i32) == 1i32
//# opt: dce
