data Pair {
  (i32, i32)
}

fn main(%x: i32) -> (i32) {
  let %written: mut Pair = new Pair.0(%x, %x)
  let = set Pair.0.0(%written, 1i32)
  let %called: i32 = call id(%x)
  let %array: mut [i32] = array_fill(2i32, %x)
  let %element: i32 = array_get(%array, 1i32)
  let %div: i32 = div.s(%x, %x)
  jump ret(%x)
}

fn id(%x: i32) -> (i32) {
  jump ret(%x)
}

fn id2(%x: i32) -> (i32) {
  jump ret(%x)
}
