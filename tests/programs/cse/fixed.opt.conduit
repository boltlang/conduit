data Pair {
  (i32, i32)
}

fn arith(%x: i32, %y: i32) -> (i32) {
  let %sum: i32 = add(%x, %y)
  let %q: i32 = div.s(%x, %y)
  let %r: i32 = add(%q, %q)
  jump ret(%r)
}

fn objects(%x: i32) -> (i32) {
  let %imm1: imm Pair = new Pair.0(%x, 1i32)
  let %mut1: mut Pair = new Pair.0(%x, 1i32)
  let %mut2: mut Pair = new Pair.0(%x, 1i32)
  let = set Pair.0.0(%mut1, 5i32)
  let %a: i32 = get Pair.0.0(%mut2)
  let %cell1: ref i32 = ref_new(%x)
  let %cell2: ref i32 = ref_new(%x)
  let = ref_set(%cell1, 9i32)
  let %b: i32 = ref_get(%cell2)
  let %f1: imm fn(i32) -> (i32) = closure adder(%x)
  let %c: i32 = get Pair.0.1(%imm1)
  let %ab: i32 = add(%a, %b)
  let %abc: i32 = add(%ab, %c)
  jump ret(%abc)
}

fn arms(%x: i32, %y: i32) -> (i32) {
  let %xy: i32 = mul(%x, %y)
  case %x {
    0 =>
      let %y0: i32 = sub(%y, 1i32)
      jump ret(%y0)
    _ =>
      let %y1: i32 = sub(%y, 1i32)
      let %r: i32 = add(%y1, %xy)
      jump ret(%r)
  }
}

fn adder(%n: i32, %x: i32) -> (i32) {
  let %sum: i32 = add(%n, %x)
  jump ret(%sum)
}
