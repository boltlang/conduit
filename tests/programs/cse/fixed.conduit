// Ops whose results can't change are shared with an earlier one on every
// path to them: arithmetic, a division that may trap, an `imm` object, a
// closure and a constant. A `mut` object and a ref are new each time, and an arm can't
// share with its sibling.

data Pair {
  (i32, i32)
}

const pair: imm Pair = Pair.0(2i32, 3i32)

fn arith(%x: i32, %y: i32) -> (i32) {
  let %sum: i32 = add(%x, %y)
  let %sum2: i32 = add(%x, %y)
  let %q: i32 = div.s(%x, %y)
  let %q2: i32 = div.s(%x, %y)
  let %r: i32 = add(%q, %q2)
  jump ret(%r)
}

fn objects(%x: i32) -> (i32) {
  let %imm1: imm Pair = new Pair.0(%x, 1i32)
  let %imm2: imm Pair = new Pair.0(%x, 1i32)
  let %mut1: mut Pair = new Pair.0(%x, 1i32)
  let %mut2: mut Pair = new Pair.0(%x, 1i32)
  let = set Pair.0.0(%mut1, 5i32)
  let %a: i32 = get Pair.0.0(%mut2)
  let %cell1: ref i32 = ref_new(%x)
  let %cell2: ref i32 = ref_new(%x)
  let = ref_set(%cell1, 9i32)
  let %b: i32 = ref_get(%cell2)
  let %f1: imm fn(i32) -> (i32) = closure adder(%x)
  let %f2: imm fn(i32) -> (i32) = closure adder(%x)
  let %c: i32 = get Pair.0.1(%imm2)
  let %ab: i32 = add(%a, %b)
  let %abc: i32 = add(%ab, %c)
  jump ret(%abc)
}

// A nested arm shares with the block around it, but not with its sibling.
fn arms(%x: i32, %y: i32) -> (i32) {
  let %xy: i32 = mul(%x, %y)
  case %x {
    0 =>
      let %xy0: i32 = mul(%x, %y)
      let %y0: i32 = sub(%y, 1i32)
      jump ret(%y0)
    _ =>
      let %y1: i32 = sub(%y, 1i32)
      let %xy1: i32 = mul(%x, %y)
      let %r: i32 = add(%y1, %xy1)
      jump ret(%r)
  }
}

fn adder(%n: i32, %x: i32) -> (i32) {
  let %sum: i32 = add(%n, %x)
  jump ret(%sum)
}

fn consts() -> (i32) {
  let %p1: imm Pair = const pair()
  let %p2: imm Pair = const pair()
  let %a: i32 = get Pair.0.0(%p1)
  let %b: i32 = get Pair.0.1(%p2)
  let %r: i32 = add(%a, %b)
  jump ret(%r)
}

//# run arith(6i32, 3i32) == 4i32
//# run arith(-2147483648i32, -1i32) traps
//# run objects(4i32) == 9i32
//# run arms(0i32, 3i32) == 2i32
//# run arms(2i32, 3i32) == 8i32
//# run consts() == 5i32
//# opt: cse
