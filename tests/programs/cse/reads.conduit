// A read of what can change is shared only while nothing may write: a
// `set`, an array write or a call stops it, though a read of what the
// write wrote gives that. A read of what can't change is shared across
// those. Nor is a read carried into a join point, which anything may have
// run before a jump to.

data Pair {
  (i32, i32)
}

fn fields(%p: mut Pair, %q: imm Pair) -> (i32) {
  let %a: i32 = get Pair.0.0(%p)
  let %a2: i32 = get Pair.0.0(%p)
  let %b: i32 = get Pair.0.0(%q)
  let = set Pair.0.0(%p, 7i32)
  let %a3: i32 = get Pair.0.0(%p)
  let %b2: i32 = get Pair.0.0(%q)
  let %aa: i32 = add(%a, %a2)
  let %ba: i32 = add(%b, %a3)
  let %aaba: i32 = add(%aa, %ba)
  let %r: i32 = add(%aaba, %b2)
  jump ret(%r)
}

fn elements(%xs: mut [i32]) -> (i32) {
  let %a: i32 = array_get(%xs, 0i32)
  let %n: i32 = array_len(%xs)
  let = array_set(%xs, 0i32, 5i32)
  let %a2: i32 = array_get(%xs, 0i32)
  let %n2: i32 = array_len(%xs)
  let %c1: imm [i32] = array_clone(%xs)
  let %c2: imm [i32] = array_clone(%xs)
  let %b1: i32 = array_get(%c1, 0i32)
  let %b2: i32 = array_get(%c2, 0i32)
  let %written: i32 = call write100(%xs)
  let %a3: i32 = array_get(%xs, 0i32)
  let %b3: i32 = array_get(%c1, 0i32)
  let %s1: i32 = add(%a, %n)
  let %s2: i32 = add(%a2, %n2)
  let %s3: i32 = add(%b1, %b2)
  let %s4: i32 = add(%a3, %b3)
  let %s5: i32 = add(%s1, %s2)
  let %s6: i32 = add(%s3, %s4)
  let %r: i32 = add(%s5, %s6)
  jump ret(%r)
}

// The loop writes the ref on each round, so its read stays, and the
// `imm` field read is shared.
fn loop_reads(%cell: ref i32, %p: imm Pair) -> (i32) {
  let %before: i32 = ref_get(%cell)
  let %y: i32 = get Pair.0.1(%p)
  join rec loop(%i: i32) =
    let %x: i32 = ref_get(%cell)
    let %y2: i32 = get Pair.0.1(%p)
    let %sum: i32 = add(%x, %y2)
    let = ref_set(%cell, %sum)
    case %i {
      0 => jump ret(%sum)
      _ =>
        let %i1: i32 = sub(%i, 1i32)
        jump loop(%i1)
    }
  in
  jump loop(%y)
}

fn write100(%xs: mut [i32]) -> (i32) {
  let = array_set(%xs, 0i32, 100i32)
  jump ret(0i32)
}

fn main_fields(%x: i32) -> (i32) {
  let %p: mut Pair = new Pair.0(%x, 1i32)
  let %q: imm Pair = new Pair.0(10i32, 2i32)
  let %r: i32 = call fields(%p, %q)
  jump ret(%r)
}

fn main_elements() -> (i32) {
  let %xs: mut [i32] = array_fill(2i32, 1i32)
  let %r: i32 = call elements(%xs)
  jump ret(%r)
}

fn main_loop() -> (i32) {
  let %cell: ref i32 = ref_new(1i32)
  let %p: imm Pair = new Pair.0(0i32, 3i32)
  let %r: i32 = call loop_reads(%cell, %p)
  jump ret(%r)
}

//# run main_fields(4i32) == 35i32
//# run main_elements() == 125i32
//# run main_loop() == 13i32
//# opt: cse
