// A read of what was just written gives what was written, until something
// may write: after `set`, `array_set` and `ref_set`, and right after a
// `mut` object, a `mut` array or a ref is made. A read after another
// write, or a call, stays.

data Pair {
  (i32, i32)
}

fn fields(%p: mut Pair, %x: i32) -> (i32) {
  let = set Pair.0.1(%p, %x)
  let %a: i32 = get Pair.0.1(%p)
  let %q: mut Pair = new Pair.0(3i32, 4i32)
  let %b: i32 = get Pair.0.0(%q)
  let = set Pair.0.0(%p, 9i32)
  let %c: i32 = get Pair.0.0(%q)
  let %ab: i32 = add(%a, %b)
  let %r: i32 = add(%ab, %c)
  jump ret(%r)
}

fn elements(%xs: mut [i32], %i: i32) -> (i32) {
  let = array_set(%xs, %i, 6i32)
  let %a: i32 = array_get(%xs, %i)
  let %ys: mut [i32] = array_new(1i32, 2i32)
  let %b: i32 = array_get(%ys, 1i32)
  let %w: i32 = call write(%ys)
  let %c: i32 = array_get(%ys, 1i32)
  let %ab: i32 = add(%a, %b)
  let %r: i32 = add(%ab, %c)
  jump ret(%r)
}

// A ref that escapes into a call isn't promoted, but its reads right
// after a write still give what was written.
fn refs(%x: i32) -> (i32) {
  let %r: ref i32 = ref_new(%x)
  let %a: i32 = ref_get(%r)
  let = call bump(%r)
  let %b: i32 = ref_get(%r)
  let = ref_set(%r, 20i32)
  let %c: i32 = ref_get(%r)
  let %ab: i32 = add(%a, %b)
  let %s: i32 = add(%ab, %c)
  jump ret(%s)
}

fn write(%xs: mut [i32]) -> (i32) {
  let = array_set(%xs, 1i32, 50i32)
  jump ret(0i32)
}

fn bump(%r: ref i32) -> () {
  let %x: i32 = ref_get(%r)
  let %y: i32 = add(%x, 1i32)
  let = ref_set(%r, %y)
  jump ret()
}

fn main_fields(%x: i32) -> (i32) {
  let %p: mut Pair = new Pair.0(0i32, 0i32)
  let %r: i32 = call fields(%p, %x)
  jump ret(%r)
}

fn main_elements() -> (i32) {
  let %xs: mut [i32] = array_fill(3i32, 0i32)
  let %r: i32 = call elements(%xs, 2i32)
  jump ret(%r)
}

//# run main_fields(5i32) == 11i32
//# run main_elements() == 58i32
//# run refs(1i32) == 23i32
//# opt: cse
