// Inlining into a clause, and inlining a function that performs into the
// body of a handler: the clause stays tail-resumptive, and the `perform`
// still finds the handler around it.
effect Ask {
  () -> (i32)
}

handler tenfold for Ask env(i32) ops(ask) ret done

fn ten_times(%x: i32) -> (i32) {
  let %y: i32 = mul(%x, 10i32)
  jump ret(%y)
}

fn ask(%x: i32, %k: cont(i32) -> (i32)) -> (i32) {
  let %y: i32 = call ten_times(%x)
  let %r: i32 = resume(%k, %y)
  jump ret(%r)
}

fn done(%x: i32, %r: i32) -> (i32) {
  jump ret(%r)
}

fn ask_plus_one() -> (i32) does Ask {
  let %x: i32 = perform Ask.0()
  let %y: i32 = add(%x, 1i32)
  jump ret(%y)
}

fn ask_twice() -> (i32) does Ask {
  let %a: i32 = call ask_plus_one()
  let %b: i32 = call ask_plus_one()
  let %r: i32 = add(%a, %b)
  jump ret(%r)
}

fn main(%x: i32) -> (i32) {
  let %body: imm fn() -> (i32) does Ask = closure ask_twice()
  let %r: i32 = handle tenfold(%x, %body)
  jump ret(%r)
}

//# run main(4i32) == 82i32
//# opt: inline
//# opt
