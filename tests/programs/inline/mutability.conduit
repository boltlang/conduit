// A callee with a mutability parameter, inlined at `mut` and at `imm`:
// its types and the mutability arguments of its calls get the call's
// mutability. `round_trip`, which boxes at its parameter, isn't inlined.
fn fill7['m1](%n: i32) -> ('m1 [i32]) {
  let %xs: 'm1 [i32] = array_fill(%n, 7i32)
  let %ys: 'm1 [i32] = call round_trip['m1](%xs)
  jump ret(%ys)
}

// Takes a `ro` view, given an `imm` array.
fn length(%xs: ro [i32]) -> (i32) {
  let %n: i32 = array_len(%xs)
  jump ret(%n)
}

fn main() -> (i32) {
  let %xs: mut [i32] = call fill7[mut](2i32)
  let = array_set(%xs, 0i32, 1i32)
  let %ys: imm [i32] = call fill7[imm](3i32)
  let %n: i32 = call length(%ys)
  let %x: i32 = array_get(%xs, 0i32)
  let %r: i32 = add(%n, %x)
  jump ret(%r)
}

// Boxes and unboxes.
fn round_trip['m1](%xs: 'm1 [i32]) -> ('m1 [i32]) {
  let %boxed: mut any = box['m1 [i32]](%xs)
  let %ys: 'm1 [i32] = unbox['m1 [i32]](%boxed)
  jump ret(%ys)
}

//# run main() == 4i32
//# opt: inline
