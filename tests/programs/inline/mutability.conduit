// A callee with a mutability parameter, inlined at `mut` and at `imm`:
// its types, the mutability arguments of its calls, and its `unbox` get
// the call's mutability.
fn fn0['m1](%0: i32) -> ('m1 [i32]) {
  let %1: 'm1 [i32] = array_fill(%0, 7i32)
  let %2: 'm1 [i32] = call fn3['m1](%1)
  jump ret(%2)
}

// Takes a `ro` view, given an `imm` array.
fn fn1(%0: ro [i32]) -> (i32) {
  let %1: i32 = array_len(%0)
  jump ret(%1)
}

fn fn2() -> (i32) {
  let %0: mut [i32] = call fn0[mut](2i32)
  let = array_set(%0, 0i32, 1i32)
  let %1: imm [i32] = call fn0[imm](3i32)
  let %2: i32 = call fn1(%1)
  let %3: i32 = array_get(%0, 0i32)
  let %4: i32 = add(%2, %3)
  jump ret(%4)
}

// Boxes and unboxes.
fn fn3['m1](%0: 'm1 [i32]) -> ('m1 [i32]) {
  let %1: mut any = box['m1 [i32]](%0)
  let %2: 'm1 [i32] = unbox['m1 [i32]](%1)
  jump ret(%2)
}

//# run fn2() == 4i32
//# opt: inline
