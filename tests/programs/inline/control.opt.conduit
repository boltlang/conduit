fn fn0(%0: i32, %1: i32) -> (i32, i32) {
  join rec j1(%2: i32, %3: i32) =
    let %4: i32 = ge.s(%2, %0)
    case %4 {
      1 => jump ret(%3, %2)
      _ =>
        let %5: i32 = add(%2, 1i32)
        let %6: i32 = add(%3, %1)
        jump j1(%5, %6)
    }
  in jump j1(0i32, 0i32)
}

fn fn1() -> (i32) {
  join j3(%0: i32, %1: i32) =
    join j1(%2: i32, %3: i32) =
      let %4: i32 = add(%0, %2)
      let %5: i32 = add(%1, %3)
      let %6: i32 = add(%4, %5)
      jump ret(%6)
    in
    join rec j2(%7: i32, %8: i32) =
      let %9: i32 = ge.s(%7, 5i32)
      case %9 {
        1 => jump j1(%8, %7)
        _ =>
          let %10: i32 = add(%7, 1i32)
          let %11: i32 = add(%8, 3i32)
          jump j2(%10, %11)
      }
    in jump j2(0i32, 0i32)
  in
  join rec j4(%12: i32, %13: i32) =
    let %14: i32 = ge.s(%12, 4i32)
    case %14 {
      1 => jump j3(%13, %12)
      _ =>
        let %15: i32 = add(%12, 1i32)
        let %16: i32 = add(%13, 3i32)
        jump j4(%15, %16)
    }
  in jump j4(0i32, 0i32)
}
