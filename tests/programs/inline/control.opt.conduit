fn times(%n: i32, %x: i32) -> (i32, i32) {
  join rec loop(%i: i32, %acc: i32) =
    let %done: i32 = ge.s(%i, %n)
    case %done {
      1 => jump ret(%acc, %i)
      _ =>
        let %i1: i32 = add(%i, 1i32)
        let %acc1: i32 = add(%acc, %x)
        jump loop(%i1, %acc1)
    }
  in jump loop(0i32, 0i32)
}

#[export(emu)]
fn main() -> (i32) {
  join j1(%a: i32, %i#1: i32) =
    join j2(%b: i32, %j: i32) =
      let %ab: i32 = add(%a, %b)
      let %ij: i32 = add(%i#1, %j)
      let %r: i32 = add(%ab, %ij)
      jump ret(%r)
    in
    join rec loop#3(%i#7: i32, %acc#8: i32) =
      let %done#9: i32 = ge.s(%i#7, 5i32)
      case %done#9 {
        1 => jump j2(%acc#8, %i#7)
        _ =>
          let %i1#10: i32 = add(%i#7, 1i32)
          let %acc1#11: i32 = add(%acc#8, 3i32)
          jump loop#3(%i1#10, %acc1#11)
      }
    in jump loop#3(0i32, 0i32)
  in
  join rec loop#4(%i#12: i32, %acc#13: i32) =
    let %done#14: i32 = ge.s(%i#12, 4i32)
    case %done#14 {
      1 => jump j1(%acc#13, %i#12)
      _ =>
        let %i1#15: i32 = add(%i#12, 1i32)
        let %acc1#16: i32 = add(%acc#13, 3i32)
        jump loop#4(%i1#15, %acc1#16)
    }
  in jump loop#4(0i32, 0i32)
}
