fn fill7['m1](%n: i32) -> ('m1 [i32]) {
  let %xs: 'm1 [i32] = array_fill(%n, 7i32)
  let %ys: 'm1 [i32] = call round_trip['m1](%xs)
  jump ret(%ys)
}

fn length(%xs: ro [i32]) -> (i32) {
  let %n: i32 = array_len(%xs)
  jump ret(%n)
}

#[export(emu)]
fn main() -> (i32) {
  join j1(%xs#0: mut [i32]) =
    let = array_set(%xs#0, 0i32, 1i32)
    join j2(%ys#1: imm [i32]) =
      join j3(%n#2: i32) =
        let %x: i32 = array_get(%xs#0, 0i32)
        let %r: i32 = add(%n#2, %x)
        jump ret(%r)
      in
      let %n#5: i32 = array_len(%ys#1)
      jump j3(%n#5)
    in
    let %xs#6: imm [i32] = array_fill(3i32, 7i32)
    let %ys#7: imm [i32] = call round_trip[imm](%xs#6)
    jump j2(%ys#7)
  in
  let %xs#8: mut [i32] = array_fill(2i32, 7i32)
  let %ys#9: mut [i32] = call round_trip[mut](%xs#8)
  jump j1(%ys#9)
}

fn round_trip['m1](%xs: 'm1 [i32]) -> ('m1 [i32]) {
  let %boxed: mut any = box['m1 [i32]](%xs)
  let %ys: 'm1 [i32] = unbox['m1 [i32]](%boxed)
  jump ret(%ys)
}
