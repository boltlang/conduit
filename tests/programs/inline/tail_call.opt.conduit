fn triple_then(%x: i32) -> (i32) {
  let %y: i32 = mul(%x, 3i32)
  let %r: i32 = call double_until(%y)
  jump ret(%r)
}

fn tail(%x: i32) -> (i32) {
  let %y: i32 = mul(%x, 3i32)
  let %r: i32 = call double_until(%y)
  jump ret(%r)
}

fn to_join(%x: i32) -> (i32) {
  join next(%r#1: i32) =
    let %y#2: i32 = add(%r#1, 1i32)
    jump ret(%y#2)
  in
  let %y#3: i32 = mul(%x, 3i32)
  let %r#4: i32 = call double_until(%y#3)
  jump next(%r#4)
}

fn double_until(%x: i32) -> (i32) {
  let %small: i32 = lt.s(%x, 100i32)
  case %small {
    1 =>
      let %y: i32 = mul(%x, 2i32)
      let %r: i32 = call double_until(%y)
      jump ret(%r)
    _ => jump ret(%x)
  }
}
