// After a tail call, the callee's `ret` is the caller's: no join point,
// and the callee's own tail call stays one. A call whose results go
// straight to a join point jumps there.
fn triple_then(%x: i32) -> (i32) {
  let %y: i32 = mul(%x, 3i32)
  let %r: i32 = call double_until(%y)
  jump ret(%r)
}

fn tail(%x: i32) -> (i32) {
  let %r: i32 = call triple_then(%x)
  jump ret(%r)
}

fn to_join(%x: i32) -> (i32) {
  join next(%r: i32) =
    let %y: i32 = add(%r, 1i32)
    jump ret(%y)
  in
    let %z: i32 = call triple_then(%x)
    jump next(%z)
}

// Calls itself, so it's never inlined.
fn double_until(%x: i32) -> (i32) {
  let %small: i32 = lt.s(%x, 100i32)
  case %small {
    1 =>
      let %y: i32 = mul(%x, 2i32)
      let %r: i32 = call double_until(%y)
      jump ret(%r)
    _ => jump ret(%x)
  }
}

//# run tail(5i32) == 120i32
//# run to_join(5i32) == 121i32
//# opt: inline
