// after inline

effect Ask {
  () -> (i32)
}

handler tenfold for Ask env(i32) ops(ask) ret done

fn ten_times(%x: i32) -> (i32) {
  let %y: i32 = mul(%x, 10i32)
  jump ret(%y)
}

fn ask(%x: i32, %k: cont(i32) -> (i32)) -> (i32) {
  join j1(%y#2: i32) =
    let %r: i32 = resume(%k, %y#2)
    jump ret(%r)
  in
  let %y#4: i32 = mul(%x, 10i32)
  jump j1(%y#4)
}

fn done(%x: i32, %r: i32) -> (i32) {
  jump ret(%r)
}

fn ask_plus_one() -> (i32) does Ask {
  let %x: i32 = perform Ask.0()
  let %y: i32 = add(%x, 1i32)
  jump ret(%y)
}

fn ask_twice() -> (i32) does Ask {
  join j1(%a: i32) =
    join j2(%b: i32) =
      let %r: i32 = add(%a, %b)
      jump ret(%r)
    in
    let %x#3: i32 = perform Ask.0()
    let %y#4: i32 = add(%x#3, 1i32)
    jump j2(%y#4)
  in
  let %x#5: i32 = perform Ask.0()
  let %y#6: i32 = add(%x#5, 1i32)
  jump j1(%y#6)
}

fn main(%x: i32) -> (i32) {
  let %body: imm fn() -> (i32) does Ask = closure ask_twice()
  let %r: i32 = handle tenfold(%x, %body)
  jump ret(%r)
}

// after all passes

effect Ask {
  () -> (i32)
}

handler tenfold for Ask env(i32) ops(ask) ret done

fn ten_times(%x: i32) -> (i32) {
  let %y: i32 = mul(%x, 10i32)
  jump ret(%y)
}

fn ask(%x: i32, %k: cont(i32) -> (i32)) -> (i32) {
  let %y: i32 = mul(%x, 10i32)
  let %r: i32 = resume(%k, %y)
  jump ret(%r)
}

fn done(%x: i32, %r: i32) -> (i32) {
  jump ret(%r)
}

fn ask_plus_one() -> (i32) does Ask {
  let %x: i32 = perform Ask.0()
  let %y: i32 = add(%x, 1i32)
  jump ret(%y)
}

fn ask_twice() -> (i32) does Ask {
  let %x#0: i32 = perform Ask.0()
  let %y#1: i32 = add(%x#0, 1i32)
  let %x#2: i32 = perform Ask.0()
  let %y#3: i32 = add(%x#2, 1i32)
  let %r: i32 = add(%y#1, %y#3)
  jump ret(%r)
}

fn main(%x: i32) -> (i32) {
  let %body: imm fn() -> (i32) does Ask = closure ask_twice()
  let %r: i32 = handle tenfold(%x, %body)
  jump ret(%r)
}
