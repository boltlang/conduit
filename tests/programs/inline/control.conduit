// A callee with a loop, a case and several results: its labels and
// variables get fresh ones, a literal argument replaces its parameter, and
// it's inlined at both calls, each with its own copy.
fn fn0(%0: i32, %1: i32) -> (i32, i32) {
  join rec j1(%2: i32, %3: i32) =
    let %4: i32 = ge.s(%2, %0)
    case %4 {
      1 => jump ret(%3, %2)
      _ =>
        let %5: i32 = add(%2, 1i32)
        let %6: i32 = add(%3, %1)
        jump j1(%5, %6)
    }
  in jump j1(0i32, 0i32)
}

// 4 * 3 and 5 * 3, then the counts: 12 + 15 + 4 + 5.
fn fn1() -> (i32) {
  let %0: i32, %1: i32 = call fn0(4i32, 3i32)
  let %2: i32, %3: i32 = call fn0(5i32, 3i32)
  let %4: i32 = add(%0, %2)
  let %5: i32 = add(%1, %3)
  let %6: i32 = add(%4, %5)
  jump ret(%6)
}

//# run fn1() == 36i32
//# opt: inline
