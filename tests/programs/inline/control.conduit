// A callee with a loop, a case and several results: its labels and
// variables get fresh ones, a literal argument replaces its parameter, and
// it's inlined at both calls, each with its own copy.
fn times(%n: i32, %x: i32) -> (i32, i32) {
  join rec loop(%i: i32, %acc: i32) =
    let %done: i32 = ge.s(%i, %n)
    case %done {
      1 => jump ret(%acc, %i)
      _ =>
        let %i1: i32 = add(%i, 1i32)
        let %acc1: i32 = add(%acc, %x)
        jump loop(%i1, %acc1)
    }
  in jump loop(0i32, 0i32)
}

// 4 * 3 and 5 * 3, then the counts: 12 + 15 + 4 + 5.
fn main() -> (i32) {
  let %a: i32, %i: i32 = call times(4i32, 3i32)
  let %b: i32, %j: i32 = call times(5i32, 3i32)
  let %ab: i32 = add(%a, %b)
  let %ij: i32 = add(%i, %j)
  let %r: i32 = add(%ab, %ij)
  jump ret(%r)
}

//# run main() == 36i32
//# opt: inline
