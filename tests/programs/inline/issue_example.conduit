// The example from issue #3: `double` is inlined, with its `ret` as a join
// point holding the rest of `main`.
fn double(%x: i32) -> (i32) {
  let %y: i32 = add(%x, %x)
  jump ret(%y)
}

fn main(%x: i32) -> (i32) {
  let %y: i32 = call double(%x)
  let %z: i32 = add(%y, 1i32)
  jump ret(%z)
}

//# run main(5i32) == 11i32
//# opt: inline
