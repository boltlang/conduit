fn main(%x: i32) -> (i32) {
  let %r: i32 = call ping(%x)
  jump ret(%r)
}

fn ping(%n: i32) -> (i32) {
  case %n {
    0 => jump ret(0i32)
    _ =>
      let %n1: i32 = sub(%n, 1i32)
      let %r: i32 = call pong(%n1)
      let %r1: i32 = add(%r, 1i32)
      jump ret(%r1)
  }
}

fn pong(%n: i32) -> (i32) {
  case %n {
    0 => jump ret(0i32)
    _ =>
      let %n1: i32 = sub(%n, 1i32)
      let %r: i32 = call ping(%n1)
      let %r1: i32 = add(%r, 2i32)
      jump ret(%r1)
  }
}

fn big(%x: i32) -> (i32) {
  let %x1: i32 = add(%x, 1i32)
  let %x2: i32 = add(%x1, 1i32)
  let %x3: i32 = add(%x2, 1i32)
  let %x4: i32 = add(%x3, 1i32)
  let %x5: i32 = add(%x4, 1i32)
  let %x6: i32 = add(%x5, 1i32)
  let %x7: i32 = add(%x6, 1i32)
  let %x8: i32 = add(%x7, 1i32)
  let %x9: i32 = add(%x8, 1i32)
  let %x10: i32 = add(%x9, 1i32)
  let %x11: i32 = add(%x10, 1i32)
  let %x12: i32 = add(%x11, 1i32)
  let %x13: i32 = add(%x12, 1i32)
  let %x14: i32 = add(%x13, 1i32)
  let %x15: i32 = add(%x14, 1i32)
  let %x16: i32 = add(%x15, 1i32)
  let %x17: i32 = add(%x16, 1i32)
  let %x18: i32 = add(%x17, 1i32)
  let %x19: i32 = add(%x18, 1i32)
  let %x20: i32 = add(%x19, 1i32)
  let %x21: i32 = add(%x20, 1i32)
  jump ret(%x21)
}

fn main_big(%x: i32) -> (i32) {
  let %r: i32 = call big(%x)
  jump ret(%r)
}
