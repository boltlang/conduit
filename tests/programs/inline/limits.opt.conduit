fn main(%x: i32) -> (i32) {
  let %r: i32 = call ping(%x)
  jump ret(%r)
}

fn ping(%n: i32) -> (i32) {
  case %n {
    0 => jump ret(0i32)
    _ =>
      let %n1: i32 = sub(%n, 1i32)
      let %r: i32 = call pong(%n1)
      let %r1: i32 = add(%r, 1i32)
      jump ret(%r1)
  }
}

fn pong(%n: i32) -> (i32) {
  case %n {
    0 => jump ret(0i32)
    _ =>
      let %n1: i32 = sub(%n, 1i32)
      let %r: i32 = call ping(%n1)
      let %r1: i32 = add(%r, 2i32)
      jump ret(%r1)
  }
}

fn big(%x: i32) -> (i32) {
  let %1: i32 = add(%x, 1i32)
  let %2: i32 = add(%1, 1i32)
  let %3: i32 = add(%2, 1i32)
  let %4: i32 = add(%3, 1i32)
  let %5: i32 = add(%4, 1i32)
  let %6: i32 = add(%5, 1i32)
  let %7: i32 = add(%6, 1i32)
  let %8: i32 = add(%7, 1i32)
  let %9: i32 = add(%8, 1i32)
  let %10: i32 = add(%9, 1i32)
  let %11: i32 = add(%10, 1i32)
  let %12: i32 = add(%11, 1i32)
  let %13: i32 = add(%12, 1i32)
  let %14: i32 = add(%13, 1i32)
  let %15: i32 = add(%14, 1i32)
  let %16: i32 = add(%15, 1i32)
  let %17: i32 = add(%16, 1i32)
  let %18: i32 = add(%17, 1i32)
  let %19: i32 = add(%18, 1i32)
  let %20: i32 = add(%19, 1i32)
  let %21: i32 = add(%20, 1i32)
  jump ret(%21)
}

fn main_big(%x: i32) -> (i32) {
  let %r: i32 = call big(%x)
  jump ret(%r)
}
