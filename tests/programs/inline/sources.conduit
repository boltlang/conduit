// An inlined `let` or `jump` keeps its source, or gets the call's.
fn callee(%x: i32) -> (i32) {
  let %y: i32 = add(%x, 1i32) @src1
  let %z: i32 = mul(%y, 2i32)
  jump ret(%z)
}

fn main(%x: i32) -> (i32) {
  let %y: i32 = call callee(%x) @src9
  let %z: i32 = sub(%y, 1i32)
  jump ret(%z)
}

//# run main(3i32) == 7i32
//# opt: inline
