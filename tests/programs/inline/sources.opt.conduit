fn callee(%x: i32) -> (i32) {
  let %y: i32 = add(%x, 1i32) @src1
  let %z: i32 = mul(%y, 2i32)
  jump ret(%z)
}

fn main(%x: i32) -> (i32) {
  join j1(%y#1: i32) =
    let %z#2: i32 = sub(%y#1, 1i32)
    jump ret(%z#2)
  in
  let %y#3: i32 = add(%x, 1i32) @src1
  let %z#4: i32 = mul(%y#3, 2i32) @src9
  jump j1(%z#4) @src9
}
